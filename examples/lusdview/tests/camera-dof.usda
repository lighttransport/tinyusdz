#usda 1.0
(
    defaultPrim = "World"
)
def Xform "World" {
    def Mesh "FocusPlane" {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-2, -1, 0), (0, -1, 0), (0, 1, 0), (-2, 1, 0)]
        color3f[] primvars:displayColor = [(1, 0.1, 0.1)] (interpolation = "constant")
    }
    def Mesh "FarPlane" {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(0, -1, -4), (2, -1, -4), (2, 1, -4), (0, 1, -4)]
        color3f[] primvars:displayColor = [(0.1, 1, 0.1)] (interpolation = "constant")
    }
    def Camera "Pinhole" {
        float focalLength = 50
        float horizontalAperture = 25
        float verticalAperture = 15
        float focusDistance = 8
        float fStop = 0
        double3 xformOp:translate = (0, 0, 8)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Camera "ThinLens" {
        float focalLength = 50
        float horizontalAperture = 25
        float verticalAperture = 15
        float focusDistance = 8
        float fStop = 1
        double3 xformOp:translate = (0, 0, 8)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
