#version 450
// GPU compute skinning for the ray-query path: linear-blend skin the REST
// vertex stream into the RT vertex buffer (vboDisp) that the BLAS refit
// consumes, replacing the per-frame CPU skin + host upload.
//
// Scope: pure <= 4-influence skeletal skinning (see ApplySkinningToVertices in
// skinning.cc). Meshes with morphs, extended influences, or displacement stay
// on the CPU path. A zero-weight vertex writes its REST position/normal,
// matching the CPU semantics of re-uploading the untouched rest copy.
//
// Normals are skinned with the weighted joint matrices' linear part and
// normalized -- the same convention as the raster vertex shader (deform.glsl),
// so RT-GPU shading matches raster-GPU shading. (The CPU RT path instead
// REGENERATES smooth normals on the posed surface, so RT-GPU vs RT-CPU is
// close but not bit-identical on smooth-shaded meshes.)
//
// NOTE: this path is OPT-IN (LUSDVIEW_RT_GPU_SKIN=1). The RT vertex stream and
// skin attribute buffers are currently HOST-VISIBLE, so this dispatch streams
// over PCIe and loses to the CPU skin+upload; it becomes the default once the
// RT geometry buffers move device-local (see App::updateGpuSkinningFrameIfNeeded).
//
// Matrix convention: mats[] are the composed skinning matrices
// (geomBind * skinMat * skeletonWorld * inverse(meshWorld), double-composed on
// the CPU, float here), 16 floats each in ROW-MAJOR memory order, applied as a row-vector
// product q = p * M -- the scalar form below indexes exactly like
// TransformPointRow (skinning.cc).
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 256) in;

layout(buffer_reference, scalar) readonly buffer FloatsIn { float v[]; };
layout(buffer_reference, scalar) buffer FloatsOut { float v[]; };
layout(buffer_reference, scalar) readonly buffer UIntsIn { uint v[]; };

layout(push_constant, scalar) uniform PC {
  uint64_t restAddr;    // rest DrawVertex stream (8 floats/vertex: pos nrm uv)
  uint64_t dstAddr;     // RT DrawVertex stream (positions overwritten in place)
  uint64_t jointAddr;   // uint[4]/vertex, ABSOLUTE joint ids
  uint64_t weightAddr;  // float[4]/vertex
  uint64_t matAddr;     // float[16 * jointCount], row-major rows
  uint vertexCount;
  uint matrixBase;      // absolute id - matrixBase indexes matAddr
  uint jointCount;
} pc;

void main() {
  uint vi = gl_GlobalInvocationID.x;
  if (vi >= pc.vertexCount) return;

  FloatsIn rest = FloatsIn(pc.restAddr);
  const uint vb = vi * 8u;
  vec3 p = vec3(rest.v[vb + 0u], rest.v[vb + 1u], rest.v[vb + 2u]);
  vec3 n = vec3(rest.v[vb + 3u], rest.v[vb + 4u], rest.v[vb + 5u]);

  UIntsIn joints = UIntsIn(pc.jointAddr);
  FloatsIn weights = FloatsIn(pc.weightAddr);
  FloatsIn mats = FloatsIn(pc.matAddr);

  vec3 acc = vec3(0.0);
  vec3 nacc = vec3(0.0);
  float wsum = 0.0;
  for (uint k = 0u; k < 4u; ++k) {
    float w = weights.v[vi * 4u + k];
    if (w <= 0.0) continue;
    uint absIdx = joints.v[vi * 4u + k];
    if (absIdx < pc.matrixBase) continue;
    uint li = absIdx - pc.matrixBase;
    if (li >= pc.jointCount) continue;
    uint mb = li * 16u;
    // Row-vector transform (TransformPointRow): q[c] = sum_r p[r]*m[r][c] + m[3][c].
    vec3 q;
    q.x = p.x * mats.v[mb + 0u] + p.y * mats.v[mb + 4u] + p.z * mats.v[mb + 8u] + mats.v[mb + 12u];
    q.y = p.x * mats.v[mb + 1u] + p.y * mats.v[mb + 5u] + p.z * mats.v[mb + 9u] + mats.v[mb + 13u];
    q.z = p.x * mats.v[mb + 2u] + p.y * mats.v[mb + 6u] + p.z * mats.v[mb + 10u] + mats.v[mb + 14u];
    acc += q * w;
    // Normal: linear part only (deform.glsl convention), weighted-blended then
    // normalized once below.
    vec3 qn;
    qn.x = n.x * mats.v[mb + 0u] + n.y * mats.v[mb + 4u] + n.z * mats.v[mb + 8u];
    qn.y = n.x * mats.v[mb + 1u] + n.y * mats.v[mb + 5u] + n.z * mats.v[mb + 9u];
    qn.z = n.x * mats.v[mb + 2u] + n.y * mats.v[mb + 6u] + n.z * mats.v[mb + 10u];
    nacc += qn * w;
    wsum += w;
  }

  vec3 outp = p;   // zero-weight verts return to rest
  vec3 outn = n;
  if (wsum > 0.0) {
    outp = acc;
    float len = length(nacc);
    outn = (len > 0.0) ? nacc / len : n;
  }
  FloatsOut dst = FloatsOut(pc.dstAddr);
  dst.v[vb + 0u] = outp.x;
  dst.v[vb + 1u] = outp.y;
  dst.v[vb + 2u] = outp.z;
  dst.v[vb + 3u] = outn.x;
  dst.v[vb + 4u] = outn.y;
  dst.v[vb + 5u] = outn.z;
}
