#usda 1.0
(
    defaultPrim = "World"
)
def Xform "World" {
    def Mesh "Receiver" {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-5, -4, 0), (5, -4, 0), (5, 4, 0), (-5, 4, 0)]
        color3f[] primvars:displayColor = [(0.8, 0.8, 0.8)] (interpolation = "constant")
    }
    def Mesh "Blocker" {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-0.8, -1.5, 2), (0.8, -1.5, 2), (0.8, 1.5, 2), (-0.8, 1.5, 2)]
        color3f[] primvars:displayColor = [(0.2, 0.2, 0.2)] (interpolation = "constant")
    }
    def RectLight "Key" {
        color3f color = (1, 1, 1)
        float intensity = 40
        float width = 4
        float height = 4
        double3 xformOp:translate = (0, 0, 5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Camera "Camera" {
        float focalLength = 50
        float horizontalAperture = 28
        float verticalAperture = 20
        double3 xformOp:translate = (0, 0, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
