#version 450
#extension GL_EXT_scalar_block_layout : require

// tusdview's Vulkan compute-BVH ray-tracing fallback: used on GPUs without
// VK_KHR_ray_query/VK_KHR_acceleration_structure hardware support (where
// raytrace.comp's rayQueryEXT path is unavailable), so --rt still ray
// traces instead of falling back to plain rasterization.
//
// Real two-level (TLAS -> per-instance BLAS) triangle traversal plus a
// self-contained PBR shading pass: base color/metallic/roughness (+ the
// OpenPBR transmission/subsurface rows already packed into the same
// LrtMats SSBO the hardware shader reads, of which only the cheap
// subsurface-tint approximation is applied so far -- no real refraction or
// multi-bounce path tracing yet, that is follow-up work), one camera-
// following key light + dome-cube ambient (NOT the full per-scene RtLights
// loop raytrace.comp's hardware path evaluates -- a deliberate scope cut
// for this pass). No shadow rays yet either.
//
// This is NOT literally the same GLSL source as raytrace.comp (an earlier
// single-source #ifdef design was planned, but the hardware shader's
// shading code is deeply coupled to its buffer-device-address per-mesh
// vertex/index fetch, which would need a larger abstraction pass to safely
// share text with this file's flat global-triangle-array fetch model).
// It DOES read the identically-laid-out Mats/LrtMats/RtLights/texture-table
// SSBOs at the same binding numbers as the hardware shader (see
// VulkanRenderer::createSwRtResources()), so future unification stays
// straightforward, and rebuildSwMaterialLightSSBOs() (vk_renderer.cc)
// populates them with the exact same source data rebuildTlas() uses for
// the hardware technique.

layout(local_size_x = 8, local_size_y = 8) in;

struct Node {
  vec3 bmin;
  vec3 bmax;
  int left;
  int right;
  int count;
};

struct Inst {
  mat3x4 w2o;  // world->object, row-major 3x4 (12 floats)
  mat3x4 o2w;  // object->world, row-major 3x4 (12 floats)
  vec4 tint;
  int blasRoot;
  int instId;
  uint directLightMask;
  uint shadowLightMask;
};

layout(set = 0, binding = 0, scalar) readonly buffer Tlas { Node tlasNodes[]; };
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outImg;
layout(set = 0, binding = 2, scalar) readonly buffer Blas { Node blasNodes[]; };
layout(set = 0, binding = 3, scalar) readonly buffer Mats { vec4 matRows[]; };
layout(set = 0, binding = 4, scalar) readonly buffer Insts { Inst insts[]; };
layout(set = 0, binding = 5, rgba32f) uniform image2D accumImg;
layout(set = 0, binding = 6, scalar) readonly buffer LrtMats { vec4 lrtRows[]; };
layout(set = 0, binding = 7, scalar) readonly buffer RtLights { vec4 lightRows[]; };
layout(set = 0, binding = 8) uniform samplerCube uEnvCube;
layout(set = 0, binding = 9) uniform samplerCube uPrefilteredCube;
layout(set = 0, binding = 10) uniform sampler2D uBrdfLut;
layout(set = 0, binding = 15, scalar) readonly buffer Tris { float tris[]; };   // 9 floats/tri
layout(set = 0, binding = 16, scalar) readonly buffer Nrms { float nrms[]; };   // 9 floats/tri
layout(set = 0, binding = 17, scalar) readonly buffer Cols { float cols[]; };   // 12 floats/tri
layout(set = 0, binding = 18, scalar) readonly buffer Uv   { float uvs[]; };    // 6 floats/tri
layout(set = 0, binding = 19, scalar) readonly buffer MatId { int triMat[]; };

// 14 vec4 per material (LightRT/OpenPBR), matches PackRealtimePbrMaterial
// (src/tydra/openpbr-params.hh) -- same layout+macro as raytrace.comp.
#define lrt(id, k) lrtRows[(id) * 14u + (k)]
// 3 vec4 per material (baseColor.rgb+alpha, metallic/roughness/alphaMode/
// alphaCutoff, emissive) -- same layout+macro as raytrace.comp.
#define mat(id, k) matRows[(id) * 3u + (k)]

layout(push_constant) uniform PC {
  mat4 invViewProj;   // inverse(proj * view)
  vec4 camPos;        // xyz = camera world position, w = RenderMode
  vec4 lightDir;      // xyz = unit direction *towards* the key light
  vec4 clearColor;    // rgb background for ray misses
  uint tlasNodeCount;
  uint pad0, pad1, pad2;
} pc;

vec3 srgbToLinear(vec3 c) {
  return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(0.04045, c));
}

// Matches raytrace.comp's linearToSrgb -- outImg is UNORM (rgba8), so
// shading (done in linear space throughout) must be display-encoded before
// the final imageStore or the whole image reads far too dark.
vec3 linearToSrgb(vec3 c) {
  c = clamp(c, 0.0, 1.0);
  vec3 lo = c * 12.92;
  vec3 hi = 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055;
  return mix(lo, hi, greaterThan(c, vec3(0.0031308)));
}

// Slab-method ray/AABB test with a current-best-t early-out, matching
// raytrace.comp's pointBoxHit convention.
bool boxHit(vec3 bmin, vec3 bmax, vec3 o, vec3 inv, float best) {
  vec3 a = (bmin - o) * inv;
  vec3 b = (bmax - o) * inv;
  vec3 lo = min(a, b), hi = max(a, b);
  return max(max(lo.x, lo.y), max(lo.z, 0.0)) <=
         min(min(hi.x, hi.y), min(hi.z, best));
}

vec3 xformPoint(mat3x4 m, vec3 p) {
  return vec3(dot(m[0].xyz, p) + m[0].w,
             dot(m[1].xyz, p) + m[1].w,
             dot(m[2].xyz, p) + m[2].w);
}
vec3 xformDir(mat3x4 m, vec3 d) {
  return vec3(dot(m[0].xyz, d), dot(m[1].xyz, d), dot(m[2].xyz, d));
}

// Two-level (TLAS -> per-instance BLAS) closest-hit triangle trace. Merged
// stack of tagged entries: `inst < 0` means "this is a TLAS node, ray in
// world space"; else "this is a BLAS node of instance `inst`, ray in that
// instance's object space" -- mirrors raytrace.comp's tracePointEllipses
// stack/box-test-with-best convention, extended to two levels since BVH
// instancing (unlike points) needs an object-space descent. No near/far
// child ordering (same as the point-BVH precedent): correctness over
// traversal speed for this first pass.
bool traceClosestSW(vec3 o, vec3 d, out int hitInst, out int hitTri,
                    out vec2 hitBc, out bool hitFront, out float hitT) {
  hitInst = -1; hitTri = -1; hitBc = vec2(0.0); hitFront = true; hitT = 1e30;
  if (pc.tlasNodeCount == 0u) return false;
  vec3 invD = 1.0 / d;

  int stackNode[64];
  int stackInst[64];
  int sp = 0;
  stackNode[sp] = 0; stackInst[sp] = -1; sp++;

  // Object-space ray cache, one slot per stack entry pushed for a given
  // instance's BLAS root (recomputed each time an instance's root is
  // pushed -- simpler than a side-table given the shallow 64-entry stack).
  while (sp > 0) {
    sp--;
    int nodeIdx = stackNode[sp];
    int instIdx = stackInst[sp];
    if (instIdx < 0) {
      Node n = tlasNodes[nodeIdx];
      if (!boxHit(n.bmin, n.bmax, o, invD, hitT)) continue;
      if (n.count > 0) {
        for (int j = 0; j < n.count; ++j) {
          int ii = n.left + j;
          if (sp >= 64) break;
          stackNode[sp] = insts[ii].blasRoot;
          stackInst[sp] = ii;
          sp++;
        }
      } else {
        if (sp + 2 <= 64) {
          stackNode[sp] = n.left; stackInst[sp] = -1; sp++;
          stackNode[sp] = n.right; stackInst[sp] = -1; sp++;
        }
      }
    } else {
      Inst inst = insts[instIdx];
      vec3 oo = xformPoint(inst.w2o, o);
      vec3 od = xformDir(inst.w2o, d);
      float odLen = length(od);
      vec3 oInv = 1.0 / od;
      Node n = blasNodes[nodeIdx];
      // Object-space t is scaled by |od| relative to world-space t (od is
      // NOT normalized -- w2o may carry non-uniform scale); convert the
      // current best world-space t into this instance's object space for
      // the box/tri tests, and convert intersection t back to world space
      // when recording a hit.
      float bestObj = hitT * odLen;
      if (!boxHit(n.bmin, n.bmax, oo, oInv, bestObj)) continue;
      if (n.count > 0) {
        for (int j = 0; j < n.count; ++j) {
          int tri = n.left + j;
          vec3 v0 = vec3(tris[tri * 9 + 0], tris[tri * 9 + 1], tris[tri * 9 + 2]);
          vec3 v1 = vec3(tris[tri * 9 + 3], tris[tri * 9 + 4], tris[tri * 9 + 5]);
          vec3 v2 = vec3(tris[tri * 9 + 6], tris[tri * 9 + 7], tris[tri * 9 + 8]);
          vec3 e1 = v1 - v0, e2 = v2 - v0;
          vec3 pvec = cross(od, e2);
          float det = dot(e1, pvec);
          if (abs(det) < 1e-9) continue;
          float invDet = 1.0 / det;
          vec3 tvec = oo - v0;
          float u = dot(tvec, pvec) * invDet;
          if (u < 0.0 || u > 1.0) continue;
          vec3 qvec = cross(tvec, e1);
          float v = dot(od, qvec) * invDet;
          if (v < 0.0 || u + v > 1.0) continue;
          float tObj = dot(e2, qvec) * invDet;
          if (tObj < 1e-4 || tObj >= bestObj) continue;
          bestObj = tObj;
          hitT = tObj / max(odLen, 1e-12);
          hitInst = instIdx;
          hitTri = tri;
          hitBc = vec2(u, v);
          hitFront = det > 0.0;
        }
      } else {
        if (sp + 2 <= 64) {
          stackNode[sp] = n.left; stackInst[sp] = instIdx; sp++;
          stackNode[sp] = n.right; stackInst[sp] = instIdx; sp++;
        }
      }
    }
  }
  return hitInst >= 0;
}

void main() {
  ivec2 px = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(outImg);
  if (px.x >= size.x || px.y >= size.y) return;

  vec2 uv = (vec2(px) + 0.5) / vec2(size);
  vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
  vec4 nearH = pc.invViewProj * vec4(ndc, 0.0, 1.0);
  vec4 farH = pc.invViewProj * vec4(ndc, 1.0, 1.0);
  vec3 nearW = nearH.xyz / nearH.w;
  vec3 farW = farH.xyz / farH.w;
  vec3 origin = nearW;
  vec3 dir = normalize(farW - nearW);

  vec3 bgc = srgbToLinear(pc.clearColor.rgb);
  vec3 outc = bgc;

  int hitInst, hitTri; vec2 hitBc; bool hitFront; float hitT;
  if (traceClosestSW(origin, dir, hitInst, hitTri, hitBc, hitFront, hitT)) {
    Inst inst = insts[hitInst];
    float w0 = 1.0 - hitBc.x - hitBc.y;

    vec3 n0 = vec3(nrms[hitTri * 9 + 0], nrms[hitTri * 9 + 1], nrms[hitTri * 9 + 2]);
    vec3 n1 = vec3(nrms[hitTri * 9 + 3], nrms[hitTri * 9 + 4], nrms[hitTri * 9 + 5]);
    vec3 n2 = vec3(nrms[hitTri * 9 + 6], nrms[hitTri * 9 + 7], nrms[hitTri * 9 + 8]);
    vec3 nObj = normalize(n0 * w0 + n1 * hitBc.x + n2 * hitBc.y);
    // Normal transform uses w2o^T (inverse-transpose of o2w) -- w2o IS
    // o2w's affine inverse (rt_scene_build.hh), so its transpose is exactly
    // the inverse-transpose o2w needs for correct normals under non-uniform
    // scale.
    vec3 N = normalize(vec3(dot(vec3(inst.w2o[0].x, inst.w2o[1].x, inst.w2o[2].x), nObj),
                            dot(vec3(inst.w2o[0].y, inst.w2o[1].y, inst.w2o[2].y), nObj),
                            dot(vec3(inst.w2o[0].z, inst.w2o[1].z, inst.w2o[2].z), nObj)));
    if (dot(N, dir) > 0.0) N = -N;

    vec4 c0 = vec4(cols[hitTri*12+0], cols[hitTri*12+1], cols[hitTri*12+2], cols[hitTri*12+3]);
    vec4 c1 = vec4(cols[hitTri*12+4], cols[hitTri*12+5], cols[hitTri*12+6], cols[hitTri*12+7]);
    vec4 c2 = vec4(cols[hitTri*12+8], cols[hitTri*12+9], cols[hitTri*12+10], cols[hitTri*12+11]);
    vec4 vertColor = c0 * w0 + c1 * hitBc.x + c2 * hitBc.y;

    int mid = triMat[hitTri];
    vec3 base = vec3(0.6);
    float alpha = 1.0;
    float metallic = 0.0;
    float roughness = 0.5;
    vec3 emissive = vec3(0.0);
    if (mid >= 0) {
      base = mat(mid, 0u).rgb;
      alpha = mat(mid, 0u).a;
      metallic = mat(mid, 1u).x;
      roughness = mat(mid, 1u).y;
      emissive = mat(mid, 2u).rgb;
      if (lrt(mid, 12u).w > 0.5) {
        metallic = lrt(mid, 10u).x;
        roughness = lrt(mid, 10u).z;
        alpha = lrt(mid, 9u).w;
        emissive = lrt(mid, 8u).rgb * lrt(mid, 8u).w;
        float transmission = lrt(mid, 2u).w;
        float subsurface = lrt(mid, 4u).w;
        vec3 subsurfaceColor = lrt(mid, 4u).rgb;
        // Cheap subsurface approximation (see file header + Phase 1 in
        // raytrace.comp): tint diffuse albedo toward subsurfaceColor.
        base = mix(base, subsurfaceColor * (1.0 - metallic) * (1.0 - transmission),
                  subsurface);
      }
    }
    base *= vertColor.rgb;
    alpha *= vertColor.a * inst.tint.a;
    base *= inst.tint.rgb;
    roughness = clamp(roughness, 0.03, 1.0);

    // Direct term: one camera-following key light (NOT the full per-scene
    // RtLights loop yet -- scope cut for this pass) plus a simple GGX
    // specular lobe, matching the shape (not literal formulas) of
    // raytrace.comp's BRDF.
    vec3 L = normalize(pc.lightDir.xyz);
    vec3 V = normalize(-dir);
    vec3 Hh = normalize(L + V);
    float NdotL = max(dot(N, L), 0.0);
    float NdotV = max(dot(N, V), 1e-4);
    float NdotH = max(dot(N, Hh), 0.0);
    float VdotH = max(dot(V, Hh), 0.0);
    vec3 F0 = mix(vec3(0.04), base, metallic);
    vec3 F = F0 + (vec3(1.0) - F0) * pow(1.0 - VdotH, 5.0);
    float a2 = roughness * roughness * roughness * roughness;
    float dDen = (NdotH * NdotH) * (a2 - 1.0) + 1.0;
    float D = a2 / max(3.14159265 * dDen * dDen, 1e-6);
    float k = (roughness + 1.0) * (roughness + 1.0) / 8.0;
    float gV = NdotV / (NdotV * (1.0 - k) + k);
    float gL = NdotL / (NdotL * (1.0 - k) + k);
    float G = gV * gL;
    vec3 spec = (D * G * F) / max(4.0 * NdotV * NdotL, 1e-6);
    vec3 kd = (vec3(1.0) - F) * (1.0 - metallic);
    vec3 direct = (kd * base / 3.14159265 + spec) * NdotL;

    // Ambient: dome-cube diffuse (mip'd roughly by material roughness via
    // the prefiltered cube) -- much simpler than raytrace.comp's split-sum
    // IBL, but reuses the same bound cube/LUT resources.
    vec3 irradiance = textureLod(uEnvCube, N, 0.0).rgb;
    vec3 R = reflect(-V, N);
    vec3 prefiltered = textureLod(uPrefilteredCube, R, roughness * 6.0).rgb;
    vec2 brdf = texture(uBrdfLut, vec2(NdotV, roughness)).rg;
    vec3 ambient = base * (1.0 - metallic) * irradiance * 0.3 +
                   prefiltered * (F0 * brdf.x + brdf.y);

    outc = direct + ambient + emissive;
  }

  imageStore(outImg, px, vec4(linearToSrgb(outc), 1.0));
}
