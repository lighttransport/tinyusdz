            matTexParams[texParamBase + 124u] * uv0.x +
                matTexParams[texParamBase + 125u] * uv0.y +
                matTexParams[texParamBase + 126u],
            matTexParams[texParamBase + 127u] * uv0.x +
                matTexParams[texParamBase + 128u] * uv0.y +
