        subsurfaceColor = max(swEvalMaterialXGraph(uint(mid), 7, uv0, uv1,
                                                   uint(max(hitTri, 0))).rgb,
                              vec3(0.0));
      if (graphRows[graphBase + 9u] >= 0.0)
        subsurfaceRadius = max(swEvalMaterialXGraph(uint(mid), 8, uv0, uv1,
                                                     uint(max(hitTri, 0))).rgb,
                                vec3(0.0));
      if (graphRows[graphBase + 6u] >= 0.0) {
        vec4 gn = swEvalMaterialXGraph(uint(mid), 5, uv0, uv1,
                                       uint(max(hitTri, 0)));
        vec3 gp0 = xformPoint(inst.o2w,
                              vec3(tris[hitTri * 9 + 0], tris[hitTri * 9 + 1],
                                   tris[hitTri * 9 + 2]));
        vec3 gp1 = xformPoint(inst.o2w,
                              vec3(tris[hitTri * 9 + 3], tris[hitTri * 9 + 4],
                                   tris[hitTri * 9 + 5]));
        vec3 gp2 = xformPoint(inst.o2w,
                              vec3(tris[hitTri * 9 + 6], tris[hitTri * 9 + 7],
                                   tris[hitTri * 9 + 8]));
        vec2 guv0 = vec2(uvs[hitTri * 6 + 0], uvs[hitTri * 6 + 1]);
        vec2 guv1 = vec2(uvs[hitTri * 6 + 2], uvs[hitTri * 6 + 3]);
        vec2 guv2 = vec2(uvs[hitTri * 6 + 4], uvs[hitTri * 6 + 5]);
        vec3 ge1 = gp1 - gp0, ge2 = gp2 - gp0;
        vec3 gN = normalize(cross(ge1, ge2));
        vec2 gd1 = guv1 - guv0, gd2 = guv2 - guv0;
        float gdet = gd1.x * gd2.y - gd1.y * gd2.x;
