#version 450
#extension GL_EXT_scalar_block_layout : require

// Milestone-1 debug shader for tusdview's Vulkan compute-BVH ray-tracing
// fallback (see vk_renderer.cc: detectSwRtSupport/rebuildSwBvh/createSwRtResources/
// traceRtBvh). Used on GPUs without VK_KHR_ray_query/VK_KHR_acceleration_structure
// hardware support, where raytrace.comp's rayQueryEXT path is unavailable, so
// --rt would otherwise silently fall back to plain rasterization.
//
// This shader deliberately does NOT do real BVH traversal or shading yet: it
// only tests the primary ray against the TLAS ROOT node's AABB (rt_scene_build.cc's
// Node type, uploaded by rebuildSwBvh()) and writes red on hit / the clear
// color on miss. That's enough to validate the upload -> bind -> dispatch ->
// present plumbing end to end before real traversal (walking BLAS/TLAS,
// producing per-triangle hits) and shading (reusing raytrace.comp's material/
// light/IBL code) are ported in in later milestones. Needs no GL_EXT_ray_query,
// SPIR-V 1.4, or any Vulkan RT extension -- baseline compute + storage buffers
// only, so (unlike raytrace.comp) it should compile with essentially any glslang.
//
// Kept as a separate file from raytrace.comp (rather than folded in behind a
// preprocessor switch, as later milestones will do) specifically for this
// first milestone, so a bug here cannot affect the already-shipping,
// already-compiled hardware ray-query shader.

layout(local_size_x = 8, local_size_y = 8) in;

// Mirrors tusdview's rt_bvh.hh Node (32 bytes: 2x vec3 + 3x int32, no padding
// under scalar layout) and vk_renderer.cc's SwRtPushC.
struct Node {
  vec3 bmin;
  vec3 bmax;
  int left;
  int right;
  int count;
};

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outImg;
layout(set = 0, binding = 1, scalar) readonly buffer Tlas { Node tlasNodes[]; };

layout(push_constant) uniform PC {
  mat4 invViewProj;  // inverse(proj * view)
  vec4 clearColor;   // rgb background for ray misses
  uint tlasNodeCount;
} pc;

// Slab-method ray/AABB test (branchless min/max form).
bool hitAabb(vec3 bmin, vec3 bmax, vec3 origin, vec3 invDir, float tmax) {
  vec3 t0 = (bmin - origin) * invDir;
  vec3 t1 = (bmax - origin) * invDir;
  vec3 tSmall = min(t0, t1);
  vec3 tBig = max(t0, t1);
  float tmin = max(max(tSmall.x, tSmall.y), tSmall.z);
  float tmx = min(min(tBig.x, tBig.y), min(tBig.z, tmax));
  return tmin <= tmx && tmx >= 1e-3;
}

void main() {
  ivec2 px = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(outImg);
  if (px.x >= size.x || px.y >= size.y) return;

  // Pixel -> NDC -> world ray via the inverse view-projection, matching
  // raytrace.comp's primary-ray generation (Y flipped so image row 0 maps to
  // ndc.y=+1, matching the raster path's negative-height viewport).
  vec2 uv = (vec2(px) + 0.5) / vec2(size);
  vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
  vec4 nearH = pc.invViewProj * vec4(ndc, 0.0, 1.0);
  vec4 farH = pc.invViewProj * vec4(ndc, 1.0, 1.0);
  vec3 nearW = nearH.xyz / nearH.w;
  vec3 farW = farH.xyz / farH.w;
  vec3 origin = nearW;
  vec3 dir = normalize(farW - nearW);
  vec3 invDir = 1.0 / dir;

  vec3 outc = pc.clearColor.rgb;
  if (pc.tlasNodeCount > 0u &&
      hitAabb(tlasNodes[0].bmin, tlasNodes[0].bmax, origin, invDir, 1e30)) {
    outc = vec3(1.0, 0.0, 0.0);  // debug: TLAS root AABB hit -> red
  }
  imageStore(outImg, px, vec4(outc, 1.0));
}
