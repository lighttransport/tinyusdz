                                              tris[hitTri * 9 + 2]));
        vec3 wv1 = xformPoint(inst.o2w, vec3(tris[hitTri * 9 + 3],
                                              tris[hitTri * 9 + 4],
                                              tris[hitTri * 9 + 5]));
        vec3 wv2 = xformPoint(inst.o2w, vec3(tris[hitTri * 9 + 6],
                                              tris[hitTri * 9 + 7],
                                              tris[hitTri * 9 + 8]));
