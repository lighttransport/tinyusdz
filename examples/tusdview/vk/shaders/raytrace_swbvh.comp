      int lightType = int(l0.x + 0.5);
      int flags = int(l0.y + 0.5);
      if (lightType == 6 || l0.y <= 0.5) continue;
      hadDirectLight = true;
      bool linked = li < 32u
          ? (inst.directLightMask & (1u << li)) != 0u
          : (flags & (1 << 5)) != 0;
