      float shape = 1.0;
      if ((flags & 4) != 0 && lightType != 5) {
        vec3 lightDir = normalize(lightRows[li * 20u + 2u].xyz);
        float coneCos = dot(lightDir, -L);
        vec4 shaping = lightRows[li * 20u + 6u];
        float outer = cos(radians(clamp(shaping.x, 0.0, 180.0)));
