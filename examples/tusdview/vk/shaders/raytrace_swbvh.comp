        specWeight = lrt(mid, 1u).w;
        specColor = lrt(mid, 1u).rgb;
        specIor = max(lrt(mid, 10u).w, 1.0);
        sheenWeight = lrt(mid, 7u).w;
        sheenColor = lrt(mid, 7u).rgb;
        sheenRoughness = lrt(mid, 11u).z;
        thinFilmWeight = lrt(mid, 12u).x;
        thinFilmThickness = lrt(mid, 12u).y;
        thinFilmIor = lrt(mid, 12u).z;
        specAnisotropy = clamp(lrt(mid, 14u).y +
                               0.5 * lrt(mid, 14u).w, -1.0, 1.0);
        specRotation = lrt(mid, 14u).z;
        roughness = clamp(roughness *
                          (1.0 - 0.25 * abs(specAnisotropy)),
                          0.03, 1.0);
        metallic = lrt(mid, 10u).x;
        roughness = lrt(mid, 10u).z;
        alpha = lrt(mid, 9u).w;
        emissive = lrt(mid, 8u).rgb * lrt(mid, 8u).w;
        transmission = lrt(mid, 2u).w;
        transmissionColor = lrt(mid, 2u).rgb;
        coatWeight = lrt(mid, 6u).w;
        coatColor = lrt(mid, 6u).rgb;
        coatRoughness = lrt(mid, 11u).x;
        transmissionDispersionAbbe = lrt(mid, 15u).y;
        transmissionDispersion = lrt(mid, 15u).x;
        transmissionDispersionScale = lrt(mid, 15u).z;
        subsurfaceAnisotropy = lrt(mid, 15u).w;
        subsurfaceScatterAnisotropy = lrt(mid, 16u).x;
        coatAnisotropy = lrt(mid, 16u).y;
        coatRotation = lrt(mid, 16u).z;
        coatAffectColor = lrt(mid, 16u).w;
        coatAffectRoughness = lrt(mid, 17u).x;
        coatRoughnessAnisotropy = lrt(mid, 17u).y;
        coatDarkening = lrt(mid, 17u).w;
        volumeAlbedo = lrt(mid, 18u).rgb;
        volumeDensity = lrt(mid, 18u).w;
        volumeEmission = lrt(mid, 19u).rgb;
        volumeEmissionScale = lrt(mid, 19u).w;
        subsurface = lrt(mid, 4u).w;
        subsurfaceColor = lrt(mid, 4u).rgb;
        subsurfaceRadius = max(lrt(mid, 5u).rgb, vec3(0.0));
        subsurfaceScale = max(lrt(mid, 5u).w, 0.0);
        // Cheap subsurface approximation (see file header + Phase 1 in
