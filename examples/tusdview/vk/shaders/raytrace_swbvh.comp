                                         0.0, 180.0)));
        shape = smoothstep(outer, max(inner, outer + 1e-5), coneCos) *
                pow(max(coneCos, 0.0), max(shaping.z, 0.0));
      }
      if (lightType == 7) {
        shape *= max(dot(geometryNormal, -L), 0.0);
      }
      float nDotL = max(dot(N, L), 0.0);
      if (nDotL <= 0.0 || shape <= 0.0) continue;

      float visibility = 1.0;
      if (renderMode == 0 && (flags & 2) != 0) {
        vec3 shadowOrigin = hit + N * 1e-3;
        float cursor = 1e-3;
        int blendLayers = 0;
        [[dont_unroll]] for (int pass = 0; pass < 32 && visibility > 1e-3; ++pass) {
          int shadowInst, shadowTri; vec2 shadowBc; bool shadowFront;
          float shadowT;
