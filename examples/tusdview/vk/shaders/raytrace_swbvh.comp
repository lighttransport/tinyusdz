               clamp(coatWeight * coatAffectColor, 0.0, 1.0));
    base *= 1.0 - 0.2 * clamp(coatWeight * coatDarkening, 0.0, 1.0);
    roughness = mix(roughness, coatRoughness,
                    clamp(coatWeight * coatAffectRoughness, 0.0, 1.0));
    roughness = clamp(roughness *
                      (1.0 - 0.1 * abs(coatAnisotropy) -
                       0.05 * abs(cos(radians(coatRotation)))), 0.03, 1.0);
