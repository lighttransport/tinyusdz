              shadowOrigin, L, cursor, max(maxShadowT - 2e-3, cursor),
              shadowInst, shadowTri, shadowBc, shadowFront, shadowT);
          if (!blocked || shadowT >= maxShadowT - 2e-3) break;
          bool shadowLinked = li < 32u
              ? (insts[shadowInst].shadowLightMask & (1u << li)) != 0u
              : (flags & (1 << 6)) != 0;
          cursor = shadowT + 1e-3;
          if (!shadowLinked) continue;
          float shadowMode = 0.0;
          float opacity = swOpacityAtHit(shadowInst, shadowTri, shadowBc,
                                         shadowMode);
          if (shadowMode > 1.5 && opacity < 1.0 && blendLayers < 8) {
            visibility *= 1.0 - opacity;
            ++blendLayers;
          } else if (shadowMode > 0.5 && shadowMode < 1.5 && opacity <= 0.0) {
            // Rejected alpha-mask texel exposes the next surface.
            continue;
          } else {
            visibility = 0.0;
            break;
          }
        }
      }

      vec3 H = normalize(L + V);
      vec3 tangent = normalize(abs(N.y) < 0.9 ? cross(N, vec3(0.0, 1.0, 0.0))
                                              : cross(N, vec3(1.0, 0.0, 0.0)));
      vec3 bitangent = normalize(cross(N, tangent));
      float rot = radians(specRotation);
      vec3 rotatedT = tangent * cos(rot) + bitangent * sin(rot);
      vec3 rotatedB = -tangent * sin(rot) + bitangent * cos(rot);
      float hT = dot(H, rotatedT), hB = dot(H, rotatedB);
      float nDotH = max(dot(N, H), 0.0);
      float vDotH = max(dot(V, H), 0.0);
      vec3 F = F0 + (vec3(1.0) - F0) * pow(1.0 - vDotH, 5.0);
      float vT = dot(V, rotatedT), vB = dot(V, rotatedB);
      float lT = dot(L, rotatedT), lB = dot(L, rotatedB);
      float D = swGgxDAniso(nDotH, hT, hB, roughness, specAnisotropy);
      float gV = swGgxG1Aniso(NdotV, vT, vB, roughness, specAnisotropy);
      float gL = swGgxG1Aniso(nDotL, lT, lB, roughness, specAnisotropy);
      vec3 spec = (D * gV * gL * F) /
                  max(4.0 * NdotV * nDotL, 1e-6) * max(specWeight, 0.0);
      vec3 kd = (vec3(1.0) - F) * (1.0 - metallic);
      vec3 sheen = sheenColor * clamp(sheenWeight, 0.0, 1.0) *
                   (0.5 + 0.5 * clamp(sheenRoughness, 0.0, 1.0)) *
                   pow(1.0 - nDotL, 5.0) / 3.14159265;
      vec3 radiance = geometryEmission *
                      (attenuation * shape * swIesFactor(li, -L));
      vec4 weights = lightRows[li * 20u + 7u];
      vec3 transmissionBrdf = transmissionColor * clamp(transmission, 0.0, 1.0) *
                              (vec3(1.0) - F) / 3.14159265;
      float radiusGain = clamp(sqrt(max(dot(subsurfaceRadius,
                                             vec3(0.2126, 0.7152, 0.0722)) *
                                         subsurfaceScale, 0.0)) * 8.0,
                                0.0, 1.0);
      float diffusionShape = mix(0.25 + 0.75 * pow(1.0 - nDotL, 2.0),
                                 0.25 + 0.75 * (1.0 - nDotL), radiusGain);
      vec3 subsurfaceBrdf = subsurfaceColor * clamp(subsurface, 0.0, 1.0) *
                            diffusionShape / 3.14159265;
      direct += ((kd * base / 3.14159265 + sheen + transmissionBrdf +
                  subsurfaceBrdf) * weights.y +
                 spec * weights.z) *
                nDotL * radiance * visibility;
    }
    if (!hadDirectLight) {
      vec3 L = normalize(pc.lightDir.xyz);
      float nDotL = max(dot(N, L), 0.0);
      vec3 H = normalize(L + V);
      float nDotH = max(dot(N, H), 0.0);
      float vDotH = max(dot(V, H), 0.0);
      vec3 F = F0 + (vec3(1.0) - F0) * pow(1.0 - vDotH, 5.0);
      float a2 = roughness * roughness * roughness * roughness;
      float dDen = (nDotH * nDotH) * (a2 - 1.0) + 1.0;
      float D = a2 / max(3.14159265 * dDen * dDen, 1e-6);
      float k = (roughness + 1.0) * (roughness + 1.0) / 8.0;
      float gV = NdotV / (NdotV * (1.0 - k) + k);
      float gL = nDotL / (nDotL * (1.0 - k) + k);
      vec3 spec = (D * gV * gL * F) /
                  max(4.0 * NdotV * nDotL, 1e-6);
      vec3 sheen = sheenColor * clamp(sheenWeight, 0.0, 1.0) *
                   (0.5 + 0.5 * clamp(sheenRoughness, 0.0, 1.0)) *
                   pow(1.0 - nDotL, 5.0) / 3.14159265;
      vec3 transmissionBrdf = transmissionColor * clamp(transmission, 0.0, 1.0) *
                              (vec3(1.0) - F) / 3.14159265;
      float radiusGain = clamp(sqrt(max(dot(subsurfaceRadius,
                                             vec3(0.2126, 0.7152, 0.0722)) *
                                         subsurfaceScale, 0.0)) * 8.0,
                                0.0, 1.0);
      float diffusionShape = mix(0.25 + 0.75 * pow(1.0 - nDotL, 2.0),
                                 0.25 + 0.75 * (1.0 - nDotL), radiusGain);
      vec3 subsurfaceBrdf = subsurfaceColor * clamp(subsurface, 0.0, 1.0) *
                            diffusionShape / 3.14159265;
      direct = ((vec3(1.0) - F) * (1.0 - metallic) * base /
                3.14159265 + sheen + transmissionBrdf + subsurfaceBrdf +
                spec * max(specWeight, 0.0)) * nDotL;
    }

    // Ambient: dome-cube diffuse (mip'd roughly by material roughness via
    // the prefiltered cube) -- much simpler than raytrace.comp's split-sum
    // IBL, but reuses the same bound cube/LUT resources.
    vec3 irradiance = textureLod(uEnvCube, N, 0.0).rgb;
    vec3 R = reflect(-V, N);
    vec3 prefiltered = textureLod(uPrefilteredCube, R, roughness * 6.0).rgb;
    vec2 brdf = texture(uBrdfLut, vec2(NdotV, roughness)).rg;
    vec3 ambient = base * (1.0 - metallic) * irradiance * 0.3 +
                   prefiltered * (F0 * brdf.x + brdf.y) * max(specWeight, 0.0);
    ambient += sheenColor * clamp(sheenWeight, 0.0, 1.0) * 0.025;
    ambient += transmissionColor * clamp(transmission, 0.0, 1.0) *
               irradiance * 0.25;

    outc = direct + ambient + emissive;
    if (renderMode == 0) {
      float resolvedHitMode = 0.0;
      float resolvedHitAlpha = swOpacityAtHit(hitInst, hitTri, hitBc,
                                              resolvedHitMode);
      if (resolvedHitMode > 0.5 && resolvedHitMode < 1.5) {
        outc = resolvedHitAlpha > 0.0 ? outc : bgc;
      } else if (resolvedHitMode > 1.5) {
        // Composite the full-shaded nearest layer over a bounded set of
        // resolved underlays. The conservative tail is treated as opaque by
        // the loop once the layer budget is exhausted.
        vec3 layerColor[8];
        float layerAlpha[8];
        vec3 layerTint[8];
        int layerCount = 1;
        float topMode = 0.0;
        layerColor[0] = outc;
        layerAlpha[0] = swOpacityAtHit(hitInst, hitTri, hitBc, topMode);
        layerTint[0] = swLayerTransmissionTint(hitInst, hitTri);
        float topTransmission = swLayerTransmissionWeight(hitTri);
        vec3 refractedOrigin, refractedDir;
        vec3 topRefract = swLayerRefractedColor(hitInst, hitTri, hitBc,
                                                hitFront, origin, dir,
                                                refractedOrigin, refractedDir);
        vec3 walkOrigin = origin;
        vec3 walkDir = dir;
        float cursor = hitT + 1e-3;
        if (topTransmission > 0.0) {
          walkOrigin = refractedOrigin;
          walkDir = refractedDir;
          cursor = 1e-3;
        }
        bool opaqueTail = false;
        vec3 tailColor = bgc;
        [[dont_unroll]] for (int pass = 1; pass < 8; ++pass) {
          int li, lt; vec2 lb; bool lf; float ldist;
          if (!traceClosestSWRange(walkOrigin, walkDir, cursor, 1e30,
                                   li, lt, lb, lf, ldist)) break;
          walkOrigin += walkDir * (ldist + 1e-3);
          cursor = 1e-3;
          float lm = 0.0;
          float la = swOpacityAtHit(li, lt, lb, lm);
          if (lm > 0.5 && lm < 1.5 && la <= 0.0) continue;
          layerColor[layerCount] = swApproxLayerColor(li, lt, lb);
          layerAlpha[layerCount] = la;
          layerTint[layerCount] = swLayerTransmissionTint(li, lt);
          // Carry the refracted direction through each transparent
          // intermediate interface. Without this, stacked glass layers are
          // shaded on a straight ray even though the top interface bent it.
          if (swLayerTransmissionWeight(lt) > 0.0) {
            vec3 nextOrigin, nextDir;
            swLayerRefractedColor(li, lt, lb, lf, walkOrigin, walkDir,
                                  nextOrigin, nextDir);
            walkOrigin = nextOrigin;
            walkDir = nextDir;
            cursor = 1.0e-3;
          }
          ++layerCount;
          if (lm <= 0.5 || (lm > 1.5 && la >= 1.0)) break;
        }
        // If the bounded layer budget is exhausted, conservatively treat the
        // next accepted surface as an opaque tail rather than leaking the
        // clear color through an arbitrarily deep transparent stack.
        if (layerCount == 8) {
          int ti, tt; vec2 tb; bool tf; float td;
          if (traceClosestSWRange(walkOrigin, walkDir, cursor, 1e30,
                                  ti, tt, tb, tf, td)) {
            float tm = 0.0;
            float ta = swOpacityAtHit(ti, tt, tb, tm);
            if (!(tm > 0.5 && tm < 1.5 && ta <= 0.0)) {
              opaqueTail = true;
              tailColor = swApproxLayerColor(ti, tt, tb);
            }
          }
        }
        vec3 composite = opaqueTail ? tailColor : bgc;
        // The nearest layer's bounded walk already propagates the refracted
        // direction through subsequent interfaces. Do not start unrelated
        // walks for underlayers found along the original straight camera ray.
        for (int i = layerCount - 1; i >= 1; --i) {
          float a = clamp(layerAlpha[i], 0.0, 1.0);
          vec3 transmitted = composite * layerTint[i];
          composite = mix(transmitted, layerColor[i], a);
        }
        vec3 topTransmitted = composite * layerTint[0];
        topTransmitted = mix(topTransmitted, topRefract,
                             clamp(topTransmission, 0.0, 1.0));
        composite = mix(topTransmitted, layerColor[0],
                        clamp(layerAlpha[0], 0.0, 1.0));
        outc = composite;
      }
    }
  }

  if (pc.accumEnabled != 0u) {
    vec4 sum = imageLoad(accumImg, px);
    sum.rgb = pc.sampleIndex == 0u ? outc : sum.rgb + outc;
    sum.a = 1.0;
    imageStore(accumImg, px, sum);
    outc = sum.rgb / float(pc.sampleIndex + 1u);
  }
  imageStore(outImg, px, vec4(linearToSrgb(outc), 1.0));
}
