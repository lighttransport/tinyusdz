#version 460

// Vulkan ray-query primary + shadow tracer. Writes a shaded image that mirrors
// the rasterizer's look (same directional light + ambient as mesh.frag), plus
// hard shadows from one shadow ray. Supports GPU instancing (one BLAS shared by
// many TLAS instances), per-vertex + per-instance displayColor, and authored
// (interpolated) vs geometric (face) normals.
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_control_flow_attributes : enable

#ifndef TUSDVIEW_RT_DISABLE_MTLX
#define TUSDVIEW_RT_DISABLE_MTLX 0
#endif
#ifndef TUSDVIEW_RT_DISABLE_DEBUG_RAYS
#define TUSDVIEW_RT_DISABLE_DEBUG_RAYS 0
#endif
#ifndef TUSDVIEW_RT_FAST_MATERIAL
#define TUSDVIEW_RT_FAST_MATERIAL 0
#endif

layout(local_size_x = 8, local_size_y = 8) in;

// Vertex buffer = interleaved DrawVertex (8 floats: pos.xyz, nrm.xyz, uv.xy).
layout(buffer_reference, scalar) readonly buffer Verts { float v[]; };
layout(buffer_reference, scalar) readonly buffer Idx   { uint  i[]; };
// Optional displayColor.rgb + displayOpacity (vec4 packed per vertex).
layout(buffer_reference, scalar) readonly buffer Cols  { float c[]; };
layout(buffer_reference, scalar) readonly buffer UV1s  { float u[]; };  // vec2 per vertex
layout(buffer_reference, scalar) readonly buffer Infls { float f[]; };  // float per vertex
layout(buffer_reference, scalar) readonly buffer Faces { uint  fc[]; }; // face id per triangle
layout(buffer_reference, scalar) readonly buffer TriMats { uint m[]; }; // material id per triangle
layout(buffer_reference, scalar) readonly buffer Joints  { uint  j[]; }; // 4 joint ids per vertex
layout(buffer_reference, scalar) readonly buffer Weights { float w[]; }; // 4 weights per vertex
layout(buffer_reference, scalar) readonly buffer SubmeshRanges { uvec4 r[]; };

struct MeshDesc {
  uint64_t vtxAddr;       // device address of the vertex buffer (DrawVertex[])
  uint64_t idxAddr;       // device address of the index buffer (uint[])
  uint64_t vtxColorAddr;  // per-vertex displayColor (vec3[]); 0 = none
  uint64_t uv1Addr;       // per-vertex 2nd texcoord (vec2[]); 0 = none
  uint64_t inflAddr;      // per-vertex blendshape influence (float[]); 0 = none
  uint64_t faceAddr;      // per-triangle source USD face id (uint[]); 0 = none
  uint64_t triMatAddr;    // per-triangle material id (uint[]); 0 = matId
  uint64_t submeshAddr;   // uvec4[firstPrim,count,frontMat,backMat][]
  uint64_t jointAddr;     // per-vertex 4 joint ids (uint[4]); 0 = unskinned
  uint64_t weightAddr;    // per-vertex 4 skin weights (float[4]); 0 = unskinned
  uint     matId;         // index into the materials SSBO (-1 as 0xffffffff -> gray)
  uint     geometricNormal;  // bit0 = no authored normals (geometric face normal);
                             // bits1-2 = USD purpose id (0=def/1=render/2=proxy/3=guide)
  uint     submeshCount;
  uint     pad;
  vec4     nrm0;          // normal matrix columns (xyz used)
  vec4     nrm1;
  vec4     nrm2;
};

// Per-TLAS-instance info, indexed by gl_InstanceID (full range).
struct InstInfo {
  uint meshId;       // index into meshes[]
  uint useMaterial;  // 1 = non-instanced (material + normalMat); 0 = tint + o2w normal
  uint directLightMask;
  uint shadowLightMask;
  vec4 tint;         // per-instance color/opacity or flatColor/flatOpacity
};

#define MAX_TLAS_CHUNKS 4u
layout(set = 0, binding = 0) uniform accelerationStructureEXT TLAS[MAX_TLAS_CHUNKS];
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outImg;
layout(set = 0, binding = 2, scalar) readonly buffer Meshes { MeshDesc meshes[]; };
// 3 vec4 per material: [0]=baseColor.rgb + alpha,
// [1]=(metallic,roughness,alphaMode,alphaCutoff), [2]=emissive.rgb + 0.
// mat(id,k) indexes row k of material id.
layout(set = 0, binding = 3, scalar) readonly buffer Mats   { vec4 matRows[]; };
#define mat(id, k) matRows[(id) * 3u + (k)]
layout(set = 0, binding = 4, scalar) readonly buffer Insts  { InstInfo insts[]; };
// Progressive accumulation buffer (radiance sum). Read+write rgba32f.
layout(set = 0, binding = 5, rgba32f) uniform image2D accumImg;
// 18 vec4 per material: LightRT/OpenPBR constant fallback. lrt(id,12).w is 1
// when populated.
layout(set = 0, binding = 6, scalar) readonly buffer LrtMats { vec4 lrtRows[]; };
#define lrt(id, k) lrtRows[(id) * 20u + (k)]
// 10 vec4 per light: packed DrawLightCPU params. light(0,0).y holds validity flags.
layout(set = 0, binding = 7, scalar) readonly buffer RtLights { vec4 lightRows[]; };
#define RT_LIGHT_ROWS 20u
#define light(id, k) lightRows[(id) * RT_LIGHT_ROWS + (k)]
// Dome environment cube for ray misses (sharp IBL prefilter level 0; a 1x1
// black cube when no dome is baked).
layout(set = 0, binding = 8) uniform samplerCube uEnvCube;
// GGX-prefiltered cube + split-sum BRDF LUT for surface specular IBL.
layout(set = 0, binding = 9) uniform samplerCube uPrefilteredCube;
layout(set = 0, binding = 10) uniform sampler2D uBrdfLut;

struct RtTexDesc {
  int offset; int width; int height; int wrapS; int wrapT; int srgb; int isUdim;
  int isPtex; int ptexCols; int ptexRows; int ptexTileEdge;
  int ptexRectTexelOffset; int ptexFaceCount;
  int mipCount; int firstMip;
  int imageSlot;
  int udimLayer[100];
};
layout(set = 0, binding = 11, scalar) readonly buffer RtTexels {
  uint texelWords[];
};
layout(set = 0, binding = 12, scalar) readonly buffer RtTexDescs {
  RtTexDesc texDescs[];
};
layout(set = 0, binding = 13, scalar) readonly buffer RtMatTexIds {
  int matTexIds[];
};
layout(set = 0, binding = 14, scalar) readonly buffer RtMatTexParams {
  float matTexParams[];
};
// Canonical MaterialX graph blocks. The interpreter is deliberately kept
// optional while the semantic texture path remains the compatibility fallback.
layout(set = 0, binding = 20, scalar) readonly buffer RtMaterialGraphs {
  float graphRows[];
};
// scalar layout keeps only the fields used by the analytic ellipse kernel:
// center/major/normal (vec3), radii (vec2), and RGBA color. This is 60 bytes
// instead of five padded vec4 fields (80 bytes) per Gaussian.
struct RtPoint {
  vec3 center; vec3 major; vec3 normal; vec2 radii; vec4 color;
  uint directLightMask; uint shadowLightMask;
};
struct RtPointNode { vec3 bmin; vec3 bmax; int left; int right; int count; };
struct RtPointChunk { int first; int count; int orderFirst; int bvhFirst; int bvhCount; };
layout(set = 0, binding = 15, scalar) readonly buffer RtPoints { RtPoint points[]; };
layout(set = 0, binding = 16, scalar) readonly buffer RtPointNodes { RtPointNode pointNodes[]; };
layout(set = 0, binding = 17, scalar) readonly buffer RtPointOrder { int pointOrder[]; };
layout(set = 0, binding = 18, scalar) readonly buffer RtPointChunks { RtPointChunk pointChunks[]; };
// Native compressed Ptex images. Unused entries are bound to the white image;
// descriptor indexing lets RT sample the same BC7 VkImage that raster uses.
#ifndef TUSDVIEW_RT_PTEXTURE_IMAGE_CAP
#define TUSDVIEW_RT_PTEXTURE_IMAGE_CAP 256
#endif
layout(set = 0, binding = 19)
    uniform sampler2D rtPtexImages[TUSDVIEW_RT_PTEXTURE_IMAGE_CAP];

layout(push_constant) uniform PC {
  mat4 invViewProj;  // inverse(proj * view)
  vec4 camPos;       // xyz = camera world position, w = RenderMode
  vec4 lightDir;     // xyz = unit direction *towards* the light, w = depthScale
  vec4 clearColor;   // rgb background for ray misses, w = exposure stops
  vec4 sceneMin;     // xyz = position AOV bbox min, w = accumulated sample index
  vec4 sceneExtent;  // xyz bbox; abs(w)=TLAS chunks, positive=accumulation enabled
  vec4 lens;         // focus distance, aperture radius, enabled, TLAS chunk stride
  uvec4 pointParams; // native Gaussian point count, node count, chunk count
} pc;

uint globalInstanceId(uint chunk, int localId) {
  // Every non-final TLAS contains exactly the device's advertised maximum
  // instance count. That limit (<= 2^24-1) is exactly representable as float.
  return chunk * uint(pc.lens.w) + uint(localId);
}

uint tlasChunkCount() { return uint(abs(pc.sceneExtent.w) + 0.5); }

// Radical-inverse (Halton) low-discrepancy sequence for sub-pixel jitter.
float halton(uint i, uint b) {
  float f = 1.0, r = 0.0;
  while (i > 0u) { f /= float(b); r += f * float(i % b); i /= b; }
  return r;
}

vec3 fetchPos(Verts vb, uint vi) {
  return vec3(vb.v[vi * 8u + 0u], vb.v[vi * 8u + 1u], vb.v[vi * 8u + 2u]);
}
vec3 fetchNrm(Verts vb, uint vi) {
  return vec3(vb.v[vi * 8u + 3u], vb.v[vi * 8u + 4u], vb.v[vi * 8u + 5u]);
}
vec4 fetchCol(Cols cb, uint vi) {
  return vec4(cb.c[vi * 4u + 0u], cb.c[vi * 4u + 1u],
              cb.c[vi * 4u + 2u], cb.c[vi * 4u + 3u]);
}
vec2 fetchUV(Verts vb, uint vi) {
  return vec2(vb.v[vi * 8u + 6u], vb.v[vi * 8u + 7u]);
}
vec2 fetchUV1(UV1s ub, uint vi) { return vec2(ub.u[vi * 2u + 0u], ub.u[vi * 2u + 1u]); }
float fetchInfl(Infls ib, uint vi) { return ib.f[vi]; }
// Dominant skin joint (max weight of the 4) for a vertex; returns id, w = weight.
int fetchDomJoint(Joints jb, Weights wb, uint vi, out float wOut) {
  int dj = -1; float dw = 0.0;
  for (uint k = 0u; k < 4u; ++k) {
    float wk = wb.w[vi * 4u + k];
    if (wk > dw) { dw = wk; dj = int(jb.j[vi * 4u + k]); }
  }
  wOut = dw;
  return dj;
}

// Hash-based per-pixel RNG (PCG-ish) for the ambient-occlusion sampler.
uint hashU(uint x) { x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16; return x; }
float rnd(inout uint s) { s = s * 747796405u + 2891336453u; uint r = ((s >> ((s >> 28) + 4u)) ^ s) * 277803737u; return float((r >> 22) ^ r) / 4294967296.0; }
// Uniformly sample an authored analytic light surface. Degenerate shapes stay
// at the representative position so PointLight and zero-area behavior match
// the historical hard-shadow path exactly.
vec3 sampleLightPosition(uint li, int lightType, inout uint seed) {
  vec3 center = light(li, 1u).xyz;
  float radius = max(light(li, 1u).w, 0.0);
  vec4 dimensions = light(li, 5u);
  vec3 axisX = normalize(light(li, 10u).xyz);
  vec3 axisY = normalize(light(li, 11u).xyz);
  vec3 axisZ = normalize(light(li, 12u).xyz);
  if (lightType == 1 && radius > 1e-7) {
    float z = 1.0 - 2.0 * rnd(seed);
    float a = 6.28318530718 * rnd(seed);
    float r = sqrt(max(0.0, 1.0 - z * z));
    return center + radius * vec3(r * cos(a), r * sin(a), z);
  }
  if (lightType == 2 && radius > 1e-7) {
    float a = 6.28318530718 * rnd(seed);
    float r = radius * sqrt(rnd(seed));
    return center + axisX * (r * cos(a)) + axisY * (r * sin(a));
  }
  if (lightType == 3 && dimensions.x > 1e-7 && dimensions.y > 1e-7) {
    return center + axisX * ((rnd(seed) - 0.5) * dimensions.x) +
           axisY * ((rnd(seed) - 0.5) * dimensions.y);
  }
  if (lightType == 4 && radius > 1e-7 && dimensions.z > 1e-7) {
    float a = 6.28318530718 * rnd(seed);
    return center + axisX * (radius * cos(a)) +
           axisY * (radius * sin(a)) +
           axisZ * ((rnd(seed) - 0.5) * dimensions.z);
  }
  return center;
}

float rtIesSample(uint li, int index) {
  vec4 row = lightRows[li * RT_LIGHT_ROWS + 14u + uint(index / 4)];
  return row[uint(index % 4)];
}

float rtIesFactor(uint li, vec3 lightToPoint) {
  if (abs(light(li, 13u).x - 2.0) > 0.25) return 1.0;
  vec3 d = normalize(lightToPoint);
  vec3 emissionDir = normalize(light(li, 2u).xyz);
  float v = degrees(acos(clamp(dot(d, emissionDir), -1.0, 1.0)));
  float fy = clamp(v / 60.0, 0.0, 3.0);
  int y0 = int(floor(fy));
  int y1 = min(y0 + 1, 3);
  vec3 axisX = normalize(light(li, 10u).xyz);
  vec3 axisY = normalize(light(li, 11u).xyz);
  float az = degrees(atan(dot(d, axisY), dot(d, axisX)));
  if (az < 0.0) az += 360.0;
  float fx = az / 60.0;
  int x0 = int(floor(fx)) % 6;
  int x1 = (x0 + 1) % 6;
  float tx = fract(fx);
  float a0 = mix(rtIesSample(li, y0 * 6 + x0),
                 rtIesSample(li, y0 * 6 + x1), tx);
  float a1 = mix(rtIesSample(li, y1 * 6 + x0),
                 rtIesSample(li, y1 * 6 + x1), tx);
  return mix(a0, a1, fy - float(y0));
}
// Cosine-weighted hemisphere direction around normal n.
vec3 cosHemi(vec3 n, float u1, float u2) {
  float r = sqrt(u1); float phi = 6.2831853 * u2;
  vec3 t = normalize(abs(n.x) > 0.9 ? vec3(0,1,0) : vec3(1,0,0));
  vec3 b = normalize(cross(n, t)); t = cross(b, n);
  return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - u1)));
}

// Stable distinct color per material id (-1 / 0xffffffff -> neutral gray).
// Order-2 SH irradiance eval (basis matches the bake in texture_tools.cc).
// `li` = light index, rows 13-19 hold 27 coeff-major RGB floats.
float shCoef(uint li, uint i) {
  vec4 r = light(li, 13u + i / 4u);
  return r[i % 4u];
}

vec3 rtDomeRadiance(vec3 direction) {
  uint count = uint(lightRows.length()) / RT_LIGHT_ROWS;
  for (uint li = 0u; li < count; ++li) {
    if (int(light(li, 0u).x + 0.5) != 6 ||
        (int(light(li, 1u).y + 0.5) & (1 << 7)) == 0) continue;
    vec3 d = normalize(direction);
    float b[9];
    b[0] = 0.282095;
    b[1] = 0.488603 * d.y;
    b[2] = 0.488603 * d.z;
    b[3] = 0.488603 * d.x;
    b[4] = 1.092548 * d.x * d.y;
    b[5] = 1.092548 * d.y * d.z;
    b[6] = 0.315392 * (3.0 * d.z * d.z - 1.0);
    b[7] = 1.092548 * d.x * d.z;
    b[8] = 0.546274 * (d.x * d.x - d.y * d.y);
    vec3 e = vec3(0.0);
    [[dont_unroll]] for (uint k = 0u; k < 9u; ++k)
      e += b[k] * vec3(shCoef(li, k * 3u + 0u),
                       shCoef(li, k * 3u + 1u),
                       shCoef(li, k * 3u + 2u));
    return max(e, vec3(0.0));
  }
  return vec3(0.0);
}
vec3 shIrradiance(uint li, vec3 n) {
  float b[9];
  b[0] = 0.282095;
  b[1] = 0.488603 * n.y;
  b[2] = 0.488603 * n.z;
  b[3] = 0.488603 * n.x;
  b[4] = 1.092548 * n.x * n.y;
  b[5] = 1.092548 * n.y * n.z;
  b[6] = 0.315392 * (3.0 * n.z * n.z - 1.0);
  b[7] = 1.092548 * n.x * n.z;
  b[8] = 0.546274 * (n.x * n.x - n.y * n.y);
  vec3 e = vec3(0.0);
  [[dont_unroll]] for (uint k = 0u; k < 9u; ++k) {
    e += b[k] * vec3(shCoef(li, k * 3u + 0u), shCoef(li, k * 3u + 1u),
                     shCoef(li, k * 3u + 2u));
  }
  return max(e, vec3(0.0));
}

vec3 idColor(uint id) {
  if (id == 0xffffffffu) return vec3(0.45);
  uint h = (id + 1u) * 2654435761u;
  return vec3(float(h & 255u), float((h >> 8) & 255u), float((h >> 16) & 255u)) * (1.0 / 255.0);
}

// Linear -> sRGB OETF for the final shaded image, matching the raster path
// (mesh.frag). The tracer lights in linear space and the target image is UNORM,
// so shaded/wireframe output is encoded here; debug AOVs are left raw.
vec3 linearToSrgb(vec3 c) {
  c = clamp(c, 0.0, 1.0);
  vec3 lo = c * 12.92;
  vec3 hi = 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055;
  return mix(lo, hi, greaterThan(c, vec3(0.0031308)));
}

// Inverse of the above (sRGB -> linear), for values authored in DISPLAY space
// that must survive the encode below.
vec3 srgbToLinear(vec3 c) {
  c = clamp(c, 0.0, 1.0);
  vec3 lo = c * (1.0 / 12.92);
  vec3 hi = pow((c + 0.055) * (1.0 / 1.055), vec3(2.4));
  return mix(lo, hi, greaterThan(c, vec3(0.04045)));
}

float ggxD(float nh, float roughness) {
  float a = max(roughness * roughness, 0.002);
  float a2 = a * a;
  float d = nh * nh * (a2 - 1.0) + 1.0;
  return a2 / max(3.14159265 * d * d, 1e-6);
}
float ggxG1(float nx, float roughness) {
  float k = (roughness + 1.0) * (roughness + 1.0) * 0.125;
  return nx / max(nx * (1.0 - k) + k, 1e-6);
}
float ggxDAniso(float nh, float hT, float hB, float roughness,
                float anisotropy) {
  float a = max(roughness * roughness, 0.002);
  float ax = max(a * (1.0 + anisotropy), 0.001);
  float ay = max(a * (1.0 - anisotropy), 0.001);
  float q = (hT * hT) / (ax * ax) + (hB * hB) / (ay * ay) + nh * nh;
  return 1.0 / max(3.14159265 * ax * ay * q * q, 1e-6);
}
float ggxG1Aniso(float nv, float vT, float vB, float roughness,
                 float anisotropy) {
  float a = max(roughness * roughness, 0.002);
  float ax = max(a * (1.0 + anisotropy), 0.001);
  float ay = max(a * (1.0 - anisotropy), 0.001);
  float vn2 = max(nv * nv, 1e-6);
  float lambda = 0.5 * (-1.0 + sqrt(1.0 +
      (vT * vT * ax * ax + vB * vB * ay * ay) / vn2));
  return 1.0 / max(1.0 + lambda, 1e-6);
}
vec3 fresnelSchlick(float vh, vec3 f0) {
  return f0 + (vec3(1.0) - f0) * pow(1.0 - clamp(vh, 0.0, 1.0), 5.0);
}

vec3 applyThinFilm(vec3 f0, float cosTheta, float weight,
                   float thickness, float ior) {
  float w = clamp(weight, 0.0, 1.0);
  if (w <= 0.0 || thickness <= 0.0) return f0;
  float phase = 6.28318530718 * max(ior, 1.0) * thickness *
                (1.0 - clamp(cosTheta, 0.0, 1.0));
  vec3 film = 0.5 + 0.5 * cos(phase * vec3(1.0, 1.17, 1.35) +
                              vec3(0.0, 2.1, 4.2));
  return mix(f0, clamp(f0 + (vec3(1.0) - f0) * film * 0.65,
                       vec3(0.0), vec3(1.0)), w);
}

float wrapCoord(float x, int mode) {
  if (mode == 0 || mode == 3) return clamp(x, 0.0, 1.0);
  if (mode == 2) {
    float tile = floor(x), f = x - tile;
    return (int(tile) & 1) != 0 ? 1.0 - f : f;
  }
  return fract(x);
}

vec4 fetchTexel(RtTexDesc td, int x, int y) {
  uint word = texelWords[uint(td.offset / 4 + (y * td.width + x))];
  vec4 c = unpackUnorm4x8(word);
  if (td.srgb != 0) c.rgb = srgbToLinear(c.rgb);
  return c;
}

vec4 sampleRtTextureLevel(RtTexDesc td, vec2 uv) {
  vec2 p = vec2(wrapCoord(uv.x, td.wrapS), wrapCoord(uv.y, td.wrapT)) *
           vec2(td.width - 1, td.height - 1);
  ivec2 p0 = ivec2(floor(p));
  ivec2 p1 = min(p0 + ivec2(1), ivec2(td.width - 1, td.height - 1));
  vec2 f = fract(p);
  vec4 a = mix(fetchTexel(td, p0.x, p0.y), fetchTexel(td, p1.x, p0.y), f.x);
  vec4 b = mix(fetchTexel(td, p0.x, p1.y), fetchTexel(td, p1.x, p1.y), f.x);
  return mix(a, b, f.y);
}

vec4 sampleRtTextureLod(int id, vec2 uv, float lod, vec4 missing) {
  if (id < 0 || id >= int(texDescs.length())) return missing;
  RtTexDesc td = texDescs[id];
  if (td.isUdim != 0) {
    ivec2 tile = ivec2(floor(uv));
    int lut = tile.x + tile.y * 10;
    if (lut < 0 || lut >= 100) return missing;
    int tileId = td.udimLayer[lut];
    if (tileId < 0 || tileId >= int(texDescs.length())) return missing;
    td = texDescs[tileId];
    uv = fract(uv);
  }
  if (td.width <= 0 || td.height <= 0) return missing;
  float clampedLod = clamp(lod, 0.0, float(max(td.mipCount - 1, 0)));
  int l0 = int(floor(clampedLod));
  int l1 = min(l0 + 1, td.mipCount - 1);
  RtTexDesc td0 = l0 == 0 ? td : texDescs[td.firstMip + l0 - 1];
  RtTexDesc td1 = l1 == 0 ? td : texDescs[td.firstMip + l1 - 1];
  return mix(sampleRtTextureLevel(td0, uv), sampleRtTextureLevel(td1, uv),
             fract(clampedLod));
}

vec4 sampleRtTexture(int id, vec2 uv, vec4 missing) {
  return sampleRtTextureLod(id, uv, 0.0, missing);
}

vec2 ptexAtlasUv(RtTexDesc td, vec2 uv, uint face) {
  if (td.isPtex == 0 || face >= uint(td.ptexFaceCount)) return uv;
  uint values[4];
  for (uint c = 0u; c < 4u; ++c) {
    uint lo = uint(td.ptexRectTexelOffset) + face * 8u + c * 2u;
    uint a = (texelWords[uint(td.offset / 4) + lo] >> 24u) & 255u;
    uint b = (texelWords[uint(td.offset / 4) + lo + 1u] >> 24u) & 255u;
    values[c] = a | (b << 8u);
  }
  if (values[2] == 0u || values[3] == 0u) return uv;
  vec2 px = vec2(float(values[0]), float(values[1])) +
            vec2(clamp(uv.x, 0.0, 1.0), 1.0 - clamp(uv.y, 0.0, 1.0)) *
            vec2(float(values[2] - 1u), float(values[3] - 1u));
  return px / vec2(max(td.width - 1, 1), max(td.height - 1, 1));
}

vec4 sampleRtPtexTextureLod(int id, vec2 uv, uint face, float lod,
                            vec4 missing) {
  if (id < 0 || id >= int(texDescs.length())) return missing;
  RtTexDesc td = texDescs[id];
  vec2 atlasUv = ptexAtlasUv(td, uv, face);
  if (td.imageSlot >= 0 && td.imageSlot < TUSDVIEW_RT_PTEXTURE_IMAGE_CAP)
    return textureLod(rtPtexImages[nonuniformEXT(td.imageSlot)], atlasUv, lod);
  return sampleRtTextureLod(id, atlasUv, lod, missing);
}

vec4 sampleRtMaterialTexture(int id, vec2 uv, uint face, float lod,
                             vec4 missing) {
  if (id >= 0 && id < int(texDescs.length()) && texDescs[id].isPtex != 0) {
    return sampleRtPtexTextureLod(id, uv, face, lod, missing);
  }
  return sampleRtTextureLod(id, uv, lod, missing);
}

// Evaluate the compact MaterialX IR. A bounded fixed-point pass makes forward
// references deterministic without recursion (and keeps malformed graphs from
// consuming unbounded shader time). Image nodes use the scene texture table;
// unresolved images retain their authored constant/default value.
#if TUSDVIEW_RT_DISABLE_MTLX
vec4 evalMaterialXGraph(uint mid, int route, vec2 uv0, vec2 uv1, uint face) {
  // Fast RT variant: this function is unreachable when graph rows are empty,
  // but retaining the ABI-compatible stub keeps the material code identical.
  return vec4(0.0);
}
#else
vec4 evalMaterialXGraph(uint mid, int route, vec2 uv0, vec2 uv1, uint face) {
  const uint STRIDE = 1355u;
  uint base = mid * STRIDE;
  if (base + 9u >= uint(graphRows.length()) || route < 0 || route > 8) return vec4(0.0);
  int count = int(clamp(graphRows[base], 0.0, 64.0));
  int wanted = int(graphRows[base + 1u + uint(route)] + 0.5);
  if (count <= 0 || wanted < 0 || wanted >= count) return vec4(0.0);
  bool hasForwardRef = false;
  for (int i = 0; i < count && !hasForwardRef; ++i) {
    uint p = base + 10u + uint(i) * 21u;
    hasForwardRef = int(graphRows[p + 1u] + 0.5) > i ||
                    int(graphRows[p + 2u] + 0.5) > i ||
                    int(graphRows[p + 3u] + 0.5) > i;
  }
  int passCount = hasForwardRef ? count : 1;
  vec4 v[64];
  // Keep the storage bounded to the packed ABI, but make the iteration count
  // runtime-dependent. A literal 64x64 fixed-point nest makes NVIDIA's cold
  // SPIR-V compiler unroll thousands of graph operations even for materials
  // with one node; dynamic bounds preserve the same dependency semantics and
  // materially reduce vkCreateComputePipelines time.
  [[dont_unroll]] for (int i = 0; i < count; ++i) v[i] = vec4(0.0);
  [[dont_unroll]] for (int pass = 0; pass < passCount; ++pass) {
    [[dont_unroll]] for (int i = 0; i < count; ++i) {
      uint p = base + 10u + uint(i) * 21u;
      int op = int(graphRows[p] + 0.5);
      int a = int(graphRows[p + 1u] + 0.5);
      int b = int(graphRows[p + 2u] + 0.5);
      int c = int(graphRows[p + 3u] + 0.5);
      vec4 av = (a >= 0 && a < count) ? v[a] : vec4(graphRows[p + 4u], graphRows[p + 5u], graphRows[p + 6u], graphRows[p + 7u]);
      vec4 bv = (b >= 0 && b < count) ? v[b] : vec4(graphRows[p + 8u], graphRows[p + 9u], graphRows[p + 10u], graphRows[p + 11u]);
      vec4 cv = (c >= 0 && c < count) ? v[c] : vec4(graphRows[p + 12u], graphRows[p + 13u], graphRows[p + 14u], graphRows[p + 15u]);
      vec4 value = av;
      int tex = int(graphRows[p + 16u] + 0.5);
      vec2 graphUv = uv0;
      // floor preserves the -1 sentinel used when an image has no explicit
      // texcoord input; truncation would turn -1 into zero and pin sampling
      // to the first graph value instead of the hit UV.
      int uvInput = int(floor(graphRows[p + 15u] + 0.5));
      if (uvInput == 0) graphUv = av.xy;
      else if (uvInput == 1) graphUv = bv.xy;
      else if (uvInput == 2) graphUv = cv.xy;
      graphUv = graphUv * vec2(graphRows[p + 17u], graphRows[p + 18u]) +
                vec2(graphRows[p + 19u], graphRows[p + 20u]);
      if (op == 0) v[i] = value;
      else if (op == 1 || op == 2) v[i] = tex >= 0
          ? sampleRtMaterialTexture(tex, graphUv, face, 0.0, value) : value;
      else if (op == 3) v[i] = vec4(normalize(av.xyz * 2.0 - 1.0) * 0.5 + 0.5, av.w);
      else if (op == 4) v[i] = av + bv;
      else if (op == 5) v[i] = av - bv;
      else if (op == 6) v[i] = av * bv;
      else if (op == 7) v[i] = av / max(abs(bv), vec4(1e-6));
      else if (op == 8) v[i] = mix(av, bv, cv);
      else if (op == 9) v[i] = clamp(av, bv, cv);
      else if (op == 10) v[i] = vec4(dot(av.xyz, bv.xyz));
      else if (op == 11) v[i] = vec4(normalize(av.xyz), av.w);
      else if (op == 12) v[i] = pow(max(av, vec4(0.0)), bv);
      else if (op == 13) v[i] = min(av, bv);
      else if (op == 14) v[i] = max(av, bv);
      else if (op == 15) v[i] = abs(av);
      else if (op == 16) v[i] = sqrt(max(av, vec4(0.0)));
      else if (op == 17) v[i] = sin(av);
      else if (op == 18) v[i] = cos(av);
      else if (op == 19) {
        float l = dot(av.xyz, vec3(0.2126, 0.7152, 0.0722));
        v[i] = vec4(l, l, l, av.w);
      } else if (op == 20) v[i] = av.x >= 0.5 ? bv : cv;
      else if (op == 21) v[i] = vec4(uv1, 0.0, 1.0);
      else if (op == 22) v[i] = floor(av);
      else if (op == 23) v[i] = ceil(av);
      else if (op == 24) v[i] = fract(av);
      else if (op == 25) v[i] = step(av, bv);
      else if (op == 26) v[i] = smoothstep(bv, cv, av);
      else if (op == 27) v[i] = vec4(cross(av.xyz, bv.xyz), av.w);
      else if (op == 28) v[i] = vec4(length(av.xyz));
      else if (op == 29) v[i] = vec4(fract(sin(dot(av.xy + uv0, vec2(127.1, 311.7))) * 43758.5453));
      else if (op == 40) v[i] = vec4(fract(sin(dot(av.xyz + vec3(uv0, uv0.x + uv0.y),
                                                        vec3(127.1, 311.7, 74.7))) *
                                           43758.5453));
      else if (op == 30) v[i] = tan(av);
      else if (op == 31) v[i] = exp(av);
      else if (op == 32) v[i] = log(max(av, vec4(1e-6)));
      else if (op == 33) v[i] = mod(av, max(abs(bv), vec4(1e-6)));
      else if (op == 41) v[i] = atan(av, bv);
      else if (op == 42) v[i] = sign(av);
      else if (op == 43) v[i] = round(av);
      else if (op == 34) v[i] = vec4(1.0) - av;
      else if (op == 35) v[i] = (av - bv) / max(cv - bv, vec4(1e-6));
      else if (op == 36) v[i] = vec4(0.0, 0.0, 1.0, 1.0);
      else if (op == 37) v[i] = vec4(1.0, 0.0, 0.0, 1.0);
      else if (op == 38) {
        vec3 axis = normalize(bv.xyz);
        float ang = radians(av.x);
        vec3 q = cv.xyz;
        v[i] = vec4(q * cos(ang) + cross(axis, q) * sin(ang) +
                    axis * dot(axis, q) * (1.0 - cos(ang)), cv.w);
      }
      else if (op == 39) {
        vec2 t = av.xy * vec2(graphRows[p + 17u], graphRows[p + 18u]) +
                 vec2(graphRows[p + 19u], graphRows[p + 20u]);
        float a2 = radians(graphRows[p + 15u]);
        v[i] = vec4(vec2(t.x * cos(a2) - t.y * sin(a2),
                         t.x * sin(a2) + t.y * cos(a2)), av.zw);
      }
      else v[i] = value;
    }
  }
  return v[wanted];
}
#endif

float rtTextureLod(int id, vec2 uv, float uvFootprint) {
  if (id < 0 || id >= int(texDescs.length())) return 0.0;
  RtTexDesc td = texDescs[id];
  if (td.isUdim != 0) {
    ivec2 tile = ivec2(floor(uv));
    int lut = tile.x + tile.y * 10;
    if (lut < 0 || lut >= 100) return 0.0;
    int tileId = td.udimLayer[lut];
    if (tileId < 0 || tileId >= int(texDescs.length())) return 0.0;
    td = texDescs[tileId];
  }
  return clamp(log2(max(uvFootprint * float(max(td.width, td.height)), 1.0)),
               0.0, float(max(td.mipCount - 1, 0)));
}

float texChannel(vec4 c, int channel) {
  return channel == 1 ? c.g : channel == 2 ? c.b : channel == 3 ? c.a : c.r;
}

vec2 materialUv(uint matId, int slot, vec2 uv0, vec2 uv1) {
  uint base = matId * 155u;
  // Slots 0-5 use the row-69 bitmask; the added slots 12-15 (occlusion, coat
  // weight, coat color, coat roughness) use row 99 bits 0-3.
  int bits = slot < 12 ? int(matTexParams[base + 69u] + 0.5)
                       : (int(matTexParams[base + 99u] + 0.5) << 12);
  vec2 uv = ((bits & (1 << slot)) != 0) ? uv1 : uv0;
  uint o = base + uint(slot * 6);
  return vec2(matTexParams[o + 0u] * uv.x + matTexParams[o + 1u] * uv.y +
                  matTexParams[o + 2u],
              matTexParams[o + 3u] * uv.x + matTexParams[o + 4u] * uv.y +
                  matTexParams[o + 5u]);
}

float materialUvFootprint(uint matId, int slot, float footprint) {
  uint o = matId * 155u + uint(slot * 6);
  float sx = length(vec2(matTexParams[o + 0u], matTexParams[o + 3u]));
  float sy = length(vec2(matTexParams[o + 1u], matTexParams[o + 4u]));
  return footprint * max(sx, sy);
}

uint selectedMaterial(MeshDesc md, int prim, bool frontFace) {
  if (md.submeshAddr != 0ul) {
    SubmeshRanges ranges = SubmeshRanges(md.submeshAddr);
    for (uint si = 0u; si < md.submeshCount; ++si) {
      uvec4 sr = ranges.r[si];
      if (uint(prim) >= sr.x && uint(prim) < sr.x + sr.y) {
        return frontFace ? sr.z : sr.w;
      }
    }
  }
  return md.triMatAddr != 0ul ? TriMats(md.triMatAddr).m[uint(prim)]
                               : md.matId;
}

bool materialAllowsHit(uint iid, int prim, vec2 bc, bool frontFace) {
  InstInfo ii = insts[iid];
  MeshDesc md = meshes[ii.meshId];
  uint mid = selectedMaterial(md, prim, frontFace);
  if (ii.useMaterial == 0u || mid == 0xffffffffu) return true;
  float alphaMode = mat(mid, 1u).z;
  if (!(alphaMode > 0.5 && alphaMode < 1.5)) return true;
  Verts vb = Verts(md.vtxAddr);
  Idx ib = Idx(md.idxAddr);
  uint i0 = ib.i[uint(prim) * 3u + 0u];
  uint i1 = ib.i[uint(prim) * 3u + 1u];
  uint i2 = ib.i[uint(prim) * 3u + 2u];
  float w0 = 1.0 - bc.x - bc.y;
  vec2 uv0 = fetchUV(vb, i0) * w0 + fetchUV(vb, i1) * bc.x +
             fetchUV(vb, i2) * bc.y;
  vec2 uv1 = uv0;
  if (md.uv1Addr != 0ul) {
    UV1s ub = UV1s(md.uv1Addr);
    uv1 = fetchUV1(ub, i0) * w0 + fetchUV1(ub, i1) * bc.x +
          fetchUV1(ub, i2) * bc.y;
  }
  uint tb = mid * 12u;
  uint pb = mid * 155u;
  vec4 bt = sampleRtTexture(matTexIds[tb], materialUv(mid, 0, uv0, uv1),
                            vec4(1.0));
  bt = bt * vec4(matTexParams[pb + 36u], matTexParams[pb + 37u],
                 matTexParams[pb + 38u], matTexParams[pb + 39u]) +
       vec4(matTexParams[pb + 40u], matTexParams[pb + 41u],
            matTexParams[pb + 42u], matTexParams[pb + 43u]);
  float alpha = mat(mid, 0u).a * bt.a * ii.tint.a;
  int opacityTex = matTexIds[tb + 5u];
  if (opacityTex >= 0) {
    vec4 ot = sampleRtTexture(opacityTex, materialUv(mid, 5, uv0, uv1),
                              vec4(1.0));
    alpha *= texChannel(ot, int(matTexParams[pb + 66u] + 0.5)) *
                 matTexParams[pb + 67u] +
             matTexParams[pb + 68u];
  }
  if (md.vtxColorAddr != 0ul) {
    Cols cbuff = Cols(md.vtxColorAddr);
    alpha *= fetchCol(cbuff, i0).a * w0 + fetchCol(cbuff, i1).a * bc.x +
             fetchCol(cbuff, i2).a * bc.y;
  }
  return alpha >= mat(mid, 1u).w;
}

// Return the resolved blend opacity for a hit. Alpha-mask candidates are
// filtered separately by materialAllowsHit(); keeping this value available
// lets shadow rays accumulate transmission through several blend surfaces.
float materialOpacityAtHit(uint iid, int prim, vec2 bc, bool frontFace,
                           out float alphaMode) {
  InstInfo ii = insts[iid];
  MeshDesc md = meshes[ii.meshId];
  uint mid = selectedMaterial(md, prim, frontFace);
  alphaMode = 0.0;
  if (ii.useMaterial == 0u || mid == 0xffffffffu) {
    alphaMode = ii.tint.a < 1.0 ? 2.0 : 0.0;
    return clamp(ii.tint.a, 0.0, 1.0);
  }
  alphaMode = mat(mid, 1u).z;
  Verts vb = Verts(md.vtxAddr);
  Idx ib = Idx(md.idxAddr);
  uint i0 = ib.i[uint(prim) * 3u + 0u];
  uint i1 = ib.i[uint(prim) * 3u + 1u];
  uint i2 = ib.i[uint(prim) * 3u + 2u];
  float w0 = 1.0 - bc.x - bc.y;
  vec2 uv0 = fetchUV(vb, i0) * w0 + fetchUV(vb, i1) * bc.x +
             fetchUV(vb, i2) * bc.y;
  vec2 uv1 = uv0;
  if (md.uv1Addr != 0ul) {
    UV1s ub = UV1s(md.uv1Addr);
    uv1 = fetchUV1(ub, i0) * w0 + fetchUV1(ub, i1) * bc.x +
          fetchUV1(ub, i2) * bc.y;
  }
  uint tb = mid * 12u;
  uint pb = mid * 155u;
  vec4 bt = sampleRtTexture(matTexIds[tb], materialUv(mid, 0, uv0, uv1),
                            vec4(1.0));
  bt = bt * vec4(matTexParams[pb + 36u], matTexParams[pb + 37u],
                 matTexParams[pb + 38u], matTexParams[pb + 39u]) +
       vec4(matTexParams[pb + 40u], matTexParams[pb + 41u],
            matTexParams[pb + 42u], matTexParams[pb + 43u]);
  float alpha = mat(mid, 0u).a * bt.a * ii.tint.a;
  int opacityTex = matTexIds[tb + 5u];
  if (opacityTex >= 0) {
    vec4 ot = sampleRtTexture(opacityTex, materialUv(mid, 5, uv0, uv1),
                              vec4(1.0));
    alpha *= texChannel(ot, int(matTexParams[pb + 66u] + 0.5)) *
                 matTexParams[pb + 67u] + matTexParams[pb + 68u];
  }
  if (md.vtxColorAddr != 0ul) {
    Cols cbuff = Cols(md.vtxColorAddr);
    alpha *= fetchCol(cbuff, i0).a * w0 + fetchCol(cbuff, i1).a * bc.x +
             fetchCol(cbuff, i2).a * bc.y;
  }
  alpha = clamp(alpha, 0.0, 1.0);
  if (alphaMode > 0.5 && alphaMode < 1.5)
    alpha = alpha >= mat(mid, 1u).w ? 1.0 : 0.0;
  return alpha;
}

// Find the nearest accepted triangle in all TLAS chunks. Keeping this in one
// helper lets primary rays advance past transparent layers without duplicating
// the candidate-confirmation rules used by the first-hit path.
bool traceAcceptedPrimary(vec3 o, vec3 d, float minT, float maxT,
                          out uint outIid, out int outPrim, out vec2 outBc,
                          out bool outFront, out mat4x3 outO2w,
                          out float outT) {
  bool found = false;
  float best = maxT;
  for (uint ti = 0u; ti < tlasChunkCount(); ++ti) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, TLAS[ti], 0u, 0xFF, o, minT, d, best);
    while (rayQueryProceedEXT(rq)) {
      if (rayQueryGetIntersectionTypeEXT(rq, false) !=
          gl_RayQueryCandidateIntersectionTriangleEXT) continue;
      uint iid = globalInstanceId(
          ti, rayQueryGetIntersectionInstanceIdEXT(rq, false));
      int prim = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
      vec2 bc = rayQueryGetIntersectionBarycentricsEXT(rq, false);
      bool front = rayQueryGetIntersectionFrontFaceEXT(rq, false);
      if (materialAllowsHit(iid, prim, bc, front))
        rayQueryConfirmIntersectionEXT(rq);
    }
    if (rayQueryGetIntersectionTypeEXT(rq, true) !=
        gl_RayQueryCommittedIntersectionTriangleEXT) continue;
    float t = rayQueryGetIntersectionTEXT(rq, true);
    if (t >= best) continue;
    best = t;
    found = true;
    outIid = globalInstanceId(
        ti, rayQueryGetIntersectionInstanceIdEXT(rq, true));
    outPrim = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
    outBc = rayQueryGetIntersectionBarycentricsEXT(rq, true);
    outFront = rayQueryGetIntersectionFrontFaceEXT(rq, true);
    outO2w = rayQueryGetIntersectionObjectToWorldEXT(rq, true);
    outT = t;
  }
  return found;
}

vec3 approximatePrimaryLayerColor(uint iid, int prim, vec2 bc, bool front,
                                  mat4x3 o2w) {
  InstInfo ii = insts[iid];
  MeshDesc md = meshes[ii.meshId];
  uint mid = selectedMaterial(md, prim, front);
  vec3 base = vec3(0.6);
  vec3 emission = vec3(0.0);
  if (ii.useMaterial != 0u && mid != 0xffffffffu) {
    Verts vb = Verts(md.vtxAddr);
    Idx ib = Idx(md.idxAddr);
    uint i0 = ib.i[uint(prim) * 3u + 0u];
    uint i1 = ib.i[uint(prim) * 3u + 1u];
    uint i2 = ib.i[uint(prim) * 3u + 2u];
    float w0 = 1.0 - bc.x - bc.y;
    vec2 uv0 = fetchUV(vb, i0) * w0 + fetchUV(vb, i1) * bc.x +
               fetchUV(vb, i2) * bc.y;
    vec2 uv1 = uv0;
    if (md.uv1Addr != 0ul) {
      UV1s ub = UV1s(md.uv1Addr);
      uv1 = fetchUV1(ub, i0) * w0 + fetchUV1(ub, i1) * bc.x +
            fetchUV1(ub, i2) * bc.y;
    }
    uint tb = mid * 12u;
    uint pb = mid * 155u;
    base = mat(mid, 0u).rgb;
    vec2 buv = materialUv(mid, 0, uv0, uv1);
    vec4 bt = sampleRtMaterialTexture(matTexIds[tb], buv, uint(max(prim, 0)),
                                       rtTextureLod(matTexIds[tb], buv, 0.0),
                                       vec4(1.0));
    base *= bt.rgb * vec3(matTexParams[pb + 36u], matTexParams[pb + 37u],
                          matTexParams[pb + 38u]) +
            vec3(matTexParams[pb + 40u], matTexParams[pb + 41u],
                 matTexParams[pb + 42u]);
    if (lrt(mid, 12u).w > 0.5) {
      base *= lrt(mid, 0u).rgb * lrt(mid, 0u).w;
      emission = lrt(mid, 8u).rgb * lrt(mid, 8u).w;
    }
    uint face = uint(max(prim, 0));
    uint gb = mid * 1355u;
    if (gb + 9u < uint(graphRows.length())) {
      if (graphRows[gb + 1u] >= 0.0)
        base = evalMaterialXGraph(mid, 0, uv0, uv1, face).rgb;
      if (graphRows[gb + 5u] >= 0.0)
        emission = max(evalMaterialXGraph(mid, 4, uv0, uv1, face).rgb, vec3(0.0));
    }
    vec3 wp0 = o2w * vec4(fetchPos(vb, i0), 1.0);
    vec3 wp1 = o2w * vec4(fetchPos(vb, i1), 1.0);
    vec3 wp2 = o2w * vec4(fetchPos(vb, i2), 1.0);
    vec3 hit = wp0 * w0 + wp1 * bc.x + wp2 * bc.y;
    vec3 N = normalize(cross(wp1 - wp0, wp2 - wp0));
    if (!front) N = -N;
    vec3 V = normalize(pc.camPos.xyz - hit);
    float metallic = mat(mid, 1u).x;
    float roughness = clamp(mat(mid, 1u).y, 0.02, 1.0);
    float specAnisotropy = clamp(lrt(mid, 14u).y +
                                0.5 * lrt(mid, 14u).w, -1.0, 1.0);
    float specRotation = lrt(mid, 14u).z;
    float transmission = clamp(lrt(mid, 2u).w, 0.0, 1.0);
    vec3 transmissionColor = max(lrt(mid, 2u).rgb, vec3(0.0));
    float subsurface = clamp(lrt(mid, 4u).w, 0.0, 1.0);
    vec3 subsurfaceColor = max(lrt(mid, 4u).rgb, vec3(0.0));
    vec3 subsurfaceRadius = max(lrt(mid, 5u).rgb, vec3(0.0));
    float subsurfaceScale = max(lrt(mid, 5u).w, 0.0);
    vec3 coatColor = max(lrt(mid, 6u).rgb, vec3(0.0));
    float coatWeight = clamp(lrt(mid, 6u).w, 0.0, 1.0);
    float coatRoughness = clamp(lrt(mid, 11u).x, 0.02, 1.0);
    if (gb + 9u < uint(graphRows.length())) {
      if (graphRows[gb + 2u] >= 0.0)
        metallic = clamp(evalMaterialXGraph(mid, 1, uv0, uv1, face).x, 0.0, 1.0);
      if (graphRows[gb + 3u] >= 0.0)
        roughness = clamp(evalMaterialXGraph(mid, 2, uv0, uv1, face).x, 0.02, 1.0);
      if (graphRows[gb + 7u] >= 0.0)
        subsurface = clamp(evalMaterialXGraph(mid, 6, uv0, uv1, face).x, 0.0, 1.0);
      if (graphRows[gb + 8u] >= 0.0)
        subsurfaceColor = max(evalMaterialXGraph(mid, 7, uv0, uv1, face).rgb,
                               vec3(0.0));
      if (graphRows[gb + 9u] >= 0.0)
        subsurfaceRadius = max(evalMaterialXGraph(mid, 8, uv0, uv1, face).rgb,
                               vec3(0.0));
    }
    float ior = max(lrt(mid, 10u).w, 1.0);
    float fd = (ior - 1.0) / (ior + 1.0);
    vec3 f0 = mix(vec3(fd * fd), base, metallic);
    vec3 shaded = emission + base * 0.05;
    for (uint li = 0u; li < uint(lightRows.length()) / RT_LIGHT_ROWS; ++li) {
      int lt = int(light(li, 0u).x + 0.5);
      if (lt == 6 || light(li, 0u).y <= 0.5) continue;
      vec3 L;
      float attenuation = 1.0;
      if (lt == 5) {
        L = -normalize(light(li, 2u).xyz);
      } else {
        uint seed = hashU(uint(max(prim, 0)) * 17u + iid * 131u + li);
        vec3 d = sampleLightPosition(li, lt, seed) - hit;
        float d2 = max(dot(d, d), 1e-6);
        L = d / sqrt(d2);
        attenuation = 1.0 / d2;
      }
      float nl = max(dot(N, L), 0.0);
      float nv = max(dot(N, V), 1e-4);
      if (nl <= 0.0) continue;
      vec3 H = normalize(L + V);
      float nh = max(dot(N, H), 0.0), vh = max(dot(V, H), 0.0);
      vec3 F = fresnelSchlick(vh, f0);
      vec3 diff = (vec3(1.0) - F) * (1.0 - metallic) *
                  (1.0 - transmission) * base / 3.14159265;
      vec3 tangent = normalize(abs(N.y) < 0.9
                                   ? cross(N, vec3(0.0, 1.0, 0.0))
                                   : cross(N, vec3(1.0, 0.0, 0.0)));
      vec3 bitangent = normalize(cross(N, tangent));
      float rot = radians(specRotation);
      vec3 rotatedT = tangent * cos(rot) + bitangent * sin(rot);
      vec3 rotatedB = -tangent * sin(rot) + bitangent * cos(rot);
      float hT = dot(H, rotatedT), hB = dot(H, rotatedB);
      float vT = dot(V, rotatedT), vB = dot(V, rotatedB);
      float lT = dot(L, rotatedT), lB = dot(L, rotatedB);
      vec3 spec = ggxDAniso(nh, hT, hB, roughness, specAnisotropy) *
                  ggxG1Aniso(nv, vT, vB, roughness, specAnisotropy) *
                  ggxG1Aniso(nl, lT, lB, roughness, specAnisotropy) * F /
                  max(4.0 * nv * nl, 1e-5);
      vec3 transmissionLobe = transmissionColor * transmission *
                              (vec3(1.0) - F) / 3.14159265;
      float radiusGain = clamp(sqrt(max(dot(subsurfaceRadius,
                                           vec3(0.2126, 0.7152, 0.0722)) *
                                       subsurfaceScale, 0.0)) * 8.0,
                               0.0, 1.0);
      float diffusionShape = mix(0.25 + 0.75 * pow(1.0 - nl, 2.0),
                                 0.25 + 0.75 * (1.0 - nl), radiusGain);
      vec3 subsurfaceLobe = subsurfaceColor * subsurface *
                            diffusionShape / 3.14159265;
      float coatNh = max(dot(N, H), 0.0), coatNv = max(dot(N, V), 1e-4);
      float coatNl = max(dot(N, L), 0.0);
      vec3 coatF = fresnelSchlick(vh, vec3(0.04));
      vec3 coatLobe = ggxD(coatNh, coatRoughness) *
                      ggxG1(coatNv, coatRoughness) *
                      ggxG1(coatNl, coatRoughness) * coatF /
                      max(4.0 * coatNv * coatNl, 1e-5) * coatColor * coatWeight;
      vec3 baseLobe = (diff + spec + transmissionLobe + subsurfaceLobe) *
                      (1.0 - 0.5 * coatWeight);
      shaded += (baseLobe + coatLobe) *
                light(li, 3u).rgb * attenuation * nl;
    }
    return shaded * ii.tint.rgb;
  }
  return base * ii.tint.rgb * 0.35 + emission;
}

vec3 primaryLayerTransmissionTint(uint iid, int prim, vec2 bc, bool front) {
  InstInfo ii = insts[iid];
  MeshDesc md = meshes[ii.meshId];
  uint mid = selectedMaterial(md, prim, front);
  if (ii.useMaterial == 0u || mid == 0xffffffffu) return vec3(1.0);
  float weight = clamp(lrt(mid, 2u).w, 0.0, 1.0);
  float depth = max(lrt(mid, 3u).w, 0.0);
  vec3 absorption = max(vec3(0.0), vec3(1.0) -
                        clamp(lrt(mid, 2u).rgb, vec3(0.0), vec3(1.0)));
  absorption += max(lrt(mid, 3u).rgb, vec3(0.0)) * 0.25;
  vec3 tint = vec3(1.0 + 0.35 * clamp(lrt(mid, 15u).x *
                                        lrt(mid, 15u).z, 0.0, 1.0),
                   1.0,
                   1.0 - 0.25 * clamp(lrt(mid, 15u).x *
                                       lrt(mid, 15u).z, 0.0, 1.0));
  return exp(-weight * depth * absorption) * tint;
}

float primaryLayerTransmissionWeight(uint iid, int prim, bool front, vec2 bc) {
  InstInfo ii = insts[iid];
  MeshDesc md = meshes[ii.meshId];
  uint mid = selectedMaterial(md, prim, front);
  return (ii.useMaterial != 0u && mid != 0xffffffffu)
             ? clamp(lrt(mid, 2u).w, 0.0, 1.0) : 0.0;
}

vec3 primaryLayerRefractedColor(uint iid, int prim, vec2 bc, bool front,
                                mat4x3 o2w, vec3 rayOrigin, vec3 rayDir,
                                out vec3 walkOrigin, out vec3 walkDir) {
  walkOrigin = rayOrigin;
  walkDir = rayDir;
  vec3 throughput = vec3(1.0);
  vec3 currentDir = rayDir;
  uint currentIid = iid;
  int currentPrim = prim;
  vec2 currentBc = bc;
  bool currentFront = front;
  mat4x3 currentO2w = o2w;
  // Keep the refraction walk bounded. Each accepted layer contributes its
  // transmission tint before the next ray is launched, allowing nested glass
  // and transparent shells to retain up to three refractive interfaces.
  for (int bounce = 0; bounce < 3; ++bounce) {
    InstInfo currentInst = insts[currentIid];
    MeshDesc currentMesh = meshes[currentInst.meshId];
    uint currentMid = selectedMaterial(currentMesh, currentPrim, currentFront);
    if (currentInst.useMaterial == 0u || currentMid == 0xffffffffu)
      return vec3(0.0);
    Verts vb = Verts(currentMesh.vtxAddr);
    Idx ib = Idx(currentMesh.idxAddr);
    uint i0 = ib.i[uint(currentPrim) * 3u + 0u];
    uint i1 = ib.i[uint(currentPrim) * 3u + 1u];
    uint i2 = ib.i[uint(currentPrim) * 3u + 2u];
    float w0 = 1.0 - currentBc.x - currentBc.y;
    vec3 p0 = currentO2w * vec4(fetchPos(vb, i0), 1.0);
    vec3 p1 = currentO2w * vec4(fetchPos(vb, i1), 1.0);
    vec3 p2 = currentO2w * vec4(fetchPos(vb, i2), 1.0);
    vec3 hit = p0 * w0 + p1 * currentBc.x + p2 * currentBc.y;
    vec3 N = normalize(cross(p1 - p0, p2 - p0));
    if (!currentFront) N = -N;
    float ior = max(lrt(currentMid, 10u).w, 1.0);
    float eta = currentFront ? 1.0 / ior : ior;
    vec3 refrDir = refract(currentDir, N, eta);
    if (dot(refrDir, refrDir) < 1.0e-8) refrDir = reflect(currentDir, N);
    throughput *= primaryLayerTransmissionTint(currentIid, currentPrim,
                                                currentBc, currentFront);
    vec3 refrOrigin = hit + refrDir * 1.0e-3;
    walkOrigin = refrOrigin;
    walkDir = refrDir;
    uint nextIid; int nextPrim; vec2 nextBc; bool nextFront;
    mat4x3 nextO2w; float nextT;
    if (!traceAcceptedPrimary(refrOrigin, refrDir, 1.0e-3, 1.0e30,
                              nextIid, nextPrim, nextBc, nextFront, nextO2w,
                              nextT))
      return throughput * textureLod(uEnvCube, refrDir, 0.0).rgb;
    currentDir = refrDir;
    currentIid = nextIid;
    currentPrim = nextPrim;
    currentBc = nextBc;
    currentFront = nextFront;
    currentO2w = nextO2w;
    if (bounce == 2)
      return throughput * approximatePrimaryLayerColor(
          currentIid, currentPrim, currentBc, currentFront, currentO2w);
  }
  return throughput * textureLod(uEnvCube, currentDir, 0.0).rgb;
}

bool pointBoxHit(RtPointNode n, vec3 o, vec3 inv, float best) {
  vec3 a = (n.bmin - o) * inv;
  vec3 b = (n.bmax - o) * inv;
  vec3 lo = min(a, b), hi = max(a, b);
  return max(max(lo.x, lo.y), max(lo.z, 0.0)) <=
         min(min(hi.x, hi.y), min(hi.z, best));
}

float tracePointEllipses(vec3 o, vec3 d, out int hit, out float gaussianWeight) {
  hit = -1;
  gaussianWeight = 0.0;
  uint count = pc.pointParams.x;
  uint chunkCount = pc.pointParams.z;
  if (count == 0u || chunkCount == 0u) return 1e30;
  vec3 inv = 1.0 / d;
  float best = 1e30;
  for (uint chunk = 0u; chunk < chunkCount; ++chunk) {
    RtPointChunk ch = pointChunks[chunk];
    int stack[64]; int sp = 0; stack[sp++] = 0;
    while (sp > 0) {
      RtPointNode n = pointNodes[ch.bvhFirst + stack[--sp]];
      if (!pointBoxHit(n, o, inv, best)) continue;
      if (n.count > 0) {
        for (int j = 0; j < n.count; ++j) {
          int id = pointOrder[ch.orderFirst + n.left + j];
          RtPoint p = points[id];
          vec3 N = normalize(p.normal);
          vec3 A = normalize(p.major);
          vec3 B = normalize(cross(N, A));
          float den = dot(d, N);
          if (abs(den) < 1e-7) continue;
          float t = dot(p.center - o, N) / den;
          if (t <= 0.0 || t >= best) continue;
          vec3 q = o + d * t - p.center;
          float u = dot(q, A) / max(p.radii.x, 1e-8);
          float v = dot(q, B) / max(p.radii.y, 1e-8);
          float r2 = u*u + v*v;
          if (r2 < 1.0) {
            best = t; hit = id;
            // Radii are 2 sigma; retain bounded support and Gaussian density.
            gaussianWeight = exp(-2.0 * r2);
          }
        }
      } else if (sp + 2 <= 64) {
        stack[sp++] = n.left; stack[sp++] = n.right;
      }
    }
  }
  return best;
}

void main() {
  ivec2 px = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(outImg);
  if (px.x >= size.x || px.y >= size.y) return;

  // Progressive sample index (0 = first sample after a reset). Drives both the
  // sub-pixel jitter (anti-aliasing) and the stochastic-AOV RNG so they converge.
  uint fi = uint(pc.sceneMin.w + 0.5);
  bool accumulate = pc.sceneExtent.w > 0.5;

  // Pixel -> NDC -> world ray via the inverse view-projection. Flip Y so image
  // row 0 maps to ndc.y=+1 (scene top), matching the raster path's negative-
  // height viewport; otherwise the traced image is vertically inverted. Jitter the
  // sample point inside the pixel by a Halton(2,3) offset for anti-aliasing.
  vec2 jit = accumulate ? (vec2(halton(fi + 1u, 2u), halton(fi + 1u, 3u)) - 0.5)
                        : vec2(0.0);
  vec2 uv = (vec2(px) + 0.5 + jit) / vec2(size);
  vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
  vec4 nearH = pc.invViewProj * vec4(ndc, 0.0, 1.0);
  vec4 farH  = pc.invViewProj * vec4(ndc, 1.0, 1.0);
  vec3 nearW = nearH.xyz / nearH.w;
  vec3 farW  = farH.xyz / farH.w;
  vec3 origin = nearW;
  vec3 dir = normalize(farW - nearW);
  if (pc.lens.z > 0.5) {
    vec3 eye = pc.camPos.xyz;
    vec3 right = normalize(
        (pc.invViewProj * vec4(1.0, 0.0, 1.0, 1.0)).xyz /
            (pc.invViewProj * vec4(1.0, 0.0, 1.0, 1.0)).w -
        (pc.invViewProj * vec4(-1.0, 0.0, 1.0, 1.0)).xyz /
            (pc.invViewProj * vec4(-1.0, 0.0, 1.0, 1.0)).w);
    vec3 up = normalize(
        (pc.invViewProj * vec4(0.0, 1.0, 1.0, 1.0)).xyz /
            (pc.invViewProj * vec4(0.0, 1.0, 1.0, 1.0)).w -
        (pc.invViewProj * vec4(0.0, -1.0, 1.0, 1.0)).xyz /
            (pc.invViewProj * vec4(0.0, -1.0, 1.0, 1.0)).w);
    uint lensSeed = hashU(uint(px.x) * 1973u + uint(px.y) * 9277u +
                          fi * 26699u + 17u);
    float lensAngle = 6.28318530718 * rnd(lensSeed);
    float lensRadius = pc.lens.y * sqrt(rnd(lensSeed));
    vec3 cameraForward = normalize(
        (pc.invViewProj * vec4(0.0, 0.0, 1.0, 1.0)).xyz /
            (pc.invViewProj * vec4(0.0, 0.0, 1.0, 1.0)).w - eye);
    float focusT = pc.lens.x / max(dot(dir, cameraForward), 1.0e-4);
    vec3 focusPoint = eye + dir * focusT;
    origin = eye + right * (cos(lensAngle) * lensRadius) +
             up * (sin(lensAngle) * lensRadius);
    dir = normalize(focusPoint - origin);
  }

  // The clear colour is a DISPLAY-space UI constant (0.12 -> 31/255) -- the very
  // value the raster path clears its UNORM target with. Shaded/wireframe output
  // is sRGB-encoded on the way out (see the tail of main), so those modes must
  // start from a LINEARIZED background: it then round-trips to the authored
  // value and matches raster byte-for-byte, and transparent surfaces composite
  // against it in linear space. Encoding the display value instead washed the
  // background out to 97/255 (T11). Raw AOV modes are NOT encoded, so they keep
  // the display value as-is.
  int bgMode = int(pc.camPos.w + 0.5);
  vec3 bgc = (bgMode == 0 || bgMode == 1) ? srgbToLinear(pc.clearColor.rgb)
                                          : pc.clearColor.rgb;
  vec3 outc = bgc;

  bool primaryHit = false;
  uint primaryIid = 0u;
  int primaryPrim = 0;
  vec2 primaryBc = vec2(0.0);
  bool primaryFront = true;
  float primaryT = 1e30;
  mat4x3 primaryO2w;
  bool primaryPoint = false;
  int pointId = -1;
  float pointWeight = 0.0;
  float pointT = tracePointEllipses(origin, dir, pointId, pointWeight);
  if (pointId >= 0) { primaryHit = true; primaryPoint = true; primaryT = pointT; }
  uint triangleIid = 0u;
  int trianglePrim = 0;
  vec2 triangleBc = vec2(0.0);
  bool triangleFront = true;
  mat4x3 triangleO2w;
  float triangleT = primaryT;
  if (traceAcceptedPrimary(origin, dir, 1e-3, primaryT,
                           triangleIid, trianglePrim, triangleBc,
                           triangleFront, triangleO2w, triangleT)) {
    primaryHit = true;
    primaryPoint = false;
    primaryT = triangleT;
    primaryIid = triangleIid;
    primaryPrim = trianglePrim;
    primaryBc = triangleBc;
    primaryFront = triangleFront;
    primaryO2w = triangleO2w;
  }

  // Dome env background on miss (shaded mode only): sample the baked env cube
  // scaled by the dome's effectiveColor.
  if (int(pc.camPos.w + 0.5) == 0 &&
      !primaryHit) {
    uint numL = uint(lightRows.length()) / RT_LIGHT_ROWS;
    for (uint li = 0u; li < numL; ++li) {
      vec4 l0 = light(li, 0u);  // .x type, .y flags, .z mapped envmap tex
      if (int(l0.x + 0.5) != 6) continue;             // DomeLight
      // Bit 4: 8-bit envmap texture mapped; bit 7: baked IBL env cube bound.
      if ((int(l0.y + 0.5) & (16 | 128)) == 0) continue;
      vec4 l4 = light(li, 4u);                        // effectiveColor.rgb
      // Rows 10-12: world -> environment rotation (dome orientation).
      vec3 de = vec3(dot(light(li, 10u).xyz, dir),
                     dot(light(li, 11u).xyz, dir),
                     dot(light(li, 12u).xyz, dir));
      outc = textureLod(uEnvCube, de, 0.0).rgb * l4.xyz;
      break;
    }
  }

  if (primaryPoint) {
    RtPoint p = points[pointId];
    vec3 N = normalize(p.normal);
    if (dot(N, dir) > 0.0) N = -N;
    vec3 C = p.color.rgb;
    float alpha = clamp(p.color.a * pointWeight, 0.0, 1.0);
    int rmode = int(pc.camPos.w + 0.5);
    if (rmode == 2 || rmode == 4) outc = 0.5 * (N + vec3(1.0));
    else if (rmode == 6) outc = vec3(clamp(primaryT / max(pc.lightDir.w, 1e-6), 0.0, 1.0), 0.0, 0.0);
    else if (rmode == 0) {
      vec3 lit = C * 0.12;
      uint lightCount = uint(lightRows.length()) / RT_LIGHT_ROWS;
      for (uint li = 0u; li < lightCount; ++li) {
        if ((p.directLightMask & (1u << min(li, 31u))) == 0u) continue;
        vec4 l0 = light(li, 0u);
        if (l0.y <= 0.5 || int(l0.x + 0.5) == 6) continue;
        vec3 L;
        float attenuation = 1.0;
        if (int(l0.x + 0.5) == 5) {
          L = -normalize(light(li, 2u).xyz);
        } else {
          uint seed = hashU(uint(pointId) * 131u + li * 977u + fi);
          vec3 toLight = sampleLightPosition(li, int(l0.x + 0.5), seed) - p.center;
          float d2 = max(dot(toLight, toLight), 1e-6);
          L = toLight / sqrt(d2);
          attenuation = 1.0 / d2;
        }
        float lam = max(dot(N, L), 0.0);
        float shadow = 1.0;
        if ((int(l0.y + 0.5) & 2) != 0 &&
            (p.shadowLightMask & (1u << min(li, 31u))) != 0u) {
          for (uint ti = 0u; ti < tlasChunkCount() && shadow > 0.5;
               ++ti) {
            rayQueryEXT sq;
            rayQueryInitializeEXT(sq, TLAS[ti],
                                  gl_RayFlagsTerminateOnFirstHitEXT, 0xFF,
                                  p.center + N * 1.0e-3, 1.0e-3, L, 1.0e30);
            while (rayQueryProceedEXT(sq)) {
              if (rayQueryGetIntersectionTypeEXT(sq, false) ==
                  gl_RayQueryCandidateIntersectionTriangleEXT) {
                uint si = globalInstanceId(
                    ti, rayQueryGetIntersectionInstanceIdEXT(sq, false));
                int sp = rayQueryGetIntersectionPrimitiveIndexEXT(sq, false);
                vec2 sb = rayQueryGetIntersectionBarycentricsEXT(sq, false);
                bool sf = rayQueryGetIntersectionFrontFaceEXT(sq, false);
                if (materialAllowsHit(si, sp, sb, sf))
                  rayQueryConfirmIntersectionEXT(sq);
              }
            }
            if (rayQueryGetIntersectionTypeEXT(sq, true) ==
                gl_RayQueryCommittedIntersectionTriangleEXT)
              shadow = 0.0;
          }
        }
        lit += C * light(li, 3u).rgb * attenuation * lam * shadow;
      }
      outc = lit + bgc * (1.0 - alpha);
    } else outc = C;
  } else if (primaryHit) {
    uint iid = primaryIid;
    int prim = primaryPrim;
    vec2 bc = primaryBc;
    float t = primaryT;
    vec3 hit = origin + dir * t;

    InstInfo ii = insts[iid];
    MeshDesc md = meshes[ii.meshId];
    uint mid = selectedMaterial(
        md, prim, primaryFront);
    Verts vb = Verts(md.vtxAddr);
    Idx ib = Idx(md.idxAddr);
    uint i0 = ib.i[prim * 3u + 0u];
    uint i1 = ib.i[prim * 3u + 1u];
    uint i2 = ib.i[prim * 3u + 2u];
    float w0 = 1.0 - bc.x - bc.y;
    vec2 uv0h = fetchUV(vb, i0) * w0 + fetchUV(vb, i1) * bc.x +
                fetchUV(vb, i2) * bc.y;
    vec2 uv1h = uv0h;
    if (md.uv1Addr != 0ul) {
      UV1s ub = UV1s(md.uv1Addr);
      uv1h = fetchUV1(ub, i0) * w0 + fetchUV1(ub, i1) * bc.x +
             fetchUV1(ub, i2) * bc.y;
    }

    // Object->world for this instance (instance transform for instanced meshes,
    // the mesh's world for non-instanced).
    mat4x3 o2w = primaryO2w;
    vec3 wp0 = o2w * vec4(fetchPos(vb, i0), 1.0);
    vec3 wp1 = o2w * vec4(fetchPos(vb, i1), 1.0);
    vec3 wp2 = o2w * vec4(fetchPos(vb, i2), 1.0);

    // Normal: geometric (face) when there are no authored normals, else the
    // interpolated vertex normal transformed by the normal matrix (non-instanced)
    // or the instance's object->world 3x3 (instanced).
    vec3 N;
    if ((md.geometricNormal & 1u) != 0u) {
      N = normalize(cross(wp1 - wp0, wp2 - wp0));
    } else {
      vec3 nObj = fetchNrm(vb, i0) * w0 + fetchNrm(vb, i1) * bc.x + fetchNrm(vb, i2) * bc.y;
      mat3 nm = (ii.useMaterial != 0u)
                    ? mat3(md.nrm0.xyz, md.nrm1.xyz, md.nrm2.xyz)
                    : mat3(o2w);
      N = normalize(nm * nObj);
    }
    // Two-sided shading for the geometric-normal + instanced paths: face the normal
    // toward the ray so inward-wound / back-facing triangles still light correctly
    // (mirrors the raster's gl_FrontFacing flip). Non-instanced authored normals are
    // left as-authored (matches the material shader, which does not flip them).
    bool authoredNonInstanced = (ii.useMaterial != 0u) && ((md.geometricNormal & 1u) == 0u);
    if (!authoredNonInstanced && dot(N, dir) > 0.0) N = -N;
    vec3 coatN = N;

 #if TUSDVIEW_RT_FAST_MATERIAL
    // Graph-free fast path: keep the common Preview/metallic material response
    // and hard shadows, while leaving the full OpenPBR/texture/graph path out
    // of the graph-free module so drivers have substantially less control flow
    // to specialize at pipeline creation time.
    vec3 base = vec3(0.6);
    float alpha = 1.0, metallic = 0.0, roughness = 0.5;
    float alphaMode = 0.0, alphaCutoff = 0.5;
    vec3 emissive = vec3(0.0);
    uint sourceFace = md.faceAddr != 0ul
                          ? Faces(md.faceAddr).fc[uint(prim)]
                          : uint(max(prim, 0));
    if (ii.useMaterial != 0u && mid != 0xffffffffu) {
      base = mat(mid, 0u).rgb;
      alpha = mat(mid, 0u).a;
      metallic = clamp(mat(mid, 1u).x, 0.0, 1.0);
      roughness = clamp(mat(mid, 1u).y, 0.02, 1.0);
      alphaMode = mat(mid, 1u).z;
      alphaCutoff = mat(mid, 1u).w;
      emissive = max(mat(mid, 2u).rgb, vec3(0.0));
      uint tb = mid * 12u;
      int tex = matTexIds[tb];
      if (tex >= 0) {
        vec2 tuv = materialUv(mid, 0, uv0h, uv1h);
        base *= sampleRtMaterialTexture(tex, tuv, sourceFace,
                                        rtTextureLod(tex, tuv, 0.0),
                                        vec4(1.0)).rgb;
      }
    } else {
      base = ii.tint.rgb;
      alpha = clamp(ii.tint.a, 0.0, 1.0);
      alphaMode = alpha < 1.0 ? 2.0 : 0.0;
    }
    if (md.vtxColorAddr != 0ul) {
      Cols cb = Cols(md.vtxColorAddr);
      vec4 vc = fetchCol(cb, i0) * w0 + fetchCol(cb, i1) * bc.x +
                fetchCol(cb, i2) * bc.y;
      base *= vc.rgb;
      alpha *= vc.a;
    }
    float materialOpacity = clamp(alpha, 0.0, 1.0);
    if (alphaMode > 0.5 && alphaMode < 1.5)
      materialOpacity = materialOpacity >= alphaCutoff ? 1.0 : 0.0;
    int rmode = int(pc.camPos.w + 0.5);
    vec3 V = normalize(pc.camPos.xyz - hit);
    vec3 lit = base * 0.12 + emissive;
    if (rmode == 0) {
      uint lightCount = uint(lightRows.length()) / RT_LIGHT_ROWS;
      for (uint li = 0u; li < lightCount; ++li) {
        vec4 l0 = light(li, 0u);
        if (l0.y <= 0.5 || int(l0.x + 0.5) == 6) continue;
        // Keep the graph-free fast material semantically aligned with the
        // full RT path: CollectionAPI light links are carried per TLAS
        // instance and must gate both direct contribution and its shadow.
        if (li < 32u && (ii.directLightMask & (1u << li)) == 0u) continue;
        vec3 L; float attenuation = 1.0;
        if (int(l0.x + 0.5) == 5) {
          L = -normalize(light(li, 2u).xyz);
        } else {
          uint lightSeed = hashU(uint(px.x) * 1973u + uint(px.y) * 9277u +
                                  fi * 26699u + li);
          vec3 q = sampleLightPosition(li, int(l0.x + 0.5), lightSeed) - hit;
          float d2 = max(dot(q, q), 1.0e-6);
          L = q * inversesqrt(d2); attenuation = 1.0 / d2;
        }
        float nl = max(dot(N, L), 0.0);
        if (nl <= 0.0) continue;
        float shadow = 1.0;
        if ((int(l0.y + 0.5) & 2) != 0u &&
            (li >= 32u || (ii.shadowLightMask & (1u << li)) != 0u)) {
          for (uint ti = 0u; ti < tlasChunkCount() && shadow > 0.5; ++ti) {
            rayQueryEXT sq;
            rayQueryInitializeEXT(sq, TLAS[ti],
                                  gl_RayFlagsTerminateOnFirstHitEXT, 0xFF,
                                  hit + N * 1.0e-3, 1.0e-3, L, 1.0e30);
            while (rayQueryProceedEXT(sq)) {
              if (rayQueryGetIntersectionTypeEXT(sq, false) ==
                  gl_RayQueryCandidateIntersectionTriangleEXT) {
                uint si = globalInstanceId(ti,
                    rayQueryGetIntersectionInstanceIdEXT(sq, false));
                int sp = rayQueryGetIntersectionPrimitiveIndexEXT(sq, false);
                vec2 sb = rayQueryGetIntersectionBarycentricsEXT(sq, false);
                bool sf = rayQueryGetIntersectionFrontFaceEXT(sq, false);
                if (li >= 32u ||
                    (insts[si].shadowLightMask & (1u << li)) != 0u) {
                  if (materialAllowsHit(si, sp, sb, sf))
                    rayQueryConfirmIntersectionEXT(sq);
                }
              }
            }
            if (rayQueryGetIntersectionTypeEXT(sq, true) ==
                gl_RayQueryCommittedIntersectionTriangleEXT) shadow = 0.0;
          }
        }
        vec3 H = normalize(V + L);
        float nh = max(dot(N, H), 0.0), nv = max(dot(N, V), 1.0e-4);
        vec3 F = fresnelSchlick(max(dot(V, H), 0.0),
                                mix(vec3(0.04), base, metallic));
        vec3 spec = ggxD(nh, roughness) * ggxG1(nv, roughness) *
                    ggxG1(nl, roughness) * F /
                    max(4.0 * nv * nl, 1.0e-5);
        lit += (base * (1.0 - metallic) * (vec3(1.0) - F) /
                3.14159265 + spec) * l0.z * l0.w * attenuation * nl * shadow;
      }
      outc = mix(bgc, lit, materialOpacity);
    } else if (rmode == 2) outc = N * 0.5 + 0.5;
    else if (rmode == 3) outc = idColor(mid);
    else if (rmode == 5) outc = vec3(fract(uv0h), 0.0);
    else if (rmode == 7) outc = base;
    else if (rmode == 9) outc = vec3(roughness);
    else if (rmode == 10) outc = vec3(metallic);
    else if (rmode == 11) outc = emissive;
    else if (rmode == 12) outc = vec3(materialOpacity);
    else if (rmode == 13) outc = clamp((hit - pc.sceneMin.xyz) /
                                        pc.sceneExtent.xyz, 0.0, 1.0);
    else if (rmode == 14) outc = vec3(w0, bc.x, bc.y);
    else if (rmode == 15) outc = idColor(uint(prim));
    else if (rmode == 16) outc = idColor(ii.meshId);
    else if (rmode == 26) outc = idColor(iid);
    else if (rmode == 18) outc = vec3(0.5);
    else if (rmode == 19) outc = ((md.geometricNormal & 1u) != 0u)
                                      ? vec3(0.95, 0.1, 0.85) : vec3(0.2);
    else if (rmode == 34) outc = md.faceAddr != 0ul
                                      ? idColor(Faces(md.faceAddr).fc[uint(prim)])
                                      : vec3(0.45);
    }
 #else
    // Primary-ray differential footprint on the hit plane, converted from
    // world units to UV units by the triangle's area ratio. This remains valid
    // for perspective and orthographic authored cameras.
    vec2 ndcDx = ndc + vec2(2.0 / float(size.x), 0.0);
    vec2 ndcDy = ndc + vec2(0.0, -2.0 / float(size.y));
    vec4 nxh = pc.invViewProj * vec4(ndcDx, 0.0, 1.0);
    vec4 fxh = pc.invViewProj * vec4(ndcDx, 1.0, 1.0);
    vec4 nyh = pc.invViewProj * vec4(ndcDy, 0.0, 1.0);
    vec4 fyh = pc.invViewProj * vec4(ndcDy, 1.0, 1.0);
    vec3 ox = nxh.xyz / nxh.w, oy = nyh.xyz / nyh.w;
    vec3 dx = normalize(fxh.xyz / fxh.w - ox);
    vec3 dy = normalize(fyh.xyz / fyh.w - oy);
    float denX = dot(dx, N), denY = dot(dy, N);
    denX = abs(denX) < 1e-6 ? (denX < 0.0 ? -1e-6 : 1e-6) : denX;
    denY = abs(denY) < 1e-6 ? (denY < 0.0 ? -1e-6 : 1e-6) : denY;
    float tx = dot(hit - ox, N) / denX;
    float ty = dot(hit - oy, N) / denY;
    vec3 hx = ox + dx * tx, hy = oy + dy * ty;
    float worldFootprint = max(length(hx - hit), length(hy - hit));
    vec2 tuv0 = fetchUV(vb, i0), tuv1 = fetchUV(vb, i1), tuv2 = fetchUV(vb, i2);
    float worldArea2 = length(cross(wp1 - wp0, wp2 - wp0));
    vec2 tue1 = tuv1 - tuv0, tue2 = tuv2 - tuv0;
    float uvArea2 = abs(tue1.x * tue2.y - tue1.y * tue2.x);
    float uvFootprint = worldFootprint *
                        sqrt(uvArea2 / max(worldArea2, 1e-12));

    // Base color: material (non-instanced) or per-instance tint (instanced), times
    // the interpolated per-vertex displayColor when present.
    vec3 base;
    float alpha = 1.0;
    float metallic = 0.0;
    float roughness = 0.5;
    float alphaMode = 0.0;
    float alphaCutoff = 0.5;
    vec3 emissive = vec3(0.0);
    float specWeight = 1.0;
    float specIor = 1.5;
    float specAnisotropy = 0.0;
    float specRotation = 0.0;
    float occlusion = 1.0;
    float coatWeight = 0.0;
    float coatRoughness = 0.1;
    vec3 coatColor = vec3(1.0);
    float sheenWeight = 0.0;
    vec3 sheenColor = vec3(1.0);
    float sheenRoughness = 0.3;
    float thinFilmWeight = 0.0;
    float thinFilmThickness = 0.0;
    float thinFilmIor = 1.5;
    // OpenPBR transmission/subsurface: read here (lrtRows rows 2/4, already
    // packed by PackRealtimePbrMaterial, src/tydra/openpbr-params.hh).  The
    // values feed both the direct lobes and the bounded refraction/volume
    // approximation below, so keep them in the same lrt()-sourced state block.
    float transmission = 0.0;
    vec3 transmissionColor = vec3(1.0);
    float transmissionDispersion = 0.0;
    float transmissionDispersionAbbe = 0.0;
    float transmissionDispersionScale = 0.0;
    float subsurface = 0.0;
    vec3 subsurfaceColor = vec3(1.0);
    vec3 subsurfaceRadius = vec3(1.0);
    float subsurfaceScale = 1.0;
    float subsurfaceAnisotropy = 0.0;
    float subsurfaceScatterAnisotropy = 0.0;
    float coatAnisotropy = 0.0;
    float coatRotation = 0.0;
    float coatRoughnessAnisotropy = 0.0;
    float volumeDensity = 0.0;
    vec3 volumeAlbedo = vec3(1.0);
    vec3 volumeEmission = vec3(0.0);
    float volumeEmissionScale = 0.0;
    float coatAffectColor = 0.0;
    float coatAffectRoughness = 0.0;
    float coatDarkening = 0.0;
    if (ii.useMaterial != 0u) {
      if (mid != 0xffffffffu) {
        base = mat(mid, 0u).rgb;
        alpha = mat(mid, 0u).a;
        metallic = mat(mid, 1u).x;
        roughness = mat(mid, 1u).y;
        alphaMode = mat(mid, 1u).z;
        alphaCutoff = mat(mid, 1u).w;
        emissive = mat(mid, 2u).rgb;
        if (lrt(mid, 12u).w > 0.5) {
          metallic = lrt(mid, 10u).x;
          roughness = lrt(mid, 10u).z;
          alpha = lrt(mid, 9u).w;
          emissive = lrt(mid, 8u).rgb * lrt(mid, 8u).w;
          specWeight = lrt(mid, 1u).w;
          specIor = lrt(mid, 10u).w;
          coatWeight = lrt(mid, 6u).w;
          coatColor = lrt(mid, 6u).rgb;
          coatRoughness = lrt(mid, 11u).x;
          sheenWeight = lrt(mid, 7u).w;
          sheenColor = lrt(mid, 7u).rgb;
          sheenRoughness = lrt(mid, 11u).z;
          thinFilmWeight = lrt(mid, 12u).x;
          thinFilmThickness = lrt(mid, 12u).y;
          thinFilmIor = lrt(mid, 12u).z;
          specAnisotropy = clamp(lrt(mid, 14u).y +
                                 0.5 * lrt(mid, 14u).w, -1.0, 1.0);
          specRotation = lrt(mid, 14u).z;
          roughness = clamp(roughness *
                            (1.0 - 0.25 * abs(specAnisotropy) +
                             0.05 * cos(radians(specRotation))),
                            0.02, 1.0);
          transmission = lrt(mid, 2u).w;
          transmissionColor = lrt(mid, 2u).rgb;
          transmissionDispersion = lrt(mid, 15u).x;
          transmissionDispersionAbbe = lrt(mid, 15u).y;
          transmissionDispersionScale = lrt(mid, 15u).z;
          subsurfaceAnisotropy = lrt(mid, 15u).w;
          subsurfaceScatterAnisotropy = lrt(mid, 16u).x;
          coatAnisotropy = lrt(mid, 16u).y;
          coatRotation = lrt(mid, 16u).z;
          subsurface = lrt(mid, 4u).w;
          subsurfaceColor = lrt(mid, 4u).rgb;
          subsurfaceRadius = max(lrt(mid, 5u).rgb, vec3(0.0));
          subsurfaceScale = max(lrt(mid, 5u).w, 0.0);
          coatAffectColor = lrt(mid, 16u).w;
          coatAffectRoughness = lrt(mid, 17u).x;
          coatRoughnessAnisotropy = lrt(mid, 17u).y;
          coatDarkening = lrt(mid, 17u).w;
          volumeAlbedo = lrt(mid, 18u).rgb;
          volumeDensity = lrt(mid, 18u).w;
          volumeEmission = lrt(mid, 19u).rgb;
          volumeEmissionScale = lrt(mid, 19u).w;
          // Cheap subsurface approximation (no real BSSRDF transport in this
          // codebase to build on): tint the diffuse albedo toward
          // subsurfaceColor, weighted by `subsurface` and zeroed out on
          // already-transmissive/metallic surfaces -- ported from
          // src/external/lightrt/mtlxrender/bsdf.c's diffuse-lobe tint
          // (the only subsurface handling that exists anywhere in this
          // repo). Albedo-only: the existing cosine-weighted diffuse
          // sampling PDF is unaffected, so this needs no importance-
          // sampling changes.
          //
          // Verified numerically (not just compiled) via the identical
          // formula in raytrace_swbvh.comp -- this GPU has no hardware RT,
          // so that's the only technique this file's own rayQueryEXT branch
          // can be runtime-exercised through -- against
          // tests/usda/tusdview-unsupported-realtime-lobes.usda
          // (base_color=(0.3,0.5,0.7), subsurface_weight=0.3,
          // transmission_weight=0.2, subsurface_color unauthored -> default
          // (0.8,0.8,0.8)): predicted tinted albedo (0.402,0.542,0.682),
          // rendered center-pixel channel ratio matched to within 2% (exact
          // on G:B). An earlier attempt against
          // models/openpbr-subsurface-sphere.usda showed no visible tint --
          // not a bug in this formula, but that asset's base_color AND
          // subsurface_color are both texture-connected, and neither shader
          // samples textures for these two inputs yet, so both collapsed to
          // RealtimePbrMaterial's identical default (0.8,0.8,0.8) and the
          // mix was a no-op on that specific asset.
          base = mix(base,
                     subsurfaceColor * (1.0 - metallic) * (1.0 - transmission),
                     clamp(subsurface * (1.0 + 0.25 * abs(subsurfaceAnisotropy) +
                                         0.25 * abs(subsurfaceScatterAnisotropy)),
                           0.0, 1.0));
        }
      } else {
        base = vec3(0.6);
      }
    } else {
      base = ii.tint.rgb;  // per-instance color or the prototype's flatColor
      alpha = clamp(ii.tint.a, 0.0, 1.0);
      alphaMode = (alpha < 1.0) ? 2.0 : 0.0;  // approximate Blend like material RT
    }
    if (md.vtxColorAddr != 0ul) {
      Cols cb = Cols(md.vtxColorAddr);
      vec4 vc = fetchCol(cb, i0) * w0 + fetchCol(cb, i1) * bc.x +
                fetchCol(cb, i2) * bc.y;
      base *= vc.rgb;
      alpha *= vc.a;
    }
    uint sourceFace = md.faceAddr != 0ul
                          ? Faces(md.faceAddr).fc[uint(prim)]
                          : uint(max(prim, 0));
    if (ii.useMaterial != 0u && mid != 0xffffffffu) {
      uint tb = mid * 12u;
      uint pb = mid * 155u;
      vec2 baseUv = materialUv(mid, 0, uv0h, uv1h);
        int baseTexId = matTexIds[tb + 0u];
        float baseLod = rtTextureLod(baseTexId, baseUv,
                                     materialUvFootprint(mid, 0, uvFootprint));
        vec4 bt = (baseTexId >= 0 &&
                   texDescs[baseTexId].isPtex != 0)
                      ? sampleRtPtexTextureLod(baseTexId, baseUv, sourceFace,
                                               baseLod, vec4(1.0))
                      : sampleRtTextureLod(baseTexId, baseUv, baseLod,
                                           vec4(1.0));
      bt = bt * vec4(matTexParams[pb + 36u], matTexParams[pb + 37u],
                     matTexParams[pb + 38u], matTexParams[pb + 39u]) +
           vec4(matTexParams[pb + 40u], matTexParams[pb + 41u],
                matTexParams[pb + 42u], matTexParams[pb + 43u]);
      base *= bt.rgb;
      alpha *= bt.a * ii.tint.a;

      vec2 metallicUv = materialUv(mid, 1, uv0h, uv1h);
      vec2 roughnessUv = materialUv(mid, 2, uv0h, uv1h);
      vec4 mt = sampleRtMaterialTexture(matTexIds[tb + 1u], metallicUv, sourceFace,
          rtTextureLod(matTexIds[tb + 1u], metallicUv,
                       materialUvFootprint(mid, 1, uvFootprint)), vec4(1.0));
      vec4 rt = sampleRtMaterialTexture(matTexIds[tb + 2u], roughnessUv, sourceFace,
          rtTextureLod(matTexIds[tb + 2u], roughnessUv,
                       materialUvFootprint(mid, 2, uvFootprint)), vec4(1.0));
      metallic = clamp(metallic *
                           (texChannel(mt, int(matTexParams[pb + 60u] + 0.5)) *
                                matTexParams[pb + 61u] +
                            matTexParams[pb + 62u]),
                       0.0, 1.0);
      roughness = clamp(roughness *
                            (texChannel(rt, int(matTexParams[pb + 63u] + 0.5)) *
                                 matTexParams[pb + 64u] +
                             matTexParams[pb + 65u]),
                        0.0, 1.0);

      int opacityTex = matTexIds[tb + 5u];
      if (opacityTex >= 0) {
        vec2 opacityUv = materialUv(mid, 5, uv0h, uv1h);
        vec4 ot = sampleRtMaterialTexture(opacityTex, opacityUv, sourceFace,
            rtTextureLod(opacityTex, opacityUv,
                         materialUvFootprint(mid, 5, uvFootprint)), vec4(1.0));
        alpha *= texChannel(ot, int(matTexParams[pb + 66u] + 0.5)) *
                     matTexParams[pb + 67u] +
                 matTexParams[pb + 68u];
      }

      int emissiveTex = matTexIds[tb + 4u];
      if (emissiveTex >= 0) {
        vec2 emissiveUv = materialUv(mid, 4, uv0h, uv1h);
        vec4 et = sampleRtMaterialTexture(emissiveTex, emissiveUv, sourceFace,
            rtTextureLod(emissiveTex, emissiveUv,
                         materialUvFootprint(mid, 4, uvFootprint)), vec4(1.0));
        et = et * vec4(matTexParams[pb + 52u], matTexParams[pb + 53u],
                       matTexParams[pb + 54u], matTexParams[pb + 55u]) +
             vec4(matTexParams[pb + 56u], matTexParams[pb + 57u],
                  matTexParams[pb + 58u], matTexParams[pb + 59u]);
        emissive *= et.rgb;
      }

      int normalTex = matTexIds[tb + 3u];
      if (normalTex >= 0) {
        vec2 normalUv = materialUv(mid, 3, uv0h, uv1h);
        vec4 nt = sampleRtMaterialTexture(normalTex, normalUv, sourceFace,
            rtTextureLod(normalTex, normalUv,
                         materialUvFootprint(mid, 3, uvFootprint)),
            vec4(0.5, 0.5, 1.0, 1.0));
        nt = nt * vec4(matTexParams[pb + 44u], matTexParams[pb + 45u],
                       matTexParams[pb + 46u], matTexParams[pb + 47u]) +
             vec4(matTexParams[pb + 48u], matTexParams[pb + 49u],
                  matTexParams[pb + 50u], matTexParams[pb + 51u]);
        vec3 wp0 = o2w * vec4(fetchPos(vb, i0), 1.0);
        vec3 wp1 = o2w * vec4(fetchPos(vb, i1), 1.0);
        vec3 wp2 = o2w * vec4(fetchPos(vb, i2), 1.0);
        vec2 nt0 = materialUv(mid, 3, fetchUV(vb, i0),
                              md.uv1Addr != 0ul ? fetchUV1(UV1s(md.uv1Addr), i0)
                                                : fetchUV(vb, i0));
        vec2 nt1 = materialUv(mid, 3, fetchUV(vb, i1),
                              md.uv1Addr != 0ul ? fetchUV1(UV1s(md.uv1Addr), i1)
                                                : fetchUV(vb, i1));
        vec2 nt2 = materialUv(mid, 3, fetchUV(vb, i2),
                              md.uv1Addr != 0ul ? fetchUV1(UV1s(md.uv1Addr), i2)
                                                : fetchUV(vb, i2));
        vec3 e1 = wp1 - wp0, e2 = wp2 - wp0;
        vec2 d1 = nt1 - nt0, d2 = nt2 - nt0;
        float det = d1.x * d2.y - d1.y * d2.x;
        vec3 T = abs(det) > 1e-12
                     ? normalize((e1 * d2.y - e2 * d1.y) / det)
                     : normalize(cross(abs(N.z) < 0.999 ? vec3(0, 0, 1)
                                                        : vec3(0, 1, 0), N));
        vec3 B = normalize(cross(N, T));
        N = normalize(T * nt.x + B * nt.y + N * nt.z);
      }
      int coatNormalTex = matTexIds[tb + 11u];
      if (coatNormalTex >= 0) {
        vec2 src = matTexParams[pb + 146u] > 0.5 ? uv1h : uv0h;
        vec2 cuv = vec2(
            matTexParams[pb + 140u] * src.x + matTexParams[pb + 141u] * src.y +
                matTexParams[pb + 142u],
            matTexParams[pb + 143u] * src.x + matTexParams[pb + 144u] * src.y +
                matTexParams[pb + 145u]);
        vec4 nt = sampleRtMaterialTexture(coatNormalTex, cuv, sourceFace,
            rtTextureLod(coatNormalTex, cuv, uvFootprint),
            vec4(0.5, 0.5, 1.0, 1.0));
        nt = nt * vec4(matTexParams[pb + 147u], matTexParams[pb + 148u],
                       matTexParams[pb + 149u], matTexParams[pb + 150u]) +
             vec4(matTexParams[pb + 151u], matTexParams[pb + 152u],
                  matTexParams[pb + 153u], matTexParams[pb + 154u]);
        vec3 e1 = wp1 - wp0, e2 = wp2 - wp0;
        vec2 t0 = matTexParams[pb + 146u] > 0.5 && md.uv1Addr != 0ul
                      ? fetchUV1(UV1s(md.uv1Addr), i0) : fetchUV(vb, i0);
        vec2 t1 = matTexParams[pb + 146u] > 0.5 && md.uv1Addr != 0ul
                      ? fetchUV1(UV1s(md.uv1Addr), i1) : fetchUV(vb, i1);
        vec2 t2 = matTexParams[pb + 146u] > 0.5 && md.uv1Addr != 0ul
                      ? fetchUV1(UV1s(md.uv1Addr), i2) : fetchUV(vb, i2);
        vec2 d1 = t1 - t0, d2 = t2 - t0;
        float det = d1.x * d2.y - d1.y * d2.x;
        vec3 T = abs(det) > 1e-12
            ? normalize((e1 * d2.y - e2 * d1.y) / det)
            : normalize(cross(abs(N.z) < 0.999 ? vec3(0,0,1) : vec3(0,1,0), N));
        vec3 B = normalize(cross(N, T));
        coatN = normalize(T * nt.x + B * nt.y + N * nt.z);
      }

      // Occlusion / coat texture slots (matTexIds 6..9, UV rows in slots
      // 12..15). Unbound slots sample white and the loaders neutralize the
      // matching constant to 1, so constant*texel is always correct.
      int occlusionTex = matTexIds[tb + 6u];
      if (occlusionTex >= 0) {
        vec2 aoUv = materialUv(mid, 12, uv0h, uv1h);
        vec4 at = sampleRtMaterialTexture(occlusionTex, aoUv, sourceFace,
            rtTextureLod(occlusionTex, aoUv,
                         materialUvFootprint(mid, 12, uvFootprint)), vec4(1.0));
        occlusion = clamp(texChannel(at, int(matTexParams[pb + 96u] + 0.5)) *
                              matTexParams[pb + 70u] + matTexParams[pb + 71u],
                          0.0, 1.0);
      }
      int coatWeightTex = matTexIds[tb + 7u];
      if (coatWeightTex >= 0) {
        vec2 cwUv = materialUv(mid, 13, uv0h, uv1h);
        vec4 ct = sampleRtMaterialTexture(coatWeightTex, cwUv, sourceFace,
            rtTextureLod(coatWeightTex, cwUv,
                         materialUvFootprint(mid, 13, uvFootprint)), vec4(1.0));
        int ch = int(matTexParams[pb + 97u] + 0.5);
        coatWeight = clamp(coatWeight *
                           (texChannel(ct, ch) * matTexParams[pb + 100u + uint(ch)] +
                            matTexParams[pb + 104u + uint(ch)]),
                           0.0, 1.0);
      }
      int coatColorTex = matTexIds[tb + 8u];
      if (coatColorTex >= 0) {
        vec2 ccUv = materialUv(mid, 14, uv0h, uv1h);
        vec4 ct = sampleRtMaterialTexture(coatColorTex, ccUv, sourceFace,
            rtTextureLod(coatColorTex, ccUv,
                         materialUvFootprint(mid, 14, uvFootprint)), vec4(1.0));
        coatColor *= ct.rgb * vec3(matTexParams[pb + 108u],
                                   matTexParams[pb + 109u],
                                   matTexParams[pb + 110u]) +
                     vec3(matTexParams[pb + 112u],
                          matTexParams[pb + 113u],
                          matTexParams[pb + 114u]);
      }
      int coatRoughTex = matTexIds[tb + 9u];
      if (coatRoughTex >= 0) {
        vec2 crUv = materialUv(mid, 15, uv0h, uv1h);
        vec4 ct = sampleRtMaterialTexture(coatRoughTex, crUv, sourceFace,
            rtTextureLod(coatRoughTex, crUv,
                         materialUvFootprint(mid, 15, uvFootprint)), vec4(1.0));
        int ch = int(matTexParams[pb + 98u] + 0.5);
        coatRoughness = clamp(coatRoughness *
                              (texChannel(ct, ch) * matTexParams[pb + 116u + uint(ch)] +
                               matTexParams[pb + 120u + uint(ch)]),
                              0.02, 1.0);
      }
    }
    if (ii.useMaterial != 0u && mid != 0xffffffffu) {
      uint gb = mid * 1355u;
      if (gb + 9u < uint(graphRows.length())) {
        if (graphRows[gb + 1u] >= 0.0)
          base = evalMaterialXGraph(uint(mid), 0, uv0h, uv1h, sourceFace).rgb;
        if (graphRows[gb + 2u] >= 0.0)
          metallic = clamp(evalMaterialXGraph(uint(mid), 1, uv0h, uv1h, sourceFace).x,
                            0.0, 1.0);
        if (graphRows[gb + 3u] >= 0.0)
          roughness = clamp(evalMaterialXGraph(uint(mid), 2, uv0h, uv1h, sourceFace).x,
                             0.02, 1.0);
        if (graphRows[gb + 4u] >= 0.0)
          alpha = clamp(evalMaterialXGraph(uint(mid), 3, uv0h, uv1h, sourceFace).x,
                        0.0, 1.0);
        if (graphRows[gb + 5u] >= 0.0)
          emissive = max(evalMaterialXGraph(uint(mid), 4, uv0h, uv1h, sourceFace).rgb,
                          vec3(0.0));
        if (graphRows[gb + 7u] >= 0.0)
          subsurface = clamp(evalMaterialXGraph(uint(mid), 6, uv0h, uv1h,
                                                 sourceFace).x,
                              0.0, 1.0);
        if (graphRows[gb + 8u] >= 0.0)
          subsurfaceColor = max(evalMaterialXGraph(uint(mid), 7, uv0h, uv1h,
                                                    sourceFace).rgb,
                                vec3(0.0));
        if (graphRows[gb + 9u] >= 0.0)
          subsurfaceRadius = max(evalMaterialXGraph(uint(mid), 8, uv0h, uv1h,
                                                     sourceFace).rgb,
                                  vec3(0.0));
        if (graphRows[gb + 6u] >= 0.0) {
          // MaterialX normalmap outputs are tangent-space normals encoded in
          // [0,1], just like the semantic normal-texture path above. Rebuild
          // the hit tangent frame from the triangle's authored UVs so graph
          // normal maps affect Vulkan RT shading rather than being silently
          // ignored.
          vec4 gn = evalMaterialXGraph(uint(mid), 5, uv0h, uv1h, sourceFace);
          vec3 gp0 = o2w * vec4(fetchPos(vb, i0), 1.0);
          vec3 gp1 = o2w * vec4(fetchPos(vb, i1), 1.0);
          vec3 gp2 = o2w * vec4(fetchPos(vb, i2), 1.0);
          vec2 guv0 = fetchUV(vb, i0), guv1 = fetchUV(vb, i1),
               guv2 = fetchUV(vb, i2);
          vec3 ge1 = gp1 - gp0, ge2 = gp2 - gp0;
          vec3 gN = normalize(cross(ge1, ge2));
          vec2 gd1 = guv1 - guv0, gd2 = guv2 - guv0;
          float gdet = gd1.x * gd2.y - gd1.y * gd2.x;
          vec3 gT = abs(gdet) > 1e-12
                        ? normalize((ge1 * gd2.y - ge2 * gd1.y) / gdet)
                        : normalize(cross(abs(gN.z) < 0.999 ? vec3(0, 0, 1)
                                                            : vec3(0, 1, 0), gN));
          vec3 gB = normalize(cross(gN, gT));
          N = normalize(gT * (gn.x * 2.0 - 1.0) +
                        gB * (gn.y * 2.0 - 1.0) +
                        gN * (gn.z * 2.0 - 1.0));
        }
      }
    }
    float fd = (max(specIor, 1.0) - 1.0) / (max(specIor, 1.0) + 1.0);
    vec3 materialF0 = mix(vec3(fd * fd), base, clamp(metallic, 0.0, 1.0));
    if (ii.useMaterial != 0u && mid != 0xffffffffu) {
      uint tb = mid * 12u;
      uint pb = mid * 155u;
      bool previewSpec = matTexParams[pb + 131u] > 0.5;
      bool openPbrSpec = matTexParams[pb + 139u] > 0.5;
      if (previewSpec || openPbrSpec) {
        vec3 specTint = lrt(mid, 1u).rgb;
        materialF0 = previewSpec ? specTint
            : mix(vec3(fd * fd) * specTint, base, clamp(metallic, 0.0, 1.0));
        int specTex = matTexIds[tb + 10u];
        if (specTex >= 0) {
          vec2 srcUv = matTexParams[pb + 130u] > 0.5 ? uv1h : uv0h;
          vec2 specUv = vec2(
              matTexParams[pb + 124u] * srcUv.x +
                  matTexParams[pb + 125u] * srcUv.y + matTexParams[pb + 126u],
              matTexParams[pb + 127u] * srcUv.x +
                  matTexParams[pb + 128u] * srcUv.y + matTexParams[pb + 129u]);
          vec4 st = sampleRtMaterialTexture(specTex, specUv, sourceFace,
              rtTextureLod(specTex, specUv, uvFootprint), vec4(1.0));
          vec3 sampledSpec = st.rgb * vec3(matTexParams[pb + 132u],
                                      matTexParams[pb + 133u],
                                      matTexParams[pb + 134u]) +
                        vec3(matTexParams[pb + 136u],
                             matTexParams[pb + 137u],
                             matTexParams[pb + 138u]);
          materialF0 *= sampledSpec;
        }
      }
    }
    float volumeOpacity = clamp(1.0 - exp(-max(volumeDensity, 0.0) * 0.1),
                                0.0, 1.0);
    base = mix(base, base * volumeAlbedo, volumeOpacity);
    emissive += volumeEmission * max(volumeEmissionScale, 0.0) * volumeOpacity;
    float materialOpacity = clamp(alpha, 0.0, 1.0);
    if (alphaMode > 0.5 && alphaMode < 1.5) {
      materialOpacity = (materialOpacity >= alphaCutoff) ? 1.0 : 0.0;
    }

    // Render mode (RenderMode in camPos.w). Only shaded mode needs the default
    // hard shadow below; wireframe uses a fixed diagnostic color and debug AOVs
    // overwrite outc, so those modes should avoid this
    // extra ray query on large RT scenes. AO/soft-shadow modes issue their own
    // ray queries in their AOV branches.
    int rmode = int(pc.camPos.w + 0.5);
    vec3 V = normalize(pc.camPos.xyz - hit);
    vec3 coatNs = dot(coatN, V) < 0.0 ? -coatN : coatN;
    float nv = max(dot(N, V), 1e-4);
    materialF0 = applyThinFilm(materialF0, nv, thinFilmWeight,
                               thinFilmThickness, thinFilmIor);
    float abbeScale = transmissionDispersionAbbe > 0.0
                          ? 1.0 + 20.0 / max(transmissionDispersionAbbe, 1.0)
                          : 1.0;
    float dispersion = clamp(transmissionDispersion *
                              transmissionDispersionScale * abbeScale, 0.0, 1.0);
    vec3 dispersionTint = vec3(1.0 + 0.35 * dispersion, 1.0,
                                1.0 - 0.25 * dispersion);
    base = mix(base, base * coatColor,
               clamp(coatWeight * coatAffectColor, 0.0, 1.0));
    base = mix(base, base * (1.0 - 0.2 * coatDarkening),
               clamp(coatDarkening * coatWeight, 0.0, 1.0));
    roughness = mix(roughness, mix(roughness, coatRoughness,
                                   clamp(coatAffectRoughness, 0.0, 1.0)),
                    clamp(coatWeight * coatAffectRoughness, 0.0, 1.0));
    roughness = clamp(roughness *
                      (1.0 - 0.1 * abs(coatAnisotropy) -
                       0.05 * abs(cos(radians(coatRotation)))), 0.02, 1.0);
    transmissionColor *= dispersionTint;
    vec3 direct = vec3(0.0);
    bool hadDirectLight = false;
    uint directLightCount = uint(lightRows.length()) / RT_LIGHT_ROWS;
    for (uint li = 0u; li < directLightCount; ++li) {
      int lightType = int(light(li, 0u).x + 0.5);
      if (lightType == 6) continue;  // dome is consumed as environment
      if (light(li, 0u).y <= 0.5) continue;
      hadDirectLight = true;
      int flags = int(light(li, 0u).y + 0.5);
      bool directLinked = li < 32u
          ? (ii.directLightMask & (1u << li)) != 0u
          : (flags & (1 << 5)) != 0;
      if (!directLinked) continue;
      vec3 L;
      float maxShadowT = 1e30;
      float attenuation = 1.0;
      if (lightType == 5) {
        // DrawLightCPU stores the emission direction; shading needs the vector
        // from the hit toward the infinitely distant source.
        L = -normalize(light(li, 2u).xyz);
      } else {
        uint lightSeed = hashU(uint(px.x) * 1973u + uint(px.y) * 9277u +
                               fi * 26699u + li * 104729u + 31u);
        vec3 lightPosition = sampleLightPosition(li, lightType, lightSeed);
        vec3 toLight = lightPosition - hit;
        float dist2 = max(dot(toLight, toLight), 1e-6);
        maxShadowT = sqrt(dist2);
        L = toLight / maxShadowT;
        attenuation = 1.0 / dist2;
      }
      float shape = 1.0;
      if ((flags & 4) != 0 && lightType != 5) {
        float coneCos = dot(normalize(light(li, 2u).xyz), -L);
        float angle = clamp(light(li, 6u).x, 0.0, 180.0);
        float softness = clamp(light(li, 6u).y, 0.0, 1.0);
        float outer = cos(radians(angle));
        float inner = cos(radians(angle * (1.0 - softness)));
        shape = smoothstep(outer, max(inner, outer + 1e-5), coneCos) *
                pow(max(coneCos, 0.0), max(light(li, 6u).z, 0.0));
      }
      float nl = max(dot(N, L), 0.0);
      if (nl <= 0.0 || shape <= 0.0) continue;
      float shadow = 1.0;
      if (rmode == 0 && (flags & 2) != 0) {
        // Bounded transparent shadow traversal. Each pass asks every TLAS
        // chunk for its next accepted hit and keeps the nearest one, so chunk
        // partitioning cannot change the visibility result.
        vec3 shadowOrigin = hit + N * 1e-3;
        float shadowCursor = 1e-3;
        [[dont_unroll]] for (int layer = 0; layer < 8 && shadow > 1e-3; ++layer) {
          bool found = false;
          float bestT = max(maxShadowT - 2e-3, 1e-3);
          uint bestIid = 0u;
          int bestPrim = -1;
          vec2 bestBc = vec2(0.0);
          bool bestFront = true;
          for (uint ti = 0u; ti < tlasChunkCount(); ++ti) {
            rayQueryEXT sq;
            rayQueryInitializeEXT(sq, TLAS[ti],
                                  gl_RayFlagsTerminateOnFirstHitEXT, 0xFF,
                                  shadowOrigin, shadowCursor, L, bestT);
            while (rayQueryProceedEXT(sq)) {
              if (rayQueryGetIntersectionTypeEXT(sq, false) ==
                  gl_RayQueryCandidateIntersectionTriangleEXT) {
                uint ci = globalInstanceId(
                    ti, rayQueryGetIntersectionInstanceIdEXT(sq, false));
                int cp = rayQueryGetIntersectionPrimitiveIndexEXT(sq, false);
                vec2 cb = rayQueryGetIntersectionBarycentricsEXT(sq, false);
                bool cf = rayQueryGetIntersectionFrontFaceEXT(sq, false);
                bool linked = li < 32u
                    ? (insts[ci].shadowLightMask & (1u << li)) != 0u
                    : (flags & (1 << 6)) != 0;
                if (linked && materialAllowsHit(ci, cp, cb, cf))
                  rayQueryConfirmIntersectionEXT(sq);
              }
            }
            if (rayQueryGetIntersectionTypeEXT(sq, true) ==
                gl_RayQueryCommittedIntersectionTriangleEXT) {
              float candidateT = rayQueryGetIntersectionTEXT(sq, true);
              if (candidateT < bestT) {
                found = true;
                bestT = candidateT;
                bestIid = globalInstanceId(
                    ti, rayQueryGetIntersectionInstanceIdEXT(sq, true));
                bestPrim = rayQueryGetIntersectionPrimitiveIndexEXT(sq, true);
                bestBc = rayQueryGetIntersectionBarycentricsEXT(sq, true);
                bestFront = rayQueryGetIntersectionFrontFaceEXT(sq, true);
              }
            }
          }
          if (!found) break;
          float hitMode = 0.0;
          float hitAlpha = materialOpacityAtHit(
              bestIid, bestPrim, bestBc, bestFront, hitMode);
          if (hitMode > 1.5 && hitAlpha < 1.0) {
            shadow *= 1.0 - hitAlpha;
            shadowCursor = bestT + 1e-3;
          } else {
            shadow = 0.0;
          }
        }
        // Conservative tail policy: a ninth accepted blocker is treated as
        // opaque rather than allowing an unbounded ray-query loop.
        if (shadow > 1e-3) {
          bool tailHit = false;
          for (uint ti = 0u; ti < tlasChunkCount() && !tailHit; ++ti) {
            rayQueryEXT tq;
            rayQueryInitializeEXT(tq, TLAS[ti],
                                  gl_RayFlagsTerminateOnFirstHitEXT, 0xFF,
                                  shadowOrigin, shadowCursor, L,
                                  max(maxShadowT - 2e-3, 1e-3));
            while (rayQueryProceedEXT(tq)) {
              if (rayQueryGetIntersectionTypeEXT(tq, false) ==
                  gl_RayQueryCandidateIntersectionTriangleEXT) {
                uint ci = globalInstanceId(
                    ti, rayQueryGetIntersectionInstanceIdEXT(tq, false));
                int cp = rayQueryGetIntersectionPrimitiveIndexEXT(tq, false);
                vec2 cb = rayQueryGetIntersectionBarycentricsEXT(tq, false);
                bool cf = rayQueryGetIntersectionFrontFaceEXT(tq, false);
                bool linked = li < 32u
                    ? (insts[ci].shadowLightMask & (1u << li)) != 0u
                    : (flags & (1 << 6)) != 0;
                if (linked && materialAllowsHit(ci, cp, cb, cf))
                  rayQueryConfirmIntersectionEXT(tq);
              }
            }
            tailHit = rayQueryGetIntersectionTypeEXT(tq, true) !=
                      gl_RayQueryCommittedIntersectionNoneEXT;
          }
          if (tailHit) shadow = 0.0;
        }
      }
      vec3 H = normalize(L + V);
      vec3 tangent = normalize(abs(N.y) < 0.9 ? cross(N, vec3(0.0, 1.0, 0.0))
                                              : cross(N, vec3(1.0, 0.0, 0.0)));
      vec3 bitangent = normalize(cross(N, tangent));
      float rot = radians(specRotation);
      vec3 rotatedT = tangent * cos(rot) + bitangent * sin(rot);
      vec3 rotatedB = -tangent * sin(rot) + bitangent * cos(rot);
      float hT = dot(H, rotatedT), hB = dot(H, rotatedB);
      float nh = max(dot(N, H), 0.0);
      float vh = max(dot(V, H), 0.0);
      vec3 f0 = materialF0;
      vec3 F = fresnelSchlick(vh, f0);
      float vT = dot(V, rotatedT), vB = dot(V, rotatedB);
      float lT = dot(L, rotatedT), lB = dot(L, rotatedB);
      vec3 specularBrdf = ggxDAniso(nh, hT, hB, roughness, specAnisotropy) *
                          ggxG1Aniso(nv, vT, vB, roughness, specAnisotropy) *
                          ggxG1Aniso(nl, lT, lB, roughness, specAnisotropy) * F /
                          max(4.0 * nv * nl, 1e-5) * max(specWeight, 0.0);
      vec3 diffuseBrdf = (vec3(1.0) - F) * (1.0 - metallic) * base *
                         (1.0 / 3.14159265);
      vec3 sheenBrdf = sheenColor * clamp(sheenWeight, 0.0, 1.0) *
                       (0.5 + 0.5 * clamp(sheenRoughness, 0.0, 1.0)) *
                       pow(1.0 - nl, 5.0) / 3.14159265;
      float coatNoL = max(dot(coatNs, L), 0.0);
      float coatNoV = max(dot(coatNs, V), 1e-4);
      float coatNoH = max(dot(coatNs, H), 0.0);
      float coatF0 = 0.04;
      vec3 coatF = fresnelSchlick(vh, vec3(coatF0));
      float coatRgh = clamp(coatRoughness *
                            (1.0 + 0.25 * coatRoughnessAnisotropy), 0.02, 1.0);
      vec3 coatBrdf = ggxD(coatNoH, coatRgh) *
                      ggxG1(coatNoV, coatRgh) *
                      ggxG1(coatNoL, coatRgh) * coatF /
                      max(4.0 * coatNoV * coatNoL, 1e-5) * coatColor *
                      clamp(coatWeight, 0.0, 1.0);
      float ies = rtIesFactor(li, normalize(-L));
      vec3 lightColor = light(li, 3u).rgb;
      if (lightType == 8) {
        vec3 portalRadiance = rtDomeRadiance(L);
        if (dot(portalRadiance, portalRadiance) > 1e-8)
          lightColor = portalRadiance;
      }
      vec3 radiance = lightColor * (attenuation * shape * ies);
      vec3 transmissionBrdf = transmissionColor * clamp(transmission, 0.0, 1.0) *
                              (vec3(1.0) - F) * (1.0 / 3.14159265);
      // Bounded diffusion-style lobe: wrap/backscatter around the normal
      // provides a stable approximation of finite-radius subsurface transport
      // without spawning additional rays for every direct-light sample.
      float radiusGain = clamp(sqrt(max(dot(subsurfaceRadius,
                                             vec3(0.2126, 0.7152, 0.0722)) *
                                         subsurfaceScale, 0.0)) * 8.0,
                                0.0, 1.0);
      float diffusionShape = mix(0.25 + 0.75 * pow(1.0 - nl, 2.0),
                                 0.25 + 0.75 * (1.0 - nl), radiusGain);
      vec3 subsurfaceBrdf = subsurfaceColor * clamp(subsurface, 0.0, 1.0) *
                            diffusionShape / 3.14159265;
      vec3 baseBrdf = (diffuseBrdf + sheenBrdf + transmissionBrdf +
                       subsurfaceBrdf) * light(li, 7u).y +
                      specularBrdf * light(li, 7u).z;
      // Reserve energy for the separate clearcoat lobe instead of stacking a
      // full base response and coat response on top of one another.
      baseBrdf *= 1.0 - 0.5 * clamp(coatWeight, 0.0, 1.0);
      vec3 coatOnlyBrdf = coatBrdf * light(li, 7u).z;
      direct += (baseBrdf * nl + coatOnlyBrdf * coatNoL) * radiance * shadow;
    }
    if (!hadDirectLight) {
      vec3 L = normalize(pc.lightDir.xyz);
      float nl = max(dot(N, L), 0.0);
      vec3 H = normalize(L + V);
      float nh = max(dot(N, H), 0.0), vh = max(dot(V, H), 0.0);
      vec3 F = fresnelSchlick(vh, materialF0);
      vec3 specularBrdf = ggxD(nh, roughness) * ggxG1(nv, roughness) *
                          ggxG1(nl, roughness) * F /
                          max(4.0 * nv * nl, 1e-5) * max(specWeight, 0.0);
      vec3 diffuseBrdf = (vec3(1.0) - F) * (1.0 - metallic) * base *
                         (1.0 / 3.14159265);
      vec3 sheenBrdf = sheenColor * clamp(sheenWeight, 0.0, 1.0) *
                       (0.5 + 0.5 * clamp(sheenRoughness, 0.0, 1.0)) *
                       pow(1.0 - nl, 5.0) / 3.14159265;
      vec3 transmissionBrdf = transmissionColor * clamp(transmission, 0.0, 1.0) *
                              (vec3(1.0) - F) * (1.0 / 3.14159265);
      float radiusGain = clamp(sqrt(max(dot(subsurfaceRadius,
                                             vec3(0.2126, 0.7152, 0.0722)) *
                                         subsurfaceScale, 0.0)) * 8.0,
                                0.0, 1.0);
      float diffusionShape = mix(0.25 + 0.75 * pow(1.0 - nl, 2.0),
                                 0.25 + 0.75 * (1.0 - nl), radiusGain);
      vec3 subsurfaceBrdf = subsurfaceColor * clamp(subsurface, 0.0, 1.0) *
                            diffusionShape / 3.14159265;
      direct = (diffuseBrdf + sheenBrdf + transmissionBrdf +
                subsurfaceBrdf + specularBrdf) * nl;
    }
    // Ambient: dome split-sum IBL when baked (matches the raster IBL: SH
    // irradiance diffuse + GGX-prefiltered specular), else the constant floor.
    vec3 ambient = vec3(0.25);
    vec3 specIBL = vec3(0.0);
    {
      uint numL2 = uint(lightRows.length()) / RT_LIGHT_ROWS;
      for (uint li = 0u; li < numL2; ++li) {
        vec4 l0 = light(li, 0u);
        if (int(l0.x + 0.5) != 6) continue;         // DomeLight
        if ((int(l0.y + 0.5) & 128) == 0) continue; // baked IBL present
        vec3 envColor = light(li, 4u).xyz;
        vec3 Ne = normalize(vec3(dot(light(li, 10u).xyz, N),
                                 dot(light(li, 11u).xyz, N),
                                 dot(light(li, 12u).xyz, N)));
        ambient = shIrradiance(li, Ne) * envColor;
        // Specular: prefiltered env along the (env-rotated) reflection vector,
        // weighted by the split-sum DFG term. F0 = mix(0.04, base, metallic).
        vec3 Rw = reflect(-V, N);
        vec3 Re = normalize(vec3(dot(light(li, 10u).xyz, Rw),
                                 dot(light(li, 11u).xyz, Rw),
                                 dot(light(li, 12u).xyz, Rw)));
        float rgh = clamp(roughness, 0.0, 1.0);
        float maxLod = float(textureQueryLevels(uPrefilteredCube) - 1);
        vec3 pref = textureLod(uPrefilteredCube, Re, rgh * maxLod).rgb;
        vec2 dfg = texture(uBrdfLut, vec2(max(dot(N, V), 0.0), rgh)).rg;
        vec3 F0 = materialF0;
        specIBL = pref * (F0 * dfg.x + dfg.y) * envColor * max(specWeight, 0.0);
        ambient += transmissionColor * clamp(transmission, 0.0, 1.0) *
                   envColor * 0.25;
        if (coatWeight > 0.0) {
          float cr = clamp(coatRoughness, 0.0, 1.0);
          vec3 coatPref = textureLod(uPrefilteredCube, Re, cr * maxLod).rgb;
          vec2 coatDfg = texture(uBrdfLut, vec2(max(dot(N, V), 0.0), cr)).rg;
          specIBL += coatPref * (vec3(0.04) * coatDfg.x + coatDfg.y) *
                     coatColor * clamp(coatWeight, 0.0, 1.0) * envColor;
        }
        break;
      }
    }
    // Occlusion modulates indirect/ambient only, never direct (matches raster).
    ambient += sheenColor * clamp(sheenWeight, 0.0, 1.0) * 0.025;
    outc = base * ambient * occlusion + specIBL * occlusion + direct + emissive;

    // Render mode (RenderMode in camPos.w): 1=wireframe (edges only), 2=shading
    // normal, 3=material-id, 4=geometric normal, 5=uv set 0, 6=depth (t /
    // depthScale in lightDir.w).
    if (rmode == 0) {
      if (alphaMode > 0.5 && alphaMode < 1.5 && materialOpacity <= 0.0) {
        outc = bgc;
      } else if (alphaMode > 1.5 && materialOpacity < 1.0) {
        vec3 layerColor[8];
        float layerAlpha[8];
        vec3 layerTint[8];
        int layerCount = 1;
        layerColor[0] = outc;
        float topMode = 0.0;
        layerAlpha[0] = materialOpacityAtHit(primaryIid, primaryPrim,
                                             primaryBc, primaryFront,
                                             topMode);
        layerTint[0] = primaryLayerTransmissionTint(primaryIid, primaryPrim,
                                                     primaryBc, primaryFront);
        float topTransmission = primaryLayerTransmissionWeight(
            primaryIid, primaryPrim, primaryFront, primaryBc);
        vec3 refractedOrigin, refractedDir;
        vec3 topRefract = primaryLayerRefractedColor(
            primaryIid, primaryPrim, primaryBc, primaryFront, primaryO2w,
            origin, dir, refractedOrigin, refractedDir);
        vec3 walkOrigin = origin;
        vec3 walkDir = dir;
        float cursor = primaryT + 1e-3;
        if (topTransmission > 0.0) {
          walkOrigin = refractedOrigin;
          walkDir = refractedDir;
          cursor = 1e-3;
        }
        bool opaqueTail = false;
        vec3 tailColor = bgc;
        [[dont_unroll]] for (int pass = 1; pass < 8; ++pass) {
          uint liid; int lprim; vec2 lbc; bool lfront; mat4x3 lo2w; float lt;
          if (!traceAcceptedPrimary(walkOrigin, walkDir, cursor, 1e30,
                                    liid, lprim, lbc, lfront, lo2w, lt))
            break;
          walkOrigin += walkDir * (lt + 1e-3);
          cursor = 1e-3;
          float lm = 0.0;
          float la = materialOpacityAtHit(liid, lprim, lbc, lfront, lm);
          layerColor[layerCount] = approximatePrimaryLayerColor(
              liid, lprim, lbc, lfront, lo2w);
          layerAlpha[layerCount] = la;
          layerTint[layerCount] = primaryLayerTransmissionTint(
              liid, lprim, lbc, lfront);
          // A transparent intermediate interface can bend the remaining
          // underlayer walk just like the top interface.  Carry its refracted
          // origin/direction forward instead of repeatedly tracing the next
          // layer along the previous ray.  The helper is bounded to three
          // interfaces and also handles total internal reflection.
          if (primaryLayerTransmissionWeight(liid, lprim, lfront, lbc) > 0.0) {
            vec3 nextOrigin, nextDir;
            primaryLayerRefractedColor(liid, lprim, lbc, lfront, lo2w,
                                       walkOrigin, walkDir,
                                       nextOrigin, nextDir);
            walkOrigin = nextOrigin;
            walkDir = nextDir;
            cursor = 1.0e-3;
          }
          ++layerCount;
          if (lm <= 0.5 || (lm > 1.5 && la >= 1.0)) break;
        }
        if (layerCount == 8) {
          uint tiid; int tprim; vec2 tbc; bool tfront; mat4x3 to2w; float tt;
          if (traceAcceptedPrimary(walkOrigin, walkDir, cursor, 1e30,
                                   tiid, tprim, tbc, tfront, to2w, tt)) {
            opaqueTail = true;
            tailColor = approximatePrimaryLayerColor(
                tiid, tprim, tbc, tfront, to2w);
          }
        }
        vec3 composite = opaqueTail ? tailColor : bgc;
        // Only the nearest layer owns the direction-changing refracted tail.
        // Launching a fresh walk for every straight-ray underlayer reused the
        // original camera direction after an earlier interface had bent it,
        // producing mutually inconsistent paths and excessive trace work.
        for (int i = layerCount - 1; i >= 1; --i) {
          float a = clamp(layerAlpha[i], 0.0, 1.0);
          vec3 transmitted = composite * layerTint[i];
          composite = mix(transmitted, layerColor[i], a);
        }
        vec3 topTransmitted = composite * layerTint[0];
        topTransmitted = mix(topTransmitted, topRefract,
                             clamp(topTransmission, 0.0, 1.0));
        composite = mix(topTransmitted, layerColor[0],
                        clamp(layerAlpha[0], 0.0, 1.0));
        outc = composite;
      }
    }
    if (rmode == 1) {
      float e = min(w0, min(bc.x, bc.y));
      const vec3 wireColor = vec3(0.04, 0.24, 0.10);
      outc = (e > 0.02) ? bgc : wireColor;
    } else if (rmode == 2) {
      outc = N * 0.5 + 0.5;
    } else if (rmode == 35) {
      outc = coatN * 0.5 + 0.5;
    } else if (rmode == 36) {
      outc = vec3(clamp(coatWeight, 0.0, 1.0));
    } else if (rmode == 37) {
      outc = clamp(coatColor, 0.0, 1.0);
    } else if (rmode == 38) {
      outc = vec3(clamp(coatRoughness, 0.0, 1.0));
    } else if (rmode == 39) {
      outc = clamp(materialF0, 0.0, 1.0);
    } else if (rmode == 40) {
      float ior = max(specIor, 1.0);
      float d = (ior - 1.0) / (ior + 1.0);
      outc = vec3(d * d);
    } else if (rmode == 3) {
      outc = idColor(mid);
    } else if (rmode == 4) {
      vec3 wp0 = o2w * vec4(fetchPos(vb, i0), 1.0);
      vec3 wp1 = o2w * vec4(fetchPos(vb, i1), 1.0);
      vec3 wp2 = o2w * vec4(fetchPos(vb, i2), 1.0);
      vec3 Ng = normalize(cross(wp1 - wp0, wp2 - wp0));
      if (dot(Ng, dir) > 0.0) Ng = -Ng;
      outc = Ng * 0.5 + 0.5;
    } else if (rmode == 5) {
      vec2 uvh = fetchUV(vb, i0) * w0 + fetchUV(vb, i1) * bc.x + fetchUV(vb, i2) * bc.y;
      outc = vec3(fract(uvh), 0.0);
    } else if (rmode == 6) {
      float d = clamp(t / max(pc.lightDir.w, 1e-3), 0.0, 1.0);
      outc = vec3(1.0 - d);
    } else if (rmode == 7) {
      outc = base;  // albedo (pre-lighting)
    } else if (rmode == 8) {  // facing
      vec3 wp0 = o2w * vec4(fetchPos(vb, i0), 1.0);
      vec3 wp1 = o2w * vec4(fetchPos(vb, i1), 1.0);
      vec3 wp2 = o2w * vec4(fetchPos(vb, i2), 1.0);
      outc = (dot(cross(wp1 - wp0, wp2 - wp0), dir) < 0.0) ? vec3(0.1, 0.7, 0.1)
                                                          : vec3(0.7, 0.1, 0.1);
    } else if (rmode == 9) {  // roughness
      outc = vec3(roughness);
    } else if (rmode == 10) {  // metallic
      outc = vec3(metallic);
    } else if (rmode == 11) {  // emissive
      outc = emissive;
    } else if (rmode == 12) {  // opacity
      outc = vec3(materialOpacity);
    } else if (rmode == 13) {  // world position
      outc = clamp((hit - pc.sceneMin.xyz) / pc.sceneExtent.xyz, 0.0, 1.0);
    } else if (rmode == 23) {  // uv checker
      vec2 uvh = fetchUV(vb, i0) * w0 + fetchUV(vb, i1) * bc.x + fetchUV(vb, i2) * bc.y;
      vec2 c = floor(fract(uvh) * 16.0);
      outc = vec3(mix(0.25, 0.85, mod(c.x + c.y, 2.0)));
    } else if (rmode == 30) {  // udim tile from UV set 0
      vec2 uvh = fetchUV(vb, i0) * w0 + fetchUV(vb, i1) * bc.x + fetchUV(vb, i2) * bc.y;
      int tile = int(floor(uvh.x)) + 10 * int(floor(uvh.y));
      outc = idColor(uint(max(tile, 0)));
    } else if (rmode == 33) {  // texel density (per-triangle UV/world area ratio)
      vec3 wp0 = o2w * vec4(fetchPos(vb, i0), 1.0);
      vec3 wp1 = o2w * vec4(fetchPos(vb, i1), 1.0);
      vec3 wp2 = o2w * vec4(fetchPos(vb, i2), 1.0);
      vec2 t0 = fetchUV(vb, i0), t1 = fetchUV(vb, i1), t2 = fetchUV(vb, i2);
      float worldArea = length(cross(wp1 - wp0, wp2 - wp0));
      vec2 d1 = t1 - t0, d2 = t2 - t0;
      float uvArea = abs(d1.x * d2.y - d2.x * d1.y);
      float td = sqrt(uvArea / max(worldArea, 1e-12));
      float c = clamp(td * pc.lightDir.w * 0.5, 0.0, 1.0);
      outc = vec3(c, 1.0 - abs(c - 0.5) * 2.0, 1.0 - c);
    } else if (rmode == 34) {  // source USD face id
      outc = (md.faceAddr != 0ul) ? idColor(Faces(md.faceAddr).fc[uint(prim)])
                                  : vec3(0.45);
    } else if (rmode == 31) {  // uv set 1 (multi-UV)
      if (md.uv1Addr != 0ul) {
        UV1s ub = UV1s(md.uv1Addr);
        vec2 t = fetchUV1(ub, i0) * w0 + fetchUV1(ub, i1) * bc.x + fetchUV1(ub, i2) * bc.y;
        outc = vec3(fract(t), 0.0);
      } else {
        outc = vec3(0.0);
      }
    } else if (rmode == 32) {  // blendshape influence
      float infl = 0.0;
      if (md.inflAddr != 0ul) {
        Infls fb = Infls(md.inflAddr);
        infl = fetchInfl(fb, i0) * w0 + fetchInfl(fb, i1) * bc.x + fetchInfl(fb, i2) * bc.y;
      }
      float c = clamp(infl / max(pc.lightDir.w * 0.1, 1e-4), 0.0, 1.0);
      outc = vec3(c, 1.0 - abs(c - 0.5) * 2.0, 1.0 - c);
    } else if (rmode == 22) {  // tangent (from triangle UV gradient)
      vec3 wp0 = o2w * vec4(fetchPos(vb, i0), 1.0);
      vec3 wp1 = o2w * vec4(fetchPos(vb, i1), 1.0);
      vec3 wp2 = o2w * vec4(fetchPos(vb, i2), 1.0);
      vec2 uv0 = fetchUV(vb, i0), uv1 = fetchUV(vb, i1), uv2 = fetchUV(vb, i2);
      vec3 e1 = wp1 - wp0, e2 = wp2 - wp0;
      vec2 d1 = uv1 - uv0, d2 = uv2 - uv0;
      float r = d1.x * d2.y - d2.x * d1.y;
      vec3 T = (abs(r) > 1e-8) ? (e1 * d2.y - e2 * d1.y) / r : e1;
      outc = normalize(T) * 0.5 + 0.5;
    } else if (rmode == 21) {  // skin weights: dominant joint tinted by its weight
      outc = vec3(0.45);  // unskinned -> gray
      if (md.jointAddr != 0ul && md.weightAddr != 0ul) {
        Joints jb = Joints(md.jointAddr);
        Weights wb = Weights(md.weightAddr);
        float w0d, w1d, w2d;
        int dj = fetchDomJoint(jb, wb, i0, w0d);  // provoking vertex joint (flat, matches raster)
        fetchDomJoint(jb, wb, i1, w1d);
        fetchDomJoint(jb, wb, i2, w2d);
        float wt = w0d * w0 + w1d * bc.x + w2d * bc.y;  // interpolated dominant weight
        outc = idColor(uint(dj)) * (0.3 + 0.7 * clamp(wt, 0.0, 1.0));
      }
    } else if (rmode == 25) {  // curvature (geometric: vertex-normal spread across the tri)
      if ((md.geometricNormal & 1u) != 0u) {
        outc = vec3(0.0, 1.0, 1.0);  // flat-shaded mesh -> zero curvature
      } else {
        vec3 n0 = normalize(fetchNrm(vb, i0));
        vec3 n1 = normalize(fetchNrm(vb, i1));
        vec3 n2 = normalize(fetchNrm(vb, i2));
        float spread = (1.0 - dot(n0, n1)) + (1.0 - dot(n1, n2)) + (1.0 - dot(n2, n0));
        float c = clamp(spread * 4.0, 0.0, 1.0);
        outc = vec3(c, 1.0 - abs(c - 0.5) * 2.0, 1.0 - c);
      }
    } else if (rmode == 27) {  // bvh-heatmap: hardware ray query can't count traversal
      outc = vec3(0.45);       // steps -> CUDA-only; neutral gray placeholder here
    } else if (rmode == 14) {  // barycentric
      outc = vec3(w0, bc.x, bc.y);
    } else if (rmode == 15) {  // prim id
      outc = idColor(uint(prim));
    } else if (rmode == 16) {  // mesh id
      outc = idColor(ii.meshId);
    } else if (rmode == 26) {  // instance id (TLAS instance index)
      outc = idColor(iid);
    } else if (rmode == 19) {  // missing normals
      outc = ((md.geometricNormal & 1u) != 0u) ? vec3(0.95, 0.1, 0.85) : vec3(0.2);
    } else if (rmode == 18) {  // purpose (bits 1-2 of geometricNormal)
      uint p = (md.geometricNormal >> 1) & 3u;
      outc = (p == 1u) ? vec3(0.2, 0.8, 0.3)
           : (p == 2u) ? vec3(0.2, 0.45, 0.95)
           : (p == 3u) ? vec3(0.95, 0.75, 0.1) : vec3(0.5);
    } else if (rmode == 29) {  // kind (bits 3-5 of geometricNormal)
      uint k = (md.geometricNormal >> 3) & 7u;
      outc = (k == 1u) ? vec3(0.2, 0.8, 0.8)
           : (k == 2u) ? vec3(0.85, 0.3, 0.85)
           : (k == 3u) ? vec3(0.95, 0.6, 0.15)
           : (k == 4u) ? vec3(0.5, 0.85, 0.4) : vec3(0.35);
#if !TUSDVIEW_RT_DISABLE_DEBUG_RAYS
    } else if (rmode == 24) {  // ray-traced ambient occlusion
      // Front-facing geometric normal for the hemisphere (independent of shading N).
      vec3 wp0 = o2w * vec4(fetchPos(vb, i0), 1.0);
      vec3 wp1 = o2w * vec4(fetchPos(vb, i1), 1.0);
      vec3 wp2 = o2w * vec4(fetchPos(vb, i2), 1.0);
      vec3 Ng = normalize(cross(wp1 - wp0, wp2 - wp0));
      if (dot(Ng, dir) > 0.0) Ng = -Ng;
      float aoRadius = max(pc.lightDir.w, 1e-3) * 0.15;  // 15% of scene extent
      uint seed = hashU(uint(px.x) * 1973u + uint(px.y) * 9277u + fi * 26699u + 1u);
      const int NS = 24;
      float occ = 0.0;
      [[dont_unroll]] for (int s = 0; s < NS; ++s) {
        vec3 sd = cosHemi(Ng, rnd(seed), rnd(seed));
        bool aoHit = false;
        for (uint ti = 0u; ti < tlasChunkCount() && !aoHit; ++ti) {
          rayQueryEXT aq;
          rayQueryInitializeEXT(aq, TLAS[ti],
                                gl_RayFlagsTerminateOnFirstHitEXT, 0xFF,
                                hit + Ng * (aoRadius * 1e-2), 1e-4, sd,
                                aoRadius);
          while (rayQueryProceedEXT(aq)) {
            if (rayQueryGetIntersectionTypeEXT(aq, false) ==
                gl_RayQueryCandidateIntersectionTriangleEXT) {
              uint ci = globalInstanceId(
                  ti, rayQueryGetIntersectionInstanceIdEXT(aq, false));
              int cp = rayQueryGetIntersectionPrimitiveIndexEXT(aq, false);
              vec2 cb = rayQueryGetIntersectionBarycentricsEXT(aq, false);
              bool cf = rayQueryGetIntersectionFrontFaceEXT(aq, false);
              if (materialAllowsHit(ci, cp, cb, cf))
                rayQueryConfirmIntersectionEXT(aq);
            }
          }
          aoHit = rayQueryGetIntersectionTypeEXT(aq, true) !=
                  gl_RayQueryCommittedIntersectionNoneEXT;
        }
        if (aoHit) occ += 1.0;
      }
      outc = vec3(1.0 - occ / float(NS));
    } else if (rmode == 28) {  // soft shadow / sky visibility toward the light
      vec3 Lc = normalize(pc.lightDir.xyz);
      vec3 tt = normalize(abs(Lc.x) > 0.9 ? vec3(0,1,0) : vec3(1,0,0));
      vec3 bb = normalize(cross(Lc, tt)); tt = cross(bb, Lc);
      uint seed = hashU(uint(px.x) * 2719u + uint(px.y) * 5051u + fi * 40503u + 7u);
      const int NS = 16; float vis = 0.0; const float coneR = 0.08;
      [[dont_unroll]] for (int s = 0; s < NS; ++s) {
        float a = rnd(seed) * 6.2831853, rr = sqrt(rnd(seed)) * coneR;
        vec3 sd = normalize(Lc + tt * (rr * cos(a)) + bb * (rr * sin(a)));
        bool softShadowHit = false;
        for (uint ti = 0u; ti < tlasChunkCount() && !softShadowHit; ++ti) {
          rayQueryEXT sq;
          rayQueryInitializeEXT(sq, TLAS[ti],
                                gl_RayFlagsTerminateOnFirstHitEXT, 0xFF,
                                hit + N * 1e-3, 1e-3, sd, 1e30);
          while (rayQueryProceedEXT(sq)) {
            if (rayQueryGetIntersectionTypeEXT(sq, false) ==
                gl_RayQueryCandidateIntersectionTriangleEXT) {
              uint ci = globalInstanceId(
                  ti, rayQueryGetIntersectionInstanceIdEXT(sq, false));
              int cp = rayQueryGetIntersectionPrimitiveIndexEXT(sq, false);
              vec2 cb = rayQueryGetIntersectionBarycentricsEXT(sq, false);
              bool cf = rayQueryGetIntersectionFrontFaceEXT(sq, false);
              if (materialAllowsHit(ci, cp, cb, cf))
                rayQueryConfirmIntersectionEXT(sq);
            }
          }
          softShadowHit = rayQueryGetIntersectionTypeEXT(sq, true) !=
                          gl_RayQueryCommittedIntersectionNoneEXT;
        }
        if (!softShadowHit) vis += 1.0;
      }
      outc = vec3(vis / float(NS));
#endif
    }
  }
#endif

  // Progressive accumulation: add this sample's radiance to the running sum and
  // display the average. fi==0 (or accumulation off) overwrites, so a stale or
  // uninitialised accum buffer never bleeds into a fresh trace.
  if (accumulate) {
    vec3 sum = (fi == 0u) ? outc : (imageLoad(accumImg, px).rgb + outc);
    imageStore(accumImg, px, vec4(sum, 1.0));
    outc = sum / float(fi + 1u);
  }
  // Encode the shaded/wireframe image for display (linear -> sRGB), consistent
  // with the raster backends' output (T11). Debug AOVs stay raw. Accumulation
  // stays linear above, so only the displayed average is encoded.
  int outMode = int(pc.camPos.w + 0.5);
  if (outMode == 0) outc *= exp2(pc.clearColor.w);
  if (outMode == 0 || outMode == 1) outc = linearToSrgb(outc);
  imageStore(outImg, px, vec4(outc, 1.0));
}
