#version 460

// Vulkan ray-query primary + shadow tracer. Writes a shaded image that mirrors
// the rasterizer's look (same directional light + ambient as mesh.frag), plus
// hard shadows from one shadow ray. Supports GPU instancing (one BLAS shared by
// many TLAS instances), per-vertex + per-instance displayColor, and authored
// (interpolated) vs geometric (face) normals.
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 8, local_size_y = 8) in;

// Vertex buffer = interleaved DrawVertex (8 floats: pos.xyz, nrm.xyz, uv.xy).
layout(buffer_reference, scalar) readonly buffer Verts { float v[]; };
layout(buffer_reference, scalar) readonly buffer Idx   { uint  i[]; };
// Optional per-vertex displayColor (vec3 packed as 3 floats / vertex).
layout(buffer_reference, scalar) readonly buffer Cols  { float c[]; };

struct MeshDesc {
  uint64_t vtxAddr;       // device address of the vertex buffer (DrawVertex[])
  uint64_t idxAddr;       // device address of the index buffer (uint[])
  uint64_t vtxColorAddr;  // per-vertex displayColor (vec3[]); 0 = none
  uint     matId;         // index into the materials SSBO (-1 as 0xffffffff -> gray)
  uint     geometricNormal;  // 1 = no authored normals -> geometric face normal
  vec4     nrm0;          // normal matrix columns (xyz used)
  vec4     nrm1;
  vec4     nrm2;
};

// Per-TLAS-instance info, indexed by gl_InstanceID (full range).
struct InstInfo {
  uint meshId;       // index into meshes[]
  uint useMaterial;  // 1 = non-instanced (material + normalMat); 0 = tint + o2w normal
  uint pad0;
  uint pad1;
  vec4 tint;         // per-instance color or flatColor (xyz used)
};

layout(set = 0, binding = 0) uniform accelerationStructureEXT TLAS;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outImg;
layout(set = 0, binding = 2, scalar) readonly buffer Meshes { MeshDesc meshes[]; };
layout(set = 0, binding = 3, scalar) readonly buffer Mats   { vec4 baseColor[]; };
layout(set = 0, binding = 4, scalar) readonly buffer Insts  { InstInfo insts[]; };

layout(push_constant) uniform PC {
  mat4 invViewProj;  // inverse(proj * view)
  vec4 camPos;       // xyz = camera world position
  vec4 lightDir;     // xyz = unit direction *towards* the light
  vec4 clearColor;   // rgb background for ray misses
} pc;

vec3 fetchPos(Verts vb, uint vi) {
  return vec3(vb.v[vi * 8u + 0u], vb.v[vi * 8u + 1u], vb.v[vi * 8u + 2u]);
}
vec3 fetchNrm(Verts vb, uint vi) {
  return vec3(vb.v[vi * 8u + 3u], vb.v[vi * 8u + 4u], vb.v[vi * 8u + 5u]);
}
vec3 fetchCol(Cols cb, uint vi) {
  return vec3(cb.c[vi * 3u + 0u], cb.c[vi * 3u + 1u], cb.c[vi * 3u + 2u]);
}

void main() {
  ivec2 px = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(outImg);
  if (px.x >= size.x || px.y >= size.y) return;

  // Pixel -> NDC -> world ray via the inverse view-projection. Flip Y so image
  // row 0 maps to ndc.y=+1 (scene top), matching the raster path's negative-
  // height viewport; otherwise the traced image is vertically inverted.
  vec2 uv = (vec2(px) + 0.5) / vec2(size);
  vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
  vec4 nearH = pc.invViewProj * vec4(ndc, 0.0, 1.0);
  vec4 farH  = pc.invViewProj * vec4(ndc, 1.0, 1.0);
  vec3 nearW = nearH.xyz / nearH.w;
  vec3 farW  = farH.xyz / farH.w;
  vec3 origin = nearW;
  vec3 dir = normalize(farW - nearW);

  vec3 outc = pc.clearColor.rgb;

  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, TLAS, gl_RayFlagsOpaqueEXT, 0xFF, origin, 1e-3, dir, 1e30);
  while (rayQueryProceedEXT(rq)) {}

  if (rayQueryGetIntersectionTypeEXT(rq, true) ==
      gl_RayQueryCommittedIntersectionTriangleEXT) {
    uint iid = uint(rayQueryGetIntersectionInstanceIdEXT(rq, true));  // TLAS instance index
    int prim = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
    vec2 bc = rayQueryGetIntersectionBarycentricsEXT(rq, true);
    float t = rayQueryGetIntersectionTEXT(rq, true);
    vec3 hit = origin + dir * t;

    InstInfo ii = insts[iid];
    MeshDesc md = meshes[ii.meshId];
    Verts vb = Verts(md.vtxAddr);
    Idx ib = Idx(md.idxAddr);
    uint i0 = ib.i[prim * 3u + 0u];
    uint i1 = ib.i[prim * 3u + 1u];
    uint i2 = ib.i[prim * 3u + 2u];
    float w0 = 1.0 - bc.x - bc.y;

    // Object->world for this instance (instance transform for instanced meshes,
    // the mesh's world for non-instanced).
    mat4x3 o2w = rayQueryGetIntersectionObjectToWorldEXT(rq, true);

    // Normal: geometric (face) when there are no authored normals, else the
    // interpolated vertex normal transformed by the normal matrix (non-instanced)
    // or the instance's object->world 3x3 (instanced).
    vec3 N;
    if (md.geometricNormal != 0u) {
      vec3 wp0 = o2w * vec4(fetchPos(vb, i0), 1.0);
      vec3 wp1 = o2w * vec4(fetchPos(vb, i1), 1.0);
      vec3 wp2 = o2w * vec4(fetchPos(vb, i2), 1.0);
      N = normalize(cross(wp1 - wp0, wp2 - wp0));
    } else {
      vec3 nObj = fetchNrm(vb, i0) * w0 + fetchNrm(vb, i1) * bc.x + fetchNrm(vb, i2) * bc.y;
      mat3 nm = (ii.useMaterial != 0u)
                    ? mat3(md.nrm0.xyz, md.nrm1.xyz, md.nrm2.xyz)
                    : mat3(o2w);
      N = normalize(nm * nObj);
    }
    // Two-sided shading for the geometric-normal + instanced paths: face the normal
    // toward the ray so inward-wound / back-facing triangles still light correctly
    // (mirrors the raster's gl_FrontFacing flip). Non-instanced authored normals are
    // left as-authored (matches the material shader, which does not flip them).
    bool authoredNonInstanced = (ii.useMaterial != 0u) && (md.geometricNormal == 0u);
    if (!authoredNonInstanced && dot(N, dir) > 0.0) N = -N;

    // Base color: material (non-instanced) or per-instance tint (instanced), times
    // the interpolated per-vertex displayColor when present.
    vec3 base;
    if (ii.useMaterial != 0u) {
      base = (md.matId != 0xffffffffu) ? baseColor[md.matId].rgb : vec3(0.6);
    } else {
      base = ii.tint.rgb;  // per-instance color or the prototype's flatColor
    }
    if (md.vtxColorAddr != 0ul) {
      Cols cb = Cols(md.vtxColorAddr);
      base *= fetchCol(cb, i0) * w0 + fetchCol(cb, i1) * bc.x + fetchCol(cb, i2) * bc.y;
    }

    vec3 L = normalize(pc.lightDir.xyz);
    float diff = max(dot(N, L), 0.0);

    // Shadow ray towards the light (hard shadows).
    float shadow = 1.0;
    if (diff > 0.0) {
      rayQueryEXT sq;
      rayQueryInitializeEXT(sq, TLAS,
                            gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                            0xFF, hit + N * 1e-3, 1e-3, L, 1e30);
      while (rayQueryProceedEXT(sq)) {}
      if (rayQueryGetIntersectionTypeEXT(sq, true) !=
          gl_RayQueryCommittedIntersectionNoneEXT) {
        shadow = 0.0;
      }
    }
    outc = base * (0.25 + 0.85 * diff * shadow);

    // Wireframe (camPos.w != 0): keep the nearest hit shaded only near a triangle
    // edge (small barycentric), else fall back to the background -- the RT analogue
    // of the raster glPolygonMode(LINE) toggle.
    if (pc.camPos.w > 0.5) {
      float e = min(w0, min(bc.x, bc.y));
      if (e > 0.02) outc = pc.clearColor.rgb;
    }
  }

  imageStore(outImg, px, vec4(outc, 1.0));
}
