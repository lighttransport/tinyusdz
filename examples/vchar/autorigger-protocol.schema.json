{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightusd.github.io/schemas/vchar-autorigger-1.json",
  "title": "vchar external auto-rigger JSON-RPC payloads",
  "type": "object",
  "required": ["jsonrpc", "method"],
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": { "type": ["integer", "string"] },
    "method": {
      "enum": ["rig.initialize", "rig.inspect", "rig.submit", "rig.status", "rig.cancel", "dna.inspect", "dna.convert", "dna.evaluate", "body.animate"]
    },
    "params": {
      "type": "object",
      "properties": {
        "asset_path": { "type": "string" },
        "output_layer": { "type": "string", "pattern": "\\.usd[ac]$" },
        "job_id": { "type": "string" },
        "scope": { "enum": ["facial", "body", "all"] },
        "lod": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "control_space": { "enum": ["raw", "canonical"] },
        "controls": { "type": "array", "items": { "type": "number" }, "maxItems": 65536 },
        "rig_layer": { "type": "string" },
        "joints_path": { "type": "string" },
        "track_path": { "type": "string" },
        "options": { "type": "object" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
