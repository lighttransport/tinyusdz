#usda 1.0
(
    doc = "Value-less attributes must not emit a default with an Invalid ValueRep (bug 1)."
)
def Xform "Root"
{
    float withValue = 1.0
    float valueless
    float[] valuelessArray
    token outputs:surface
    color3f primvars:missingColor
    asset shaping:ies:file
    normal3f[] declaredNormals

    def Scope "Child"
    {
        double3 xformOp:translate = (1, 2, 3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        token outputs:out
    }

    def Material "M"
    {
        token outputs:surface.connect = </Root/M/S.outputs:surface>
        def Shader "S"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
            token outputs:surface
        }
    }
}
