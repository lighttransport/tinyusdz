#usda 1.0
(
    defaultPrim = "P"
)

def Xform "Source"
{
    def Mesh "M"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    }
}

def Xform "P" (
    append variantSets = "vs"
    variants = { string vs = "render" }
)
{
    variantSet "vs" = {
        "render" (
            prepend references = </Source>
        ) {
        }
    }
}

def Xform "Q" (
    append variantSets = "vs"
    variants = { string vs = "render" }
)
{
    variantSet "vs" = {
        "render" (
            prepend payload = @payload.usda@</PayloadRoot>
        ) {
        }
    }
}
