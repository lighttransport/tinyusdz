<?xml version="1.0"?>
<materialx version="1.38" colorspace="lin_rec709">
  <!-- Shared nodegraph definitions that can be included by other files -->
  <nodegraph name="NG_shared_noise">
    <constant name="noise_color" type="color3">
      <input name="value" type="color3" value="0.5, 0.3, 0.1" />
    </constant>
    <multiply name="noise_scale" type="color3">
      <input name="in1" type="color3" nodename="noise_color" />
      <input name="in2" type="color3" value="2.0, 2.0, 2.0" />
    </multiply>
    <output name="out" type="color3" nodename="noise_scale" />
  </nodegraph>

  <!-- Shared shader definition -->
  <open_pbr_surface name="SharedBaseShader" type="surfaceshader">
    <input name="base_weight" type="float" value="1.0" />
    <input name="base_color" type="color3" value="0.5, 0.5, 0.5" />
    <input name="specular_roughness" type="float" value="0.3" />
    <input name="specular_ior" type="float" value="1.5" />
  </open_pbr_surface>
</materialx>
