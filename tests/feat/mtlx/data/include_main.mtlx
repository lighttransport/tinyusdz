<?xml version="1.0"?>
<materialx version="1.38" colorspace="lin_rec709">
  <!-- Include shared definitions from another file -->
  <include filename="include_base.mtlx" />

  <!-- Material that references the shared nodegraph from the included file -->
  <open_pbr_surface name="MainShader" type="surfaceshader">
    <input name="base_weight" type="float" value="1.0" />
    <input name="base_color" type="color3" nodegraph="NG_shared_noise" output="out" />
    <input name="specular_roughness" type="float" value="0.5" />
    <input name="coat_weight" type="float" value="0.2" />
  </open_pbr_surface>
  <surfacematerial name="MainMaterial" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="MainShader" />
  </surfacematerial>
</materialx>
