#usda 1.0
# EXPECT: shade.primvarReader.result

def Material "mat"
{
    token inputs:stPrimvarName = "st"

    def Shader "reader"
    {
        uniform token info:id = "UsdPrimvarReader_float2"
        string inputs:varname.connect = </mat.inputs:stPrimvarName>
        token outputs:result
    }
}
