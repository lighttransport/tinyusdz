#usda 1.0
# EXPECT: geom.skel.animation.transforms
# EXPECT: geom.skel.animation.blendShapes
# EXPECT: geom.skel.skinning.index
# EXPECT: geom.skel.skinning.weight

def SkelRoot "Root"
{
    def Skeleton "Skel"
    {
        uniform token[] joints = ["Root", "Root/Spine"]
    }

    def SkelAnimation "Anim"
    {
        uniform token[] joints = ["Root", "Root/Spine"]
        quatf[] rotations.timeSamples = {
            1: [(1, 0, 0, 0), (1, 0, 0, 0)]
            2: [(1, 0, 0, 0)]
        }
        uniform token[] blendShapes = ["Smile", "Smile"]
        float[] blendShapeWeights.timeSamples = {
            1: [0, 1]
            2: [0]
        }
    }

    def Mesh "Mesh"
    {
        point3f[] points = [(0, 0, 0)]
        int[] faceVertexCounts = [1]
        int[] faceVertexIndices = [0]
        rel skel:skeleton = </Root/Skel>
        int[] primvars:skel:jointIndices = [0, 3] (
            interpolation = "vertex"
            elementSize = 2
        )
        float[] primvars:skel:jointWeights = [0.25, 0.25] (
            interpolation = "vertex"
            elementSize = 2
        )
    }
}
