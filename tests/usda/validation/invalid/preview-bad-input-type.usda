#usda 1.0
# EXPECT: shade.preview.inputType
(
    doc = "UsdPreviewSurface inputs with wrong types. Expect WARN shade.preview.inputType (shade group)."
    defaultPrim = "World"
)

def Xform "World"
{
    def Material "mat"
    {
        token outputs:surface.connect = </World/mat/surface.outputs:surface>

        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            # diffuseColor must be color3f, not float.
            float inputs:diffuseColor = 0.5
            # roughness must be float, not color3f.
            color3f inputs:roughness = (0.1, 0.1, 0.1)
            token outputs:surface
        }
    }
}
