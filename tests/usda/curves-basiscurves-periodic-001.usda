#usda 1.0
(
    doc = "BasisCurves test with periodic wrap - creates closed curves"
    metersPerUnit = 1
    upAxis = "Z"
)

def BasisCurves "PeriodicCurve"
{
    uniform token basis = "bspline"
    uniform token type = "cubic"
    uniform token wrap = "periodic"
    int[] curveVertexCounts = [8]
    point3f[] points = [
        # Circle-like closed curve
        (1, 0, 0), (0.707, 0.707, 0), (0, 1, 0), (-0.707, 0.707, 0),
        (-1, 0, 0), (-0.707, -0.707, 0), (0, -1, 0), (0.707, -0.707, 0)
    ]
    float[] widths = [0.1] (
        interpolation = "constant"
    )
    color3f[] primvars:displayColor = [(1, 1, 0)] (
        interpolation = "constant"
    )
}
