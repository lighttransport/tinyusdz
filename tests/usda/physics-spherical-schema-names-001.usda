#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "BodyA"
    {
    }

    def Sphere "BodyB"
    {
    }

    def PhysicsSphericalJoint "Ball"
    {
        rel physics:body0 = </World/BodyA>
        rel physics:body1 = </World/BodyB>
        token physics:axis = "Y"
        float physics:coneAngle0Limit = 30
        float physics:coneAngle1Limit = 45
    }
}
