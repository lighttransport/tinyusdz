#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Box0"
    {
        double size = 1.0
    }

    def Cube "Box1"
    {
        double size = 0.5
        double3 xformOp:translate = (0, -1.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def PhysicsRevoluteJoint "Hinge"
    {
        rel physics:body0 = </World/Box0>
        rel physics:body1 = </World/Box1>
        uniform point3f physics:localPos0 = (0, -0.5, 0)
        uniform point3f physics:localPos1 = (0, 0.25, 0)
        uniform quatf physics:localRot0 = (1, 0, 0, 0)
        uniform quatf physics:localRot1 = (1, 0, 0, 0)
        token physics:axis = "X"
        float physics:lowerLimit = -90
        float physics:upperLimit = 90
    }
}
