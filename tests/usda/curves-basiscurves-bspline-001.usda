#usda 1.0
(
    doc = "BasisCurves test with bspline basis - multiple curves"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Hair"
{
    def BasisCurves "BSplineStrands"
    {
        uniform token basis = "bspline"
        uniform token type = "cubic"
        uniform token wrap = "nonperiodic"
        int[] curveVertexCounts = [7, 7, 7]
        point3f[] points = [
            # First strand
            (0, 0, 0), (0, 0, 0.5), (0, 0, 1.0), (0, 0, 1.5),
            (0, 0, 2.0), (0, 0, 2.5), (0, 0, 3.0),
            # Second strand
            (0.5, 0, 0), (0.5, 0, 0.5), (0.5, 0, 1.0), (0.5, 0, 1.5),
            (0.5, 0, 2.0), (0.5, 0, 2.5), (0.5, 0, 3.0),
            # Third strand
            (1.0, 0, 0), (1.0, 0, 0.5), (1.0, 0, 1.0), (1.0, 0, 1.5),
            (1.0, 0, 2.0), (1.0, 0, 2.5), (1.0, 0, 3.0)
        ]
        color3f[] primvars:displayColor = [(0.8, 0.6, 0.4)] (
            interpolation = "constant"
        )
        float[] widths = [0.05, 0.04, 0.03, 0.02, 0.02, 0.01, 0.01] (
            interpolation = "vertex"
        )
    }
}
