#usda 1.0
(
    doc = "Reference test - multiple reference patterns"
    defaultPrim = "ReferenceTests"
    startTimeCode = 1
    endTimeCode = 120
)

# Define local assets to reference (inline in same file for testing)
def Xform "LocalAsset" (
    active = false
)
{
    def Cube "AnimatedCube"
    {
        double size = 1.0

        double3 xformOp:translate.timeSamples = {
            1: (0, 0, 0),
            24: (5, 0, 0),
            48: (5, 5, 0),
            72: (0, 5, 0),
            96: (0, 0, 0),
        }
        float3 xformOp:rotateXYZ.timeSamples = {
            1: (0, 0, 0),
            24: (90, 0, 0),
            48: (90, 90, 0),
            72: (90, 90, 90),
            96: (0, 0, 0),
        }
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

        color3f[] primvars:displayColor = [(1, 0, 0)]
    }
}

def Xform "AnotherAsset" (
    active = false
)
{
    def Sphere "Sphere"
    {
        double radius = 0.5
        color3f[] primvars:displayColor = [(0, 1, 0)]
    }
}

def Xform "ReferenceTests"
{
    # =========================================================================
    # Simple internal reference
    # =========================================================================
    def Xform "SimpleRef" (
        references = </LocalAsset>
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # =========================================================================
    # Reference with prepend
    # =========================================================================
    def Xform "PrependRef" (
        prepend references = </LocalAsset>
    )
    {
        double3 xformOp:translate = (10, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # =========================================================================
    # Reference with append
    # =========================================================================
    def Xform "AppendRef" (
        append references = </LocalAsset>
    )
    {
        double3 xformOp:translate = (20, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # =========================================================================
    # Multiple references
    # =========================================================================
    def Xform "MultipleRefs" (
        prepend references = [
            </LocalAsset>,
            </AnotherAsset>
        ]
    )
    {
        double3 xformOp:translate = (30, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # =========================================================================
    # Reference with override
    # =========================================================================
    def Xform "RefWithOverride" (
        references = </LocalAsset>
    )
    {
        double3 xformOp:translate = (0, 10, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        # Override the cube size
        over "AnimatedCube"
        {
            double size = 2.0
            color3f[] primvars:displayColor = [(0, 0, 1)]
        }
    }

    # =========================================================================
    # Reference with delete
    # =========================================================================
    def Xform "RefWithDelete" (
        delete references = </LocalAsset>
        prepend references = </AnotherAsset>
    )
    {
        double3 xformOp:translate = (10, 10, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # =========================================================================
    # Stacked references (multiple refs on same prim)
    # =========================================================================
    def Xform "StackedRefs" (
        prepend references = </LocalAsset>
        append references = </AnotherAsset>
    )
    {
        double3 xformOp:translate = (20, 10, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # =========================================================================
    # Reference chain (reference referencing another reference)
    # =========================================================================
    def Xform "RefChainBase" (
        references = </LocalAsset>
    )
    {
        double3 xformOp:translate = (0, 20, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "RefChainDerived" (
        references = </ReferenceTests/RefChainBase>
    )
    {
        double3 xformOp:translate = (10, 20, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
