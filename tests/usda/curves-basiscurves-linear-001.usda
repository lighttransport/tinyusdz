#usda 1.0
(
    doc = "BasisCurves test with linear interpolation"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Lines"
{
    def BasisCurves "LinearStrokes"
    {
        uniform token type = "linear"
        uniform token wrap = "nonperiodic"
        int[] curveVertexCounts = [3, 4, 5]
        point3f[] points = [
            # First line (3 points)
            (0, 0, 0), (1, 1, 0), (2, 0, 0),
            # Second line (4 points)
            (0, 0, 1), (1, 0.5, 1), (2, 1, 1), (3, 0.5, 1),
            # Third line (5 points)
            (0, 0, 2), (0.5, 0.5, 2), (1, 0, 2), (1.5, 0.5, 2), (2, 0, 2)
        ]
        float[] widths = [0.05, 0.1, 0.05] (
            interpolation = "uniform"
        )
        color3f[] primvars:displayColor = [(0, 0, 1), (0, 1, 1), (1, 0, 1)] (
            interpolation = "uniform"
        )
    }
}
