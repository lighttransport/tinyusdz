#usda 1.0
(
    doc = "Test: Spectral emission with D65 illuminant preset"
)

def DistantLight "TestLight"
{
    float inputs:intensity = 1.0
    color3f inputs:color = (1.0, 1.0, 1.0)
    float2[] wavelength:emission = [] (
        customData = {
            string illuminantPreset = "d65"
        }
    )
}
