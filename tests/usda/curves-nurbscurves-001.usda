#usda 1.0
(
    doc = "NurbsCurves test - NURBS curve with knots and order"
    metersPerUnit = 1
    upAxis = "Y"
)

def NurbsCurves "NurbsCurve"
{
    int[] curveVertexCounts = [7]
    point3f[] points = [
        (0, 0, 0), (1, 2, 0), (2, 3, 0), (3, 2, 0),
        (4, 1, 0), (5, 0, 0), (6, 0, 0)
    ]
    int[] order = [4]
    double[] knots = [0, 0, 0, 0, 0.25, 0.5, 0.75, 1, 1, 1, 1]
    float[] widths = [0.1, 0.15, 0.2, 0.2, 0.15, 0.1, 0.1] (
        interpolation = "vertex"
    )
    color3f[] primvars:displayColor = [(0, 1, 1)] (
        interpolation = "constant"
    )
}
