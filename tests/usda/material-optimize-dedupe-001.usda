#usda 1.0
(
    doc = "Minimal material optimizer fixture. MeshB's material is an exact duplicate of MeshA's material except for rooted self-path connections."
)

def Xform "Root"
{
    def Mesh "MeshA"
    {
        rel material:binding = </Root/MeshA/Mat>

        def Material "Mat"
        {
            token outputs:surface.connect = </Root/MeshA/Mat/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0, 0)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Mesh "MeshB"
    {
        rel material:binding = </Root/MeshB/Mat>

        def Material "Mat"
        {
            token outputs:surface.connect = </Root/MeshB/Mat/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0, 0)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }
}
