#usda 1.0
(
    doc = "Minimal material optimizer fixture for preview graph canonicalization."
)

def Xform "Root"
{
    def Mesh "MeshA"
    {
        rel material:binding = </Root/MeshA/Mat>

        def Material "Mat"
        {
            token outputs:surface.connect = </Root/MeshA/Mat/SurfaceA.outputs:surface>

            def Shader "SurfaceA"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.25, 0.5, 0.75)
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "UnusedA"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0, 0)
                token outputs:surface
            }
        }
    }

    def Mesh "MeshB"
    {
        rel material:binding = </Root/MeshB/Mat>

        def Material "Mat"
        {
            token outputs:surface.connect = </Root/MeshB/Mat/PreviewB.outputs:surface>

            def Shader "PreviewB"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.25, 0.5, 0.75)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }
}
