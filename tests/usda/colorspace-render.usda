#usda 1.0
(
    defaultPrim = "World"
    renderSettingsPrimPath = "/World/Settings"
)

def Xform "World"
{
    def RenderSettings "Settings"
    {
        uniform token renderingColorSpace = "lin_ap1_scene"
    }

    def Mesh "Card" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)]
        rel material:binding = </World/Material>
    }

    def Material "Material"
    {
        token outputs:surface.connect = </World/Material/Surface.outputs:surface>
        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            color3f inputs:emissiveColor = (0.25, 0.5, 0.75) (
                colorSpace = "srgb_rec709_scene"
            )
            token outputs:surface
        }
    }
}
