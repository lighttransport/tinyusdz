#usda 1.0
(
    doc = "BasisCurves with various primvars and interpolation modes"
    metersPerUnit = 1
    upAxis = "Y"
)

def BasisCurves "CurveWithPrimvars"
{
    uniform token basis = "catmullRom"
    uniform token type = "cubic"
    uniform token wrap = "nonperiodic"
    int[] curveVertexCounts = [5, 5]
    point3f[] points = [
        # First curve
        (0, 0, 0), (1, 1, 0), (2, 0.5, 0), (3, 1.5, 0), (4, 1, 0),
        # Second curve
        (0, 0, 1), (1, 0.8, 1), (2, 1.2, 1), (3, 0.7, 1), (4, 1, 1)
    ]

    # Vertex interpolation - 10 values (5 per curve)
    float[] widths = [0.05, 0.1, 0.15, 0.1, 0.05, 0.08, 0.12, 0.15, 0.12, 0.08] (
        interpolation = "vertex"
    )

    # Uniform interpolation - 2 values (1 per curve)
    color3f[] primvars:displayColor = [(1, 0, 0), (0, 0, 1)] (
        interpolation = "uniform"
    )

    # Varying interpolation for custom data
    float[] primvars:temperature = [20, 25, 30, 35, 40, 22, 27, 32, 37, 42] (
        interpolation = "varying"
    )
}
