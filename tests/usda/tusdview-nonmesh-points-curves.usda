#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World"
{
    def Points "Dots"
    {
        point3f[] points = [(-1, 0.5, 0), (0, 0.5, 0), (1, 0.5, 0)]
        float[] widths = [0.35, 0.5, 0.7]
        color3f[] primvars:displayColor = [(1, 0.05, 0.05), (0.05, 1, 0.05), (0.05, 0.1, 1)] (
            interpolation = "vertex"
        )
        float[] primvars:displayOpacity = [1, 0.5, 1] (
            interpolation = "vertex"
        )
    }

    def BasisCurves "Ribbon"
    {
        uniform token basis = "bezier"
        uniform token type = "cubic"
        uniform token wrap = "nonperiodic"
        int[] curveVertexCounts = [4]
        point3f[] points = [(-1.5, -0.6, 0), (-0.5, -1.1, 0), (0.5, -0.1, 0), (1.5, -0.6, 0)]
        float[] widths = [0.16, 0.22, 0.3, 0.18]
        color3f[] primvars:displayColor = [(1, 0.6, 0), (1, 0.1, 0.8), (0.1, 0.7, 1), (0.2, 1, 0.4)] (
            interpolation = "vertex"
        )
        float[] primvars:displayOpacity = [0.2, 0.4, 0.8, 1] (
            interpolation = "vertex"
        )
    }

    def HermiteCurves "HermiteRibbon"
    {
        int[] curveVertexCounts = [3]
        point3f[] points = [(-1.4, -1.3, 0.3), (0, -1.6, 0.3), (1.4, -1.3, 0.3)]
        vector3f[] tangents = [(1.2, -0.4, 0), (1.2, 0.8, 0), (1.2, -0.4, 0)]
        float[] widths = [0.12, 0.28, 0.12]
        color3f[] primvars:displayColor = [(1, 0.2, 0.1), (1, 0.8, 0.1), (0.2, 1, 0.2)] (
            interpolation = "vertex"
        )
        float[] primvars:displayOpacity = [1, 0.65, 1] (
            interpolation = "vertex"
        )
    }

    def NurbsCurves "NurbsRibbon"
    {
        int[] curveVertexCounts = [4]
        int[] order = [3]
        double[] knots = [0, 0, 0, 1, 2, 2, 2]
        double2[] ranges = [(0, 2)]
        point3f[] points = [(-1.4, -2, -0.25), (-0.5, -1.6, -0.25), (0.5, -2.4, -0.25), (1.4, -2, -0.25)]
        float[] widths = [0.15]
        color3f[] primvars:displayColor = [(0.2, 0.4, 1), (0.2, 0.8, 1), (0.7, 0.3, 1), (1, 0.2, 0.7)] (
            interpolation = "vertex"
        )
        float[] primvars:displayOpacity = [0.35, 0.6, 0.8, 1] (
            interpolation = "vertex"
        )
    }
}
