#usda 1.0
(
    defaultPrim = "Root"
    upAxis = "Y"
)

def Xform "Root"
{
    def Preliminary_ReferenceImage "AnchorImage"
    {
        uniform asset image = @anchor.png@
        uniform double physicalWidth = 15.0
    }

    def Mesh "AnchoredBox" (
        prepend apiSchemas = ["Preliminary_AnchoringAPI"]
    )
    {
        uniform token preliminary:anchoring:type = "image"
        rel preliminary:imageAnchoring:referenceImage = </Root/AnchorImage>

        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 3, 2, 2, 3, 5, 4, 4, 5, 7, 6, 6, 7, 1, 0, 1, 7, 5, 3, 6, 0, 2, 4]
        point3f[] points = [(-0.5, -0.5, 0.5), (0.5, -0.5, 0.5), (-0.5, 0.5, 0.5), (0.5, 0.5, 0.5), (-0.5, 0.5, -0.5), (0.5, 0.5, -0.5), (-0.5, -0.5, -0.5), (0.5, -0.5, -0.5)]
    }

    def Mesh "PlaneAnchored" (
        prepend apiSchemas = ["Preliminary_AnchoringAPI"]
    )
    {
        uniform token preliminary:anchoring:type = "plane"
        uniform token preliminary:planeAnchoring:alignment = "horizontal"
    }
}
