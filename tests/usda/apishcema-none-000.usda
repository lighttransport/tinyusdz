#usda 1.0
(
    defaultPrim = "m"
    upAxis = "Y"
)

# Regression test: `apiSchemas = None` on prim meta (issue #273).
# This is USD's ValueBlock for "explicitly empty list" — distinct
# from the typed-attribute None case in none-001.usda (where None
# blocks a `primvars:myint` value), here None clears the apiSchemas
# array-typed prim metadatum.

def Mesh "m" (
    apiSchemas = None
)
{
    int[] faceVertexCounts = [3]
    int[] faceVertexIndices = [0, 1, 2]
    point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
}
