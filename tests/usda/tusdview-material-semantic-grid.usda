#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World" {
    def Mesh "Preview" {
        point3f[] points = [(-3, -1, 0), (-1, -1, 0), (-1, 1, 0), (-3, 1, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        texCoord2f[] primvars:st = [(0, 0), (16, 0), (16, 16), (0, 16)] (
            interpolation = "vertex"
        )
        uniform bool doubleSided = true
        rel material:binding = </World/PreviewMaterial>
    }

    def Mesh "OpenPBR" {
        point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        texCoord2f[] primvars:st = [(0, 0), (16, 0), (16, 16), (0, 16)] (
            interpolation = "vertex"
        )
        uniform bool doubleSided = true
        rel material:binding = </World/OpenPBRMaterial>
    }

    def Mesh "StandardSurface" {
        point3f[] points = [(1, -1, 0), (3, -1, 0), (3, 1, 0), (1, 1, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        texCoord2f[] primvars:st = [(0, 0), (16, 0), (16, 16), (0, 16)] (
            interpolation = "vertex"
        )
        uniform bool doubleSided = true
        rel material:binding = </World/StandardMaterial>
    }

    def Material "PreviewMaterial" {
        token outputs:surface.connect = </World/PreviewMaterial/Surface.outputs:surface>
        def Shader "Surface" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </World/PreviewMaterial/Image.outputs:rgb>
            float inputs:metallic.connect = </World/PreviewMaterial/Image.outputs:r>
            float inputs:roughness.connect = </World/PreviewMaterial/Image.outputs:g>
            token outputs:surface
        }
        def Shader "Image" {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @../../models/textures/parity-quadrants.png@
            float2 inputs:st.connect = </World/PreviewMaterial/St.outputs:result>
            token inputs:sourceColorSpace = "sRGB"
            color3f outputs:rgb
            float outputs:r
            float outputs:g
        }
        def Shader "St" {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }
    }

    def Material "OpenPBRMaterial" {
        token outputs:surface.connect = </World/OpenPBRMaterial/Surface.outputs:surface>
        def Shader "Surface" {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color.connect = </World/OpenPBRMaterial/Image.outputs:out>
            float inputs:base_metalness = 0.45
            float inputs:specular_roughness = 0.3
            token outputs:surface
        }
        def Shader "Image" {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @../../models/textures/parity-quadrants.png@
            color3f outputs:out
        }
    }

    def Material "StandardMaterial" {
        token outputs:surface.connect = </World/StandardMaterial/Surface.outputs:surface>
        def Shader "Surface" {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </World/StandardMaterial/Image.outputs:out>
            float inputs:metalness = 0.8
            float inputs:specular_roughness = 0.65
            token outputs:surface
        }
        def Shader "Image" {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @../../models/textures/parity-quadrants.png@
            color3f outputs:out
        }
    }

    def DistantLight "Key" {
        float inputs:intensity = 4
        float3 xformOp:rotateXYZ = (0, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
}
