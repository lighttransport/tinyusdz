#usda 1.0
(
    doc = "BasisCurves test with catmullRom basis"
    metersPerUnit = 1
    upAxis = "Y"
)

def BasisCurves "CatmullRomCurve"
{
    uniform token basis = "catmullRom"
    uniform token type = "cubic"
    uniform token wrap = "nonperiodic"
    int[] curveVertexCounts = [6]
    point3f[] points = [
        (0, 0, 0), (1, 1, 0), (2, 0.5, 0),
        (3, 1.5, 0), (4, 1, 0), (5, 0, 0)
    ]
    float[] widths = [0.1, 0.12, 0.15, 0.15, 0.12, 0.1] (
        interpolation = "vertex"
    )
    color3f[] primvars:displayColor = [(0, 1, 0)] (
        interpolation = "constant"
    )
}
