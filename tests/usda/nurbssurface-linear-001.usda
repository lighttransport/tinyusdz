#usda 1.0
(
    defaultPrim = "Scene"
    upAxis = "Y"
)

def Xform "Scene"
{
    def NurbsSurface "LinearNurbsSurface"
    (
        doc = "A linear (degree 1) NURBS surface - essentially a mesh"
    )
    {
        uniform int uVertexCount = 3
        uniform int vVertexCount = 3
        uniform int order[2] = [2, 2]  # Linear = degree 1 = order 2

        point3f[] points = [
            (-1, -1, 0), (0, -1, 0.1), (1, -1, 0),
            (-1, 0, 0.1), (0, 0, 0.3), (1, 0, 0.1),
            (-1, 1, 0), (0, 1, 0.1), (1, 1, 0)
        ]

        # Linear knots: just clamped at ends
        double[] knots = [
            0, 0, 1, 1,
            0, 0, 1, 1
        ]

        double2 uRange = (0, 1)
        double2 vRange = (0, 1)
    }
}
