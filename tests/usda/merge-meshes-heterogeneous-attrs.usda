#usda 1.0
(
    doc = """Regression fixture for the mesh-merge heterogeneous-attribute bug.

    Two meshes bind the SAME material (so they fall into the same merge group)
    and have bakeable (identity) transforms, but differ in which vertex
    attributes they carry: 'MeshWithUV' has a 'primvars:st' texcoord set,
    'MeshNoUV' does not. (Texcoords are used rather than normals because the
    converter does not fabricate texcoords when they are absent, so the
    attribute-presence difference survives conversion.)

    Before the fix, RenderSceneConverter::MergeMeshData treated empty-vs-present
    attributes as compatible and merged them, producing a merged mesh whose UV
    set covered only part of the vertices (corrupt geometry). After the fix the
    heterogeneous merge is refused and both meshes survive unmerged.

    Exercised end-to-end (LoadUSDAFromMemory + ConvertToRenderScene with
    scene_config.merge_meshes = true) by tydra_mesh_fallback_policy_test in
    tests/unit/unit-tydra.cc.
    """
)

def Xform "Root"
{
    def Material "Mat"
    {
        token outputs:surface.connect = </Root/Mat/Preview.outputs:surface>

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
            token outputs:surface
        }
    }

    def Mesh "MeshWithUV"
    {
        rel material:binding = </Root/Mat>
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (0, 1)] (
            interpolation = "vertex"
        )
    }

    def Mesh "MeshNoUV"
    {
        rel material:binding = </Root/Mat>
        point3f[] points = [(2, 0, 0), (3, 0, 0), (2, 1, 0)]
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
    }
}
