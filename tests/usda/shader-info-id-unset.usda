#usda 1.0
(
    defaultPrim = "Looks"
    upAxis = "Y"
)

# Regression test: Shader with `info:id` declared but unset (issue #275).
# Omniverse Kit emits this for MDL shaders — the real identity comes
# from `info:implementationSource` + `info:mdl:sourceAsset`. In
# non-strict mode (default) the parser produces a generic ShaderNode
# with a warning; in strict mode (PrimReconstructOptions::
# strict_shader_check=true) it would still error.

def Scope "Looks"
{
    def Material "material_rgba"
    {
        token outputs:mdl:surface.connect = </Looks/material_rgba/Shader.outputs:out>

        def Shader "Shader"
        {
            uniform token info:id
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
            color3f inputs:diffuse_color_constant = (0.5, 0.5, 0.5)
            token outputs:out
        }
    }
}
