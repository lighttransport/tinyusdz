#usda 1.0
(
    defaultPrim = "Root"
    upAxis = "Y"
    metersPerUnit = 0.01
    timeCodesPerSecond = 24
    startTimeCode = 0
    endTimeCode = 100
    framesPerSecond = 24
    documentation = "Test layer metadata"
    customLayerData = {
        string creator = "TinyUSDZ spec test"
    }
)

class "BaseClass" {
    double size = 1.0
}

def Xform "Root" {
    def Mesh "Child" {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    }
}

over "Root" {
    double visibility = 1.0
}
