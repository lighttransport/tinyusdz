#usda 1.0
(
    defaultPrim = "world"
    doc = "Example: a textured plane whose base color is a private tinyexr uni KTX2 with a full mip chain. Load with tusdview --texture-keep-compressed on to upload/transcode the blocks directly (no decode + re-encode); see doc/texcomp.md. The private carrier is decoded by lightusd/textools and is not Basis UASTC."
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "world"
{
    def Mesh "plane" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </world/Mat>
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
    }

    def Material "Mat"
    {
        token outputs:surface.connect = </world/Mat/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </world/Mat/Tex.outputs:rgb>
            float inputs:roughness = 0.6
            token outputs:surface
        }

        def Shader "Tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @ktx2-uni-plane.ktx2@
            float2 inputs:st.connect = </world/Mat/UV.outputs:result>
            float3 outputs:rgb
        }

        def Shader "UV"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }
    }
}
