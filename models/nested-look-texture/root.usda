#usda 1.0
(
    doc = """Layer-relative asset-path anchoring regression fixture (root layer).

The look layer lives in `look/` and reaches the texture with `../tex/...`, which
is correct RELATIVE TO ITSELF -- this is how production scenes (ALab) author
textures in look layers nested below the stage root.

A renderer that anchors every relative asset path to the STAGE ROOT resolves
`../tex/checkerboard.png` against this file's directory, climbs out of the asset
entirely, finds nothing, and silently drops the texture. The quad must render the
CHECKERBOARD. See src/next/layer/asset-anchor.hh.
"""
    defaultPrim = "root"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "root" (
    prepend references = @look/look.usda@
)
{
    def Mesh "quad" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </root/MATERIAL/preview>
        float3[] extent = [(-1, -1, 0), (1, 1, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "faceVarying"
        )
    }
}
