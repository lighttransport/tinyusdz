#usda 1.0
(
    doc = "Hand-written test: ND_min_float node for specular_roughness"
    metersPerUnit = 1
    upAxis = "Z"
    defaultPrim = "root"
)

def Xform "root"
{
    def Sphere "MinTest"
    (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1.0
        rel material:binding = </root/_materials/MinTest>
    }

    def Scope "_materials"
    {
        def Material "MinTest"
        (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            token outputs:surface.connect = </root/_materials/MinTest/shader.outputs:surface>
            string config:mtlx:version = "1.39"
            token outputs:mtlx:surface.connect = </root/_materials/MinTest/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                float inputs:base_weight = 1
                color3f inputs:base_color = (0.1, 0.8, 0.4)
                float inputs:base_metalness = 0.3
                float inputs:base_diffuse_roughness = 0
                float inputs:specular_weight = 1
                color3f inputs:specular_color = (1, 1, 1)
                float inputs:specular_roughness.connect = </root/_materials/MinTest/NodeGraphs.outputs:min_roughness_out>
                float inputs:specular_ior = 1.5
                float inputs:coat_weight = 0
                float inputs:emission_luminance = 0
                color3f inputs:emission_color = (1, 1, 1)
                token outputs:surface
            }

            def NodeGraph "NodeGraphs"
            {
                float outputs:min_roughness_out.connect = </root/_materials/MinTest/NodeGraphs/min_roughness.outputs:out>

                def Shader "min_roughness"
                {
                    uniform token info:id = "ND_min_float"
                    float inputs:in1 = 0.9
                    float inputs:in2 = 0.3
                    float outputs:out
                }
            }
        }
    }
}
