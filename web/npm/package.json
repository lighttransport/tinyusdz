{
  "name": "tinyusdz",
  "private": true,
  "version": "0.9.9-rc1",
  "description": "TinyUSDZ WebAssembly and JavaScript loaders for USD and USDZ assets",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./*.js": "./*.js",
    "./*.wasm": "./*.wasm",
    "./*.wasm.zst": "./*.wasm.zst"
  },
  "files": [
    "*.js",
    "*.wasm",
    "*.wasm.zst",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "./00-build-package.sh",
    "build:package": "./00-build-package.sh",
    "build:wasm": "./05-build-wasm.sh",
    "build:stage": "node ./scripts/06-stage-package.mjs",
    "build:clean": "./00-build-package.sh",
    "validate": "node ./scripts/07-validate-package.mjs",
    "pack:dry-run": "node ./scripts/07-validate-package.mjs --pack-only",
    "test:validate": "npm run validate",
    "test:usda": "node --test ./scripts/test-usda-loading.mjs",
    "test": "npm run test:validate && npm run test:usda"
  },
  "keywords": [
    "usd",
    "usdz"
  ],
  "author": "Light Transport Entertainment Inc. and many contributors",
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lighttransport/tinyusdz.git",
    "directory": "web/npm"
  },
  "homepage": "https://github.com/lighttransport/tinyusdz/tree/release/web",
  "bugs": {
    "url": "https://github.com/lighttransport/tinyusdz/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/lighttransport"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "three": ">=0.177.0"
  }
}
