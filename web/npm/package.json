{
  "name": "tinyusdz",
  "version": "0.9.9",
  "description": "Tinyusdz wasm",
  "main": "tinyusdz.js",
  "files": [
    "AnimClipUtils.js",
    "EXRDecoder.js",
    "ExtendedSkinning.js",
    "JointHierarchyUtils.js",
    "LoaderConfigUtils.js",
    "SceneGraphUtils.js",
    "SceneHelpers.js",
    "SkinnedMeshUtils.js",
    "TinyUSDZComposer.js",
    "TinyUSDZLoader.js",
    "TinyUSDZLoaderUtils.js",
    "TinyUSDZMCPClient.js",
    "TinyUSDZMaterialX.js",
    "TinyUSDZOpenPBRSimple.js",
    "TinyUSDZOpenPBR_TSL.js",
    "TinyUSDZOpenPBR_WebGL.js",
    "TinyUSDZWorker.js",
    "TinyUSDZWorkerLoader.js",
    "TypedArrayOwnership.js",
    "USDAnimationConverter.js",
    "USDSceneAnimationPipeline.js",
    "USDSceneMetadata.js",
    "USDSceneSkinningData.js",
    "USDSceneSkinningPipeline.js",
    "USDSkeletalHelper.js",
    "USDSkeletonData.js",
    "tinyusdz.js",
    "tinyusdz.wasm",
    "tinyusdz.wasm.zst",
    "tinyusdz_64.js",
    "tinyusdz_64.wasm",
    "tinyusdz_64.wasm.zst",
    "LICENSE"
  ],
  "scripts": {
    "copy:lic": "node -e \"fs.mkdirSync('dist',{recursive:true});fs.cpSync('../../LICENSE','dist/LICENSE')\"",
    "copy:js": "node -e \"const s='../js/src/tinyusdz/';fs.readdirSync(s).filter(f=>f.endsWith('.js')).forEach(f=>fs.cpSync(s+f,'dist/'+f))\"",
    "copy:wasm": "node -e \"const s='../js/src/tinyusdz/';fs.readdirSync(s).filter(f=>f.endsWith('.wasm')).forEach(f=>fs.cpSync(s+f,'dist/'+f))\"",
    "copy:pkg": "node -e \"fs.cpSync('package.json','dist/package.json')\"",
    "copy:md": "node -e \"fs.cpSync('readme.md','dist/readme.md')\"",
    "copy:all": "npm run copy:lic && npm run copy:wasm && npm run copy:js && npm run copy:pkg && npm run copy:md",
    "comp:wasm": "zstd -19 -f ./dist/tinyusdz.wasm && zstd -19 -f ./dist/tinyusdz_64.wasm",
    "build": "npm run copy:all && npm run comp:wasm",
    "build:clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "usd",
    "usdz"
  ],
  "author": "Light Transport Entertainment Inc. and many contributors",
  "license": "Apache 2.0 and MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/lighttransport"
  },
  "dependencies": {
    "three": ">=0.177.0"
  }
}
