# sdist contents for the tinyusdz PyPI package.
# Everything needed to run `python -m build --wheel` from a fresh checkout.

include CMakeLists.txt
include LICENSE
include README.md
include pyproject.toml
include setup.py

# CMake helpers used by the build.
recursive-include cmake *.cmake *.toolchain *.txt

# Core tinyusdz C++ sources and all headers.
recursive-include src *.cc *.c *.cpp *.h *.hh *.hpp *.inc
recursive-include src/external *.cc *.c *.cpp *.h *.hh *.hpp *.inc *.def *.license

# Python package + tests.
recursive-include python *.py *.pyi py.typed README.md
recursive-include python/tests *

# Strip heavy/build artefacts.
global-exclude *.pyc *.pyo __pycache__
prune build
prune build_py_ext
prune dist
prune .git
prune .github
prune doc
prune examples
prune tests
prune sandbox
prune web
