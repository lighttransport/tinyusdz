#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
    defaultPrim = "root"
)
def Xform "root"
{
    def Mesh "mesh"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]

        def GeomSubset "unrestricted_bind"
        {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            uniform token familyType = "unrestricted"
            int[] indices = [0]
        }
        def GeomSubset "bound_wrong_family" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token elementType = "face"
            uniform token familyName = "notMaterialBind"
            int[] indices = [0]
            rel material:binding = </root/mat>
        }
    }
    def Material "mat"
    {
        def GeomSubset "orphan"
        {
            uniform token elementType = "face"
            int[] indices = [0]
        }
    }
}
